<Window x:Class="TavernDesk.App.CampaignMemorySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource CampaignMemorySettings.Title}"
        Width="700"
        Height="760"
        MinWidth="620"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22"
          Style="{StaticResource InterfaceScaleRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{StaticResource CampaignMemorySettings.Title}"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Margin="0,4,0,0"
                       Text="{StaticResource CampaignMemorySettings.Description}"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,14"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="16" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{StaticResource CampaignMemorySettings.ContextSection}"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Margin="0,5,0,14"
                                   Text="{StaticResource CampaignMemorySettings.ContextDescription}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{StaticResource CampaignMemorySettings.InputBudget}" />
                                <TextBox Margin="0,5,0,0"
                                         Text="{Binding CampaignContextTokenBudgetText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{StaticResource CampaignMemorySettings.InputBudgetHelp}"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{StaticResource CampaignMemorySettings.PlayerHistoryBudget}" />
                                <TextBox Margin="0,5,0,0"
                                         Text="{Binding CampaignPlayerHistoryBudgetText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{StaticResource CampaignMemorySettings.PlayerHistoryBudgetHelp}"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="{StaticResource CampaignMemorySettings.GmHistoryBudget}" />
                            <TextBox Margin="0,5,0,0"
                                     Text="{Binding CampaignGmHistoryBudgetText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{StaticResource CampaignMemorySettings.GmHistoryBudgetHelp}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0"
                        Padding="16"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{StaticResource CampaignMemorySettings.MemorySection}"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding CampaignMemoryToggleText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,18,0"
                                           Text="{StaticResource CampaignMemorySettings.MemoryDisabledHelp}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsCampaignMemoryEnabled, Mode=OneWay}"
                                          IsEnabled="{Binding CanToggleCampaignMemory}"
                                          Command="{Binding ToggleCampaignMemoryCommand}"
                                          Style="{StaticResource ReasoningToggleStyle}" />
                        </Grid>

                        <Border Margin="0,14,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="{StaticResource CampaignMemorySettings.CurrentStatus}" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding CampaignMemoryStatusText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextWrapping="Wrap" />
                                <Button Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Content="{Binding CampaignMemoryActionText}"
                                        Command="{Binding RetryCampaignMemoryCommand}"
                                        IsEnabled="{Binding CanRetryCampaignMemory}"
                                        Visibility="{Binding ShowCampaignMemoryAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTip="{StaticResource CampaignMemorySettings.ActionToolTip}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{StaticResource CampaignMemorySettings.UpdateInterval}" />
                                <TextBox Margin="0,5,0,0"
                                         Text="{Binding CampaignMemoryUpdateIntervalRoundsText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{StaticResource CampaignMemorySettings.UpdateIntervalHelp}"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{StaticResource CampaignMemorySettings.PendingThreshold}" />
                                <TextBox Margin="0,5,0,0"
                                         Text="{Binding CampaignMemoryPendingTokenThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{StaticResource CampaignMemorySettings.PendingThresholdHelp}"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,14,0,0"
                                   Text="{StaticResource CampaignMemorySettings.MemoryBoundaryHelp}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <TextBlock MaxWidth="410"
                       VerticalAlignment="Center"
                       Text="{Binding CampaignMemorySettingsStatusText}"
                       Foreground="{DynamicResource AccentBrush}"
                       TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="92"
                        Margin="0,0,10,0"
                        Content="{StaticResource Common.Close}"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Width="128"
                        Content="{StaticResource CampaignMemorySettings.Save}"
                        IsDefault="True"
                        Command="{Binding SaveCampaignMemorySettingsCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
