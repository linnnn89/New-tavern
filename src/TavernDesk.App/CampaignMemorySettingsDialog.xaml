<Window x:Class="TavernDesk.App.CampaignMemorySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="跑团记忆与上下文设置"
        Width="700"
        Height="760"
        MinWidth="620"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="跑团记忆与上下文设置"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Margin="0,4,0,0"
                       Text="这些设置只作用于当前跑团，不影响普通聊天的记忆。"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,14"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="16" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="普通跑团上下文"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Margin="0,5,0,14"
                                   Text="控制 GM 和 AI 玩家每次请求可使用的输入范围；输出上限单独设置。模型自身上下文不足时，输入预算会相应收紧。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="单次输入预算" />
                                <TextBox Margin="0,5,0,0"
                                         Text="{Binding CampaignContextTokenBudgetText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="8,000–200,000 tokens；只限制输入，输出上限在 GM 或席位模型设置中单独配置。"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="AI 玩家历史预算" />
                                <TextBox Margin="0,5,0,0"
                                         Text="{Binding CampaignPlayerHistoryBudgetText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="512–200,000 tokens；仅限制可回看的原始事件历史。"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="GM 历史预算" />
                            <TextBox Margin="0,5,0,0"
                                     Text="{Binding CampaignGmHistoryBudgetText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="512–200,000 tokens；本轮玩家行动仍按高优先级进入 GM 上下文。"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0"
                        Padding="16"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="升级版跑团记忆"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding CampaignMemoryToggleText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,18,0"
                                           Text="关闭后不调用跑团记忆总结，也不向 GM 或 AI 玩家请求注入升级版长期记忆；已有记忆和 checkpoint 会保留。"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsCampaignMemoryEnabled, Mode=OneWay}"
                                          IsEnabled="{Binding CanToggleCampaignMemory}"
                                          Command="{Binding ToggleCampaignMemoryCommand}"
                                          Style="{StaticResource ReasoningToggleStyle}" />
                        </Grid>

                        <Border Margin="0,14,0,0"
                                Padding="12"
                                Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="当前状态" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding CampaignMemoryStatusText}"
                                           Foreground="{StaticResource AccentBrush}"
                                           TextWrapping="Wrap" />
                                <Button Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Content="{Binding CampaignMemoryActionText}"
                                        Command="{Binding RetryCampaignMemoryCommand}"
                                        IsEnabled="{Binding CanRetryCampaignMemory}"
                                        Visibility="{Binding ShowCampaignMemoryAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTip="从已裁定历史建立跑团记忆，或重试未完成的记忆更新。"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="自动更新间隔" />
                                <TextBox Margin="0,5,0,0"
                                         Text="{Binding CampaignMemoryUpdateIntervalRoundsText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="1–50 个完整裁定轮次。"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="待处理事件阈值" />
                                <TextBox Margin="0,5,0,0"
                                         Text="{Binding CampaignMemoryPendingTokenThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="1,000–50,000 tokens；与轮次条件满足任一项即更新。"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,14,0,0"
                                   Text="长期记忆按 GM 全量与公共记忆分开维护；单次上下文最多纳入约 3,000 tokens 的长期记忆。只有已完成并锁定的 GM 裁定事实会进入自动更新边界。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <TextBlock MaxWidth="410"
                       VerticalAlignment="Center"
                       Text="{Binding CampaignMemorySettingsStatusText}"
                       Foreground="{StaticResource AccentBrush}"
                       TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="92"
                        Margin="0,0,10,0"
                        Content="关闭"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Width="128"
                        Content="保存设置"
                        IsDefault="True"
                        Command="{Binding SaveCampaignMemorySettingsCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
