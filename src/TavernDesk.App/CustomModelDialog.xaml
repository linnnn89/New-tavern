<Window x:Class="TavernDesk.App.CustomModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource CustomModel.Title}"
        Width="500"
        Height="220"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22"
          Style="{StaticResource InterfaceScaleRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBox x:Name="ModelNameEditor"
                 Grid.Row="1"
                 Margin="0,16,0,0"
                 Padding="10,8"
                 ToolTip="{StaticResource CustomModel.ExampleToolTip}" />

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Margin="0,0,10,0"
                    Content="{StaticResource Common.Cancel}"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Width="120"
                    Content="{StaticResource CustomModel.Save}"
                    IsDefault="True"
                    Click="SaveButton_OnClick"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
