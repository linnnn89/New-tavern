    <sys:String x:Key="CampaignMemorySettings.Title">Campaign memory and context settings</sys:String>
    <sys:String x:Key="CampaignMemorySettings.Description">These settings apply only to the current campaign and do not affect regular chat memory.</sys:String>
    <sys:String x:Key="CampaignMemorySettings.ContextSection">Standard campaign context</sys:String>
    <sys:String x:Key="CampaignMemorySettings.ContextDescription">Controls the input available to each GM and AI player request. Output limits are configured separately. If the model context is smaller, the input budget is reduced accordingly.</sys:String>
    <sys:String x:Key="CampaignMemorySettings.InputBudget">Input budget per request</sys:String>
    <sys:String x:Key="CampaignMemorySettings.InputBudgetHelp">8,000–200,000 tokens. This limits input only; configure the output limit separately for the GM or seat model.</sys:String>
    <sys:String x:Key="CampaignMemorySettings.PlayerHistoryBudget">AI player history budget</sys:String>
    <sys:String x:Key="CampaignMemorySettings.PlayerHistoryBudgetHelp">512–200,000 tokens. Limits only the raw event history that can be reviewed.</sys:String>
    <sys:String x:Key="CampaignMemorySettings.GmHistoryBudget">GM history budget</sys:String>
    <sys:String x:Key="CampaignMemorySettings.GmHistoryBudgetHelp">512–200,000 tokens. Current-round player actions still enter GM context at high priority.</sys:String>
    <sys:String x:Key="CampaignMemorySettings.MemorySection">Enhanced campaign memory</sys:String>
    <sys:String x:Key="CampaignMemorySettings.MemoryDisabledHelp">When off, TavernDesk neither summarizes campaign memory nor injects enhanced long-term memory into GM or AI player requests. Existing memory and checkpoints are retained.</sys:String>
    <sys:String x:Key="CampaignMemorySettings.CurrentStatus">Current status</sys:String>
    <sys:String x:Key="CampaignMemorySettings.ActionToolTip">Build campaign memory from adjudicated history, or retry an incomplete memory update.</sys:String>
    <sys:String x:Key="CampaignMemorySettings.UpdateInterval">Automatic update interval</sys:String>
    <sys:String x:Key="CampaignMemorySettings.UpdateIntervalHelp">1–50 fully adjudicated rounds.</sys:String>
    <sys:String x:Key="CampaignMemorySettings.PendingThreshold">Pending-event threshold</sys:String>
    <sys:String x:Key="CampaignMemorySettings.PendingThresholdHelp">1,000–50,000 tokens. An update runs when either the round or token condition is met.</sys:String>
    <sys:String x:Key="CampaignMemorySettings.MemoryBoundaryHelp">Long-term memory is maintained separately as full GM memory and public memory. Each context includes at most about 3,000 tokens of long-term memory. Only completed, locked GM rulings cross the automatic-update boundary.</sys:String>
    <sys:String x:Key="CampaignMemorySettings.Save">Save settings</sys:String>
