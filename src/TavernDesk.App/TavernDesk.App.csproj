<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TavernDesk.Core\TavernDesk.Core.csproj" />
    <ProjectReference Include="..\TavernDesk.Infrastructure\TavernDesk.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Icons\TavernDesk.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\*.png" />
    <Resource Include="Assets\Icons\TavernDesk.ico" />
  </ItemGroup>

  <Target Name="CopyLocalizationSourcesToOutput" AfterTargets="Build">
    <ItemGroup>
      <LocalizationSource Include="$(MSBuildProjectDirectory)\Localization\Strings.*.xaml" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)Localization" />
    <Copy SourceFiles="@(LocalizationSource)"
          DestinationFolder="$(TargetDir)Localization"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyLocalizationSourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <LocalizationPublishSource Include="$(MSBuildProjectDirectory)\Localization\Strings.*.xaml" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)Localization" />
    <Copy SourceFiles="@(LocalizationPublishSource)"
          DestinationFolder="$(PublishDir)Localization"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
