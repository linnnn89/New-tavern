<Window x:Class="TavernDesk.App.ConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TavernDesk.App.Views"
        Title="{Binding SelectedConversation.Title, TargetNullValue={StaticResource ConversationWindow.DefaultTitle}}"
        MinWidth="960"
        MinHeight="620"
        ResizeMode="CanResize"
        Background="{DynamicResource AppicaShellCanvasBrush}">
    <Grid Style="{StaticResource InterfaceScaleRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource AppicaShellTopBarStyle}">
            <Grid>
                <TextBlock Text="{Binding SelectedConversation.Title, TargetNullValue={StaticResource ConversationWindow.DefaultTitle}}"
                           Style="{StaticResource AppicaShellSectionTitleStyle}" />
                <views:ShellCaptionButtons HorizontalAlignment="Right" />
            </Grid>
        </Border>
        <views:ChatView Grid.Row="1" />
    </Grid>
</Window>
