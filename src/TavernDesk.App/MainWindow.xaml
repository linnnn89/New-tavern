<Window x:Class="TavernDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TavernDesk"
        Icon="/TavernDesk.App;component/Assets/Icons/TavernDesk.ico"
        Width="1440"
        Height="900"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="82" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="54" Height="54" CornerRadius="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="Transparent">
                    <Image Source="/TavernDesk.App;component/Assets/Icons/brand-mark.png"
                           Width="54"
                           Height="54"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True" />
                </Border>

                <StackPanel Grid.Row="1">
                    <Button Command="{Binding ShowDashboardCommand}"
                        ToolTip="打开本地数据与应用状态概览。"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel>
                            <Image Source="/TavernDesk.App;component/Assets/Icons/dashboard.png"
                                   Width="28" Height="28" Stretch="Uniform" />
                            <TextBlock Text="仪表盘" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowChatCommand}"
                        ToolTip="打开一对一角色聊天。"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel>
                            <Image Source="/TavernDesk.App;component/Assets/Icons/chat.png"
                                   Width="28" Height="28" Stretch="Uniform" />
                            <TextBlock Text="聊天" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowCampaignsCommand}"
                        ToolTip="打开剧本库、起始大厅和多人跑团。"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel>
                            <Image Source="/TavernDesk.App;component/Assets/Icons/campaign.png"
                                   Width="28" Height="28" Stretch="Uniform" />
                            <TextBlock Text="跑团" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowCharactersCommand}"
                        ToolTip="管理本地角色卡与角色资料。"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel>
                            <Image Source="/TavernDesk.App;component/Assets/Icons/characters.png"
                                   Width="28" Height="28" Stretch="Uniform" />
                            <TextBlock Text="角色" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowWorldbooksCommand}"
                        ToolTip="导入、管理并测试酒馆世界书；关键词和语义召回分开运行。"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel>
                            <Image Source="/TavernDesk.App;component/Assets/Icons/worldbook.png"
                                   Width="28" Height="28" Stretch="Uniform" />
                            <TextBlock Text="世界书" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button IsEnabled="False"
                            ToolTip="工具页功能尚未开放。"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel>
                            <Image Source="/TavernDesk.App;component/Assets/Icons/tools.png"
                                   Width="28" Height="28" Stretch="Uniform" />
                            <TextBlock Text="工具" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Row="2"
                        Margin="10,4,10,14"
                        Command="{Binding ShowSettingsCommand}"
                        ToolTip="配置模型供应商、API Key、默认模型与全局提示词。"
                        Style="{StaticResource NavButtonStyle}">
                    <StackPanel>
                        <Image Source="/TavernDesk.App;component/Assets/Icons/settings.png"
                               Width="28" Height="28" Stretch="Uniform" />
                        <TextBlock Text="设置" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="26,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{Binding CurrentSection}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="停止全部 API"
                                Margin="0,0,14,0"
                                Padding="12,5"
                                Command="{Binding StopAllGenerationCommand}"
                                Foreground="{StaticResource DangerBrush}"
                                ToolTip="立即取消当前应用内所有正在进行的模型请求；不会删除已保存记录。"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" />
                        <TextBlock Margin="7,0,0,0"
                                   Text="{Binding RuntimeStatusText}"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
