<Window x:Class="TavernDesk.App.RegenerationRequirementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource Regenerate.Title}"
        Width="520"
        Height="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22"
          Style="{StaticResource InterfaceScaleRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{StaticResource Regenerate.Question}"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,12"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Text="{StaticResource Regenerate.Description}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBox x:Name="RequirementEditor"
                 Grid.Row="1"
                 Padding="10,8"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 ToolTip="{StaticResource Regenerate.RequirementToolTip}" />

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="112"
                    Margin="0,0,10,0"
                    Content="{StaticResource Common.Cancel}"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Width="132"
                    Content="{StaticResource Regenerate.Start}"
                    IsDefault="True"
                    Click="StartButton_OnClick"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
