<Window x:Class="TavernDesk.App.RegenerationRequirementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重新生成 · 附加要求"
        Width="520"
        Height="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22"
          Style="{StaticResource InterfaceScaleRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="是否为本次重新生成追加要求？"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,12"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="可留空。填写后会以“附加要求：……”放在本次请求末尾，不写入聊天记录。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBox x:Name="RequirementEditor"
                 Grid.Row="1"
                 Padding="10,8"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 ToolTip="例如：让冲突更明显；保持原剧情但改成更克制的语气" />

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="112"
                    Margin="0,0,10,0"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Width="132"
                    Content="开始重新生成"
                    IsDefault="True"
                    Click="StartButton_OnClick"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
