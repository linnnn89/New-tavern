<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:presentation="clr-namespace:TavernDesk.App.Presentation">
    <presentation:ReferenceEqualsMultiConverter x:Key="ReferenceEqualsMultiConverter" />
    <system:Boolean x:Key="AppicaBooleanTrue">True</system:Boolean>

    <!-- The shell is deliberately isolated from secondary windows and dialogs. -->
    <FontFamily x:Key="AppicaShellIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="AppicaShellCanvasBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="AppicaShellSurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppicaShellDividerBrush" Color="#E5E9F0" />
    <SolidColorBrush x:Key="AppicaShellTextBrush" Color="#171B24" />
    <SolidColorBrush x:Key="AppicaShellMutedBrush" Color="#697386" />
    <SolidColorBrush x:Key="AppicaShellSubtleBrush" Color="#8A94A6" />
    <SolidColorBrush x:Key="AppicaShellAccentBrush" Color="#0F6BEE" />
    <SolidColorBrush x:Key="AppicaShellAccentHoverBrush" Color="#075FDC" />
    <SolidColorBrush x:Key="AppicaShellAccentSoftBrush" Color="#E8F1FF" />
    <SolidColorBrush x:Key="AppicaShellAccentBorderBrush" Color="#CFE0FF" />
    <SolidColorBrush x:Key="AppicaShellHoverBrush" Color="#F3F6FA" />
    <SolidColorBrush x:Key="AppicaShellPressedBrush" Color="#E9EEF5" />
    <SolidColorBrush x:Key="AppicaShellStatusSurfaceBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="AppicaShellSuccessBrush" Color="#1BAA67" />
    <SolidColorBrush x:Key="AppicaShellDangerBrush" Color="#B42318" />
    <SolidColorBrush x:Key="AppicaShellDangerSurfaceBrush" Color="#FFF2F0" />
    <SolidColorBrush x:Key="AppicaShellDangerHoverBrush" Color="#FFE8E5" />
    <SolidColorBrush x:Key="AppicaShellDangerBorderBrush" Color="#F6C8C2" />
    <SolidColorBrush x:Key="AppicaShellFocusBrush" Color="#79A7FF" />

    <SolidColorBrush x:Key="AppicaDashboardHeroBrush" Color="#EDF4FF" />
    <SolidColorBrush x:Key="AppicaDashboardHeroBorderBrush" Color="#D8E6FF" />
    <SolidColorBrush x:Key="AppicaDashboardPurpleSoftBrush" Color="#F1ECFF" />
    <SolidColorBrush x:Key="AppicaDashboardPurpleBrush" Color="#7450D8" />
    <SolidColorBrush x:Key="AppicaDashboardGreenSoftBrush" Color="#E8F8F0" />
    <SolidColorBrush x:Key="AppicaDashboardGreenBrush" Color="#16845B" />

    <DropShadowEffect x:Key="AppicaShellSidebarShadowEffect"
                      BlurRadius="18"
                      Direction="0"
                      Opacity="0.07"
                      ShadowDepth="2"
                      Color="#42516B" />
    <DropShadowEffect x:Key="AppicaDashboardCardShadowEffect"
                      BlurRadius="20"
                      Direction="270"
                      Opacity="0.07"
                      ShadowDepth="3"
                      Color="#34435A" />

    <Style x:Key="AppicaShellSidebarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppicaShellSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppicaShellDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Effect" Value="{StaticResource AppicaShellSidebarShadowEffect}" />
    </Style>

    <Style x:Key="AppicaShellBrandTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="26,0,16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource AppicaShellTextBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="AppicaShellNavIconStyle" TargetType="TextBlock">
        <Setter Property="Width" Value="28" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource AppicaShellIconFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="AppicaShellNavButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="10,3" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource AppicaShellMutedBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="800" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
        <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" />
                        <Border x:Name="FocusRing"
                                Margin="1"
                                BorderBrush="{DynamicResource AppicaShellFocusBrush}"
                                BorderThickness="2"
                                CornerRadius="9"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppicaShellHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppicaShellTextBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource AppicaBooleanTrue}">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppicaShellAccentSoftBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppicaShellAccentBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppicaShellAccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppicaShellPressedBrush}" />
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppicaShellTopBarStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="20,0,8,0" />
        <Setter Property="Background" Value="{DynamicResource AppicaShellSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppicaShellDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="AppicaCaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AppicaShellMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppicaShellHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppicaShellTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppicaShellPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppicaCaptionCloseButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource AppicaCaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#9A2216" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppicaTokenCapsuleStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppicaShellAccentBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppicaMessageHoverBarStyle" TargetType="Border">
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSolidBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Effect" Value="{StaticResource AppicaDashboardCardShadowEffect}" />
    </Style>

    <Style x:Key="AppicaMessageHoverButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppicaEmptyStateStyle" TargetType="Border">
        <Setter Property="Padding" Value="28,36" />
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>

    <Style x:Key="AppicaShellSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource AppicaShellTextBrush}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppicaShellWorkspaceCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="12,12,12,16" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="{DynamicResource AppicaShellStatusSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppicaShellDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="AppicaShellRuntimeLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppicaShellSubtleBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppicaShellRuntimeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppicaShellMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppicaShellStopButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource AppicaShellDangerSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppicaShellDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppicaShellDangerBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="800" />
        <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="FocusRing"
                                Margin="-2"
                                BorderBrush="{DynamicResource AppicaShellFocusBrush}"
                                BorderThickness="2"
                                CornerRadius="11"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppicaShellDangerHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.74" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppicaShellSurfaceBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppicaShellDividerBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppicaShellSubtleBrush}" />
                            <Setter Property="Opacity" Value="0.68" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppicaDashboardHeroStyle" TargetType="Border">
        <Setter Property="Padding" Value="30,26" />
        <Setter Property="Background" Value="{DynamicResource AppicaDashboardHeroBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppicaDashboardHeroBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <Style x:Key="AppicaDashboardHeroEyebrowStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppicaShellAccentBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppicaDashboardHeroTitleStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,9,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource AppicaShellTextBrush}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppicaDashboardHeroSubtitleStyle" TargetType="TextBlock">
        <Setter Property="MaxWidth" Value="590" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource AppicaShellMutedBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppicaDashboardHeroFeatureStyle" TargetType="Border">
        <Setter Property="Width" Value="230" />
        <Setter Property="MinHeight" Value="132" />
        <Setter Property="Margin" Value="26,0,0,0" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource AppicaShellAccentBrush}" />
        <Setter Property="CornerRadius" Value="15" />
    </Style>

    <Style x:Key="AppicaDashboardStatCardStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="138" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{DynamicResource AppicaShellSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppicaShellDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Effect" Value="{StaticResource AppicaDashboardCardShadowEffect}" />
    </Style>

    <Style x:Key="AppicaDashboardStatButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="138" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource AppicaShellSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppicaShellDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource AppicaShellTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Effect" Value="{StaticResource AppicaDashboardCardShadowEffect}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="FocusRing"
                                Margin="3"
                                BorderBrush="{DynamicResource AppicaShellFocusBrush}"
                                BorderThickness="2"
                                CornerRadius="14"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppicaShellHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppicaShellPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppicaDashboardStatLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppicaShellMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppicaDashboardStatMetricStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppicaShellTextBrush}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="AppicaDashboardRecentPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppicaShellSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppicaShellDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Effect" Value="{StaticResource AppicaDashboardCardShadowEffect}" />
    </Style>

    <Style x:Key="AppicaDashboardRecentRowButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="76" />
        <Setter Property="Padding" Value="18,13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppicaShellDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource AppicaShellTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="FocusRing"
                                Margin="4"
                                BorderBrush="{DynamicResource AppicaShellFocusBrush}"
                                BorderThickness="2"
                                CornerRadius="10"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppicaShellHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppicaShellPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
