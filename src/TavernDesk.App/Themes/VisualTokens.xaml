    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextDisabled" Color="#727782" />
    <SolidColorBrush x:Key="ControlHover" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ControlPressed" Color="#E8EAEE" />
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#727782" />
    <SolidColorBrush x:Key="ListItemSelected" Color="#EEF1FC" />
    <SolidColorBrush x:Key="NavItemSelectedBackground" Color="#EEF1FC" />
    <SolidColorBrush x:Key="NavItemIndicatorBrush" Color="#3B5BDB" />
