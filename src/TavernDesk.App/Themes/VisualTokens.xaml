    <SolidColorBrush x:Key="SuccessBorder" Color="#22613E" />
    <SolidColorBrush x:Key="WarningFg" Color="#86520B" />
    <SolidColorBrush x:Key="WarningBg" Color="#FFF4DF" />
    <SolidColorBrush x:Key="WarningBorder" Color="#86520B" />
    <SolidColorBrush x:Key="DangerFg" Color="#A72B25" />
    <SolidColorBrush x:Key="DangerBg" Color="#FFF0EE" />
    <SolidColorBrush x:Key="DangerBorder" Color="#A72B25" />

    <Thickness x:Key="InsetSm">8</Thickness>
    <Thickness x:Key="InsetMd">16</Thickness>
    <Thickness x:Key="InsetLg">24</Thickness>
    <Thickness x:Key="PageInset">24,24,24,32</Thickness>
    <Thickness x:Key="SectionGap">0,0,0,24</Thickness>
    <Thickness x:Key="ContentGap">0,0,0,16</Thickness>
    <Thickness x:Key="LabelGap">0,4,0,0</Thickness>
    <Thickness x:Key="TileGap">4</Thickness>
    <Thickness x:Key="NavInset">16,8</Thickness>
    <Thickness x:Key="NavMargin">8,4</Thickness>
    <Thickness x:Key="IndicatorInset">4,0,0,0</Thickness>
    <Thickness x:Key="FocusInset">4</Thickness>
    <Thickness x:Key="FocusThickness">2</Thickness>
    <Thickness x:Key="NoInset">0</Thickness>
    <Thickness x:Key="FormLabelTopInset">0,24,0,0</Thickness>
    <system:Double x:Key="NavIndicatorWidth">3</system:Double>
    <system:Double x:Key="NavIndicatorHeight">16</system:Double>
    <CornerRadius x:Key="NavIndicatorRadius">2</CornerRadius>
    <system:Double x:Key="InspectorRailWidth">48</system:Double>
    <system:Double x:Key="StatTileMinHeight">80</system:Double>
    <system:Double x:Key="DashboardTitleSize">28</system:Double>
