    <SolidColorBrush x:Key="SurfaceSunken" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SurfaceBase" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceOverlay" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1B1E24" />
