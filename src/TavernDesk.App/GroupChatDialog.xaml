<Window x:Class="TavernDesk.App.GroupChatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource GroupChat.CreateTitle}"
        Width="640"
        Height="680"
        MinWidth="480"
        MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24"
          Style="{StaticResource InterfaceScaleRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{StaticResource GroupChat.CreateTitle}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Margin="0,5,0,0"
                       Text="{StaticResource GroupChat.CreateDescription}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,14">
            <TextBlock Text="{StaticResource GroupChat.NameLabel}" FontWeight="SemiBold" />
            <TextBox x:Name="TitleBox"
                     Margin="0,6,0,0"
                     Text="{StaticResource GroupChat.DefaultName}"
                     MaxLength="120" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8">
            <ListBox x:Name="CharacterList"
                     ItemsSource="{Binding Choices}"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Margin="8,6"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        Background="{DynamicResource AccentSoftBrush}">
                                    <Image Source="{Binding Character.AvatarPath}"
                                           Stretch="UniformToFill">
                                        <Image.Clip>
                                            <EllipseGeometry Center="20,20"
                                                             RadiusX="20"
                                                             RadiusY="20" />
                                        </Image.Clip>
                                    </Image>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Character.Name}"
                                               FontWeight="SemiBold"
                                               MaxWidth="420"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DescriptionPreview}"
                                               MaxWidth="420"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DescriptionPreview}"
                                                                 Value="">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource DangerBrush}" />
            <Button Grid.Column="1"
                    Width="92"
                    Margin="0,0,10,0"
                    Content="{StaticResource Common.Cancel}"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="2"
                    Width="112"
                    Content="{StaticResource GroupChat.CreateAction}"
                    Click="Create_OnClick"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
