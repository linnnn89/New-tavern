<Window x:Class="TavernDesk.App.GroupChatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource GroupChat.CreateTitle}"
        Width="640"
        Height="680"
        MinWidth="480"
        MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24"
          Style="{StaticResource InterfaceScaleRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{StaticResource GroupChat.CreateTitle}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Margin="0,5,0,0"
                       Text="{StaticResource GroupChat.CreateDescription}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,14">
            <TextBlock Text="{StaticResource GroupChat.NameLabel}" FontWeight="SemiBold" />
            <TextBox x:Name="TitleBox"
                     Margin="0,6,0,0"
                     Text="{StaticResource GroupChat.DefaultName}"
                     MaxLength="120" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8">
            <ListBox x:Name="CharacterList"
                     ItemsSource="{Binding Choices}"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="RowChrome"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter TargetName="RowChrome" Property="BorderBrush" Value="{DynamicResource AppicaSelectedBorderBrush}" />
                                        </DataTrigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="RowChrome" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Padding="10,8"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalContentAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Style="{StaticResource AvatarPlaceholderTextStyle}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppicaShellIconFont}"
                                                   FontSize="17"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="&#xE77B;" />
                                        <Image x:Name="AvatarImage"
                                               Source="{Binding Character.AvatarPath, Converter={StaticResource AvatarImageConverter}, ConverterParameter=48}"
                                               Stretch="UniformToFill">
                                            <Image.Clip>
                                                <EllipseGeometry Center="20,20"
                                                                 RadiusX="20"
                                                                 RadiusY="20" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Character.Name}"
                                               FontWeight="SemiBold"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DescriptionPreview}"
                                               Margin="0,2,0,0"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DescriptionPreview}"
                                                                 Value="">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource DangerBrush}" />
            <Button Grid.Column="1"
                    Width="92"
                    Margin="0,0,10,0"
                    Content="{StaticResource Common.Cancel}"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="2"
                    Width="112"
                    Content="{StaticResource GroupChat.CreateAction}"
                    Click="Create_OnClick"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
