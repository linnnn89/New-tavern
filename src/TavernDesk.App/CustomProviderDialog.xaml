<Window x:Class="TavernDesk.App.CustomProviderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource CustomProvider.Title}"
        Width="560"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24"
          Style="{StaticResource InterfaceScaleRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      Margin="0,0,0,16"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="{StaticResource CustomProvider.Title}"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Margin="0,8,0,0"
                        Padding="12"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="{StaticResource CustomProvider.ProtocolTitle}"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{StaticResource CustomProvider.ProtocolDescription}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,18,0,4"
                           Text="{StaticResource CustomProvider.NameLabel}" />
                <TextBox x:Name="NameEditor"
                         MinHeight="36"
                         Padding="10,6"
                         Text="{StaticResource CustomProvider.DefaultName}" />

                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="{StaticResource CustomProvider.BaseUrlLabel}" />
                    <TextBox x:Name="BaseUrlEditor"
                             Margin="0,4,0,0"
                             MinHeight="36"
                             Padding="10,6"
                             ToolTip="{StaticResource CustomProvider.BaseUrlToolTip}" />
                    <TextBlock Margin="0,5,0,0"
                               Text="{StaticResource CustomProvider.BaseUrlHelp}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Margin="0,0,10,0"
                    Content="{StaticResource Common.Cancel}"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Width="120"
                    Content="{StaticResource Common.Add}"
                    IsDefault="True"
                    Click="AddButton_OnClick"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
