<Window x:Class="TavernDesk.App.CustomProviderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加自定义 API 提供商"
        Width="560"
        Height="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24"
          Style="{StaticResource InterfaceScaleRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="添加自定义 API 提供商"
                   Style="{StaticResource SectionTitleStyle}" />
        <TextBlock Grid.Row="1"
                   Margin="0,5,0,0"
                   Text="默认使用 OpenAI Compatible 协议；添加后可在右侧继续保存 API Key。"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="2"
                   Margin="0,18,0,4"
                   Text="名称" />
        <TextBox x:Name="NameEditor"
                 Grid.Row="3"
                 MinHeight="36"
                 Padding="10,6"
                 Text="自定义 API 提供商" />

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="API / 本机地址" />
            <TextBox x:Name="BaseUrlEditor"
                     Margin="0,4,0,0"
                     MinHeight="36"
                     Padding="10,6"
                     ToolTip="填写到 /api/v1 或 /v1 结束，不要加入 /chat；例如 https://example.com/api/v1。" />
            <TextBlock Margin="0,5,0,0"
                       Text="填写到 api/v1 结束，不要加入 /chat。示例：https://example.com/api/v1"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="6"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Margin="0,0,10,0"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Width="120"
                    Content="添加"
                    IsDefault="True"
                    Click="AddButton_OnClick"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
