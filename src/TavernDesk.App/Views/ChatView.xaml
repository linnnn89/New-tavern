<UserControl x:Class="TavernDesk.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:TavernDesk.Core.Models;assembly=TavernDesk.Core">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="210" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition x:Name="RightPanelColumn" Width="300" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,2,0,12">
                    <Grid Margin="0,0,0,11">
                        <TextBlock Text="聊天" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Content="+ 群聊"
                                    Command="{Binding Group.CreateGroupCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <TextBox Text="{Binding ConversationSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按角色、会话标题或最近消息过滤" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ConversationGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button Command="{Binding ToggleCommand}"
                                            Padding="7,9"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36"
                                                    Height="36"
                                                    CornerRadius="18"
                                                    Background="{StaticResource AccentSoftBrush}">
                                                <Grid>
                                                    <TextBlock Text="人"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                    <Image Source="{Binding AvatarPath}"
                                                           Stretch="UniformToFill">
                                                        <Image.Clip>
                                                            <EllipseGeometry Center="18,18"
                                                                             RadiusX="18"
                                                                             RadiusY="18" />
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding LatestPreview}"
                                                           Margin="0,2,0,0"
                                                           FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UpdatedText}"
                                                           HorizontalAlignment="Right"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock x:Name="ExpandGlyph"
                                                           Margin="0,3,0,0"
                                                           Text="⌄"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Border ClipToBounds="True"
                                            MaxHeight="0"
                                            Opacity="0"
                                            Margin="38,0,0,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="MaxHeight" Value="0" />
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                                     To="1600"
                                                                                     Duration="0:0:0.22">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     To="1"
                                                                                     Duration="0:0:0.18" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                                     To="0"
                                                                                     Duration="0:0:0.18">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseIn" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     To="0"
                                                                                     Duration="0:0:0.14" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ItemsControl ItemsSource="{Binding VisibleConversations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,1"
                                                            Padding="10,8"
                                                            BorderThickness="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            Cursor="Hand">
                                                        <Button.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                <MenuItem Header="在新窗口聊天"
                                                                          Command="{Binding OpenInNewWindowCommand}" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding PreviewText}"
                                                                               FontSize="12"
                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                               TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding GenerationStatusText}"
                                                                               Margin="7,0,0,0"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource AccentBrush}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Margin="8,0,0,0"
                                                                       Text="{Binding UpdatedText}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource MutedTextBrush}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter TargetName="ExpandGlyph" Property="Text" Value="⌃" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="22,17"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding SelectedConversation.Title, TargetNullValue=请从左侧展开角色并选择一次对话}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Status}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Margin="0,0,7,0"
                                Content="导入 JSONL"
                                Command="{Binding ImportChatArchiveCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="导入 SillyTavern 聊天记录并创建独立会话" />
                        <Button Margin="0,0,7,0"
                                Content="导出当前"
                                Command="{Binding ExportChatArchiveCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="导出当前会话及全部候选回复" />
                        <ComboBox Width="116"
                                  ItemsSource="{Binding DisplayModes}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding DisplayMode}"
                                  ToolTip="切换气泡或连续小说式阅读布局" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ConversationScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,18">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="MessageContainer"
                                  Margin="0,0,24,18"
                                  MaxWidth="780"
                                  HorizontalAlignment="Left">
                                <Border x:Name="MessageBubble"
                                        Padding="16,13"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        PreviewMouseRightButtonUp="MessageBubble_OnPreviewMouseRightButtonUp">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding SenderLabel}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding DisplayContent}"
                                                   Margin="0,7,0,0"
                                                   FontSize="{DynamicResource ChatFontSize}" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="CandidateNavigator"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,18,-10"
                                        Padding="3,2"
                                        Panel.ZIndex="2"
                                        Visibility="Collapsed"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="‹"
                                                Command="{Binding PreviousCandidateCommand}"
                                                Style="{StaticResource CandidateNavigationButtonStyle}"
                                                ToolTip="查看上一个候选版本" />
                                        <TextBlock MinWidth="66"
                                                   Margin="4,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Text="{Binding CandidateNavigationLabel}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <Button Content="›"
                                                Command="{Binding NextCandidateCommand}"
                                                Style="{StaticResource CandidateNavigationButtonStyle}"
                                                ToolTip="查看下一个候选版本" />
                                    </StackPanel>
                                </Border>

                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,-16,-12"
                                        Style="{StaticResource MessagePlusButtonStyle}"
                                        ToolTip="展开消息工具"
                                        PreviewMouseLeftButtonDown="MessagePlus_OnPreviewMouseLeftButtonDown"
                                        Click="MessagePlus_OnClick"
                                        MouseLeave="MessagePlus_OnMouseLeave" />

                                <Popup IsOpen="{Binding IsToolbarOpen, Mode=TwoWay}"
                                       DataContext="{Binding}"
                                       PlacementTarget="{Binding ElementName=MessageBubble}"
                                       Placement="MousePoint"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Width="178"
                                            Padding="7"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#54000000"
                                                              BlurRadius="18"
                                                              ShadowDepth="5"
                                                              Opacity="0.42" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <Button Command="{Binding EditCommand}"
                                                    Style="{StaticResource MessageToolButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="28" Text="✎" FontSize="17" />
                                                    <TextBlock Text="编辑" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding CopyCommand}"
                                                    Style="{StaticResource MessageToolButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="28" Text="▣" FontSize="15" />
                                                    <TextBlock Text="复制" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ForkCommand}"
                                                    Style="{StaticResource MessageToolButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="28" Text="⑂" FontSize="17" />
                                                    <TextBlock Text="独立分支" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding RegenerateCommand}"
                                                    ToolTip="生成新候选，不截断后续消息"
                                                    Style="{StaticResource MessageToolButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="28" Text="↻" FontSize="17" />
                                                    <TextBlock Text="重新生成" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ContinueCommand}"
                                                    ToolTip="不新增 USER 消息，按当前聊天继续生成下一条角色回复"
                                                    Style="{StaticResource MessageToolButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="28" Text="▶" FontSize="15" />
                                                    <TextBlock Text="继续生成" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Border Height="1"
                                                    Margin="8,5"
                                                    Background="{StaticResource BorderBrush}" />
                                            <Button Command="{Binding DeleteCommand}"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Style="{StaticResource MessageToolButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="28" Text="⌫" FontSize="17"
                                                               Foreground="{StaticResource DangerBrush}" />
                                                    <TextBlock Text="删除"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource DangerBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding SenderKind}" Value="{x:Static models:MessageSenderKind.User}">
                                    <Setter TargetName="MessageContainer" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="MessageBubble" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasMultipleCandidates}" Value="True">
                                    <Setter TargetName="CandidateNavigator"
                                            Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.IsNovelMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="True">
                                    <Setter TargetName="MessageContainer"
                                            Property="HorizontalAlignment"
                                            Value="Stretch" />
                                    <Setter TargetName="MessageContainer"
                                            Property="MaxWidth"
                                            Value="1200" />
                                    <Setter TargetName="MessageBubble"
                                            Property="Background"
                                            Value="Transparent" />
                                    <Setter TargetName="MessageBubble"
                                            Property="BorderThickness"
                                            Value="0" />
                                    <Setter TargetName="MessageBubble"
                                            Property="Padding"
                                            Value="4,8,20,8" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- A provider reasoning stream is only a transient progress signal.
                 Staggered transforms form one quiet, continuous stadium-wave motion. -->
            <StackPanel Grid.Row="1"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        IsHitTestVisible="False"
                        Opacity="0.7"
                        Visibility="{Binding IsModelThinking, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="正" FontSize="12" Foreground="{StaticResource MutedTextBrush}">
                    <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="2" To="-3" Duration="0:0:0.34"
                                                     AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <TextBlock Text="在" FontSize="12" Foreground="{StaticResource MutedTextBrush}">
                    <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="2" To="-3" Duration="0:0:0.34"
                                                     BeginTime="0:0:0.09" AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <TextBlock Text="思" FontSize="12" Foreground="{StaticResource MutedTextBrush}">
                    <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="2" To="-3" Duration="0:0:0.34"
                                                     BeginTime="0:0:0.18" AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <TextBlock Text="考" FontSize="12" Foreground="{StaticResource MutedTextBrush}">
                    <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="2" To="-3" Duration="0:0:0.34"
                                                     BeginTime="0:0:0.27" AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <TextBlock Text="中" FontSize="12" Foreground="{StaticResource MutedTextBrush}">
                    <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="2" To="-3" Duration="0:0:0.34"
                                                     BeginTime="0:0:0.36" AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="20,14,20,18"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding ActiveModelText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox Grid.Column="1"
                                  Width="156"
                                  Margin="10,0,0,0"
                                  ItemsSource="{Binding SendModes}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SendMode}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="74"
                                 MaxHeight="190"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 ToolTip="Ctrl+Enter 发送；Enter 换行">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Modifiers="Control"
                                            Command="{Binding SendLocalCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <Button Width="88"
                                    Content="发送"
                                    Command="{Binding SendLocalCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Width="88"
                                    Margin="0,7,0,0"
                                    Content="停止生成"
                                    Command="{Binding StopGenerationCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="2,7,0,0">
                        <TextBlock Text="{Binding EstimatedTokenText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEstimatedOverLimit}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding LastGenerationUsageText}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter x:Name="RightPanelSplitter"
                      Grid.Column="3"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <Border x:Name="RightPanel"
                Grid.Column="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <TabControl Margin="12">
                <TabItem Header="上下文">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="本次发送结构" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="已知 Tiktoken 模型使用随软件发布的本地词表；其他模型回退为启发式估算。"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <TabControl Grid.Row="1" Margin="0,12,0,0">
                            <TabItem Header="分段">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ContextSegments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,9"
                                                        Padding="11"
                                                        CornerRadius="8"
                                                        Background="{StaticResource SurfaceAltBrush}">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Margin="8,0,0,0"
                                                                       Text="{Binding ProviderRole}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource AccentBrush}" />
                                                        </DockPanel>
                                                        <TextBlock Margin="0,3,0,0"
                                                                   Text="{Binding Content}"
                                                                   MaxHeight="96"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="API 结构">
                                <TextBox Text="{Binding ApiRequestPreview, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
                <TabItem Header="召回">
                    <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="长期上下文召回"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Margin="0,2,0,8"
                                       Text="召回会从较早的聊天历史中按当前输入找回相关消息，并作为本轮上下文补入；它不是重新生成，也不等同于世界书向量召回。"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Margin="0,2,0,10"
                                       Text="{Binding Retrieval.Status}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <CheckBox Content="启用自动召回"
                                      IsChecked="{Binding Retrieval.IsEnabled}" />
                            <TextBlock Margin="0,10,0,0" Text="召回范围" />
                            <ComboBox Margin="0,5,0,0"
                                      ItemsSource="{Binding Retrieval.ScopeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Retrieval.Scope}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="近期原文消息数" />
                                    <TextBox Margin="0,5,0,0"
                                             Text="{Binding Retrieval.RecentMessageCount, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="最大召回条数" />
                                    <TextBox Margin="0,5,0,0"
                                             Text="{Binding Retrieval.MaximumResults, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Margin="0,10,0,0" Text="召回 Token 预算" />
                            <TextBox Margin="0,5,0,0"
                                     Text="{Binding Retrieval.TokenBudget, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="保存召回设置"
                                        Command="{Binding Retrieval.SaveSettingsCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Content="清除本轮排除"
                                        Command="{Binding Retrieval.ClearExclusionsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>

                            <Separator Margin="0,15,0,12" />
                            <DockPanel>
                                <TextBlock Text="本轮实际召回"
                                           FontWeight="SemiBold" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Retrieval.ExcludedCount, StringFormat=已排除 {0} 条}"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </DockPanel>
                            <ItemsControl Margin="0,8,0,0"
                                          ItemsSource="{Binding Retrieval.Matches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="10"
                                                CornerRadius="8"
                                                Background="{StaticResource SurfaceAltBrush}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button DockPanel.Dock="Right"
                                                            Margin="8,0,0,0"
                                                            Content="排除"
                                                            Command="{Binding DataContext.Retrieval.ExcludeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                </DockPanel>
                                                <TextBlock Margin="0,5,0,0"
                                                           MaxHeight="84"
                                                           Text="{Binding Content}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Expander Margin="0,8,0,0" Header="组装诊断">
                                <ItemsControl Margin="0,7,0,0"
                                              ItemsSource="{Binding Retrieval.Diagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,5"
                                                       Text="{Binding}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="角色提示词"
                         Visibility="{Binding IsSingleCharacterConversation, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <TextBlock Text="{Binding CharacterPromptCharacterName, StringFormat=当前角色：{0}}"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Margin="0,6,0,12"
                                       Padding="10"
                                       Text="全局提示词负责所有角色共有的扮演职责；这里直接编辑当前角色卡的标准字段，不会另存第二份局部配置。"
                                       TextWrapping="Wrap"
                                       Background="{StaticResource AccentSoftBrush}" />

                            <TextBlock Text="角色 System Prompt"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,7"
                                       Text="补充这个角色独有的身份、边界或表演要求；为空时仍会使用全局聊天提示词和角色卡正文。"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox MinHeight="150"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding CharacterSystemPrompt, Mode=OneWay}" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Content="修改角色 System Prompt"
                                    Command="{Binding EditCharacterSystemPromptCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />

                            <TextBlock Margin="0,18,0,0"
                                       Text="历史后指令"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,7"
                                       Text="在聊天历史之后追加，适合放置每次生成前都需要再次强调的角色要求；为空表示不追加。"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox MinHeight="130"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding CharacterPostHistoryInstructions, Mode=OneWay}" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Content="修改历史后指令"
                                    Command="{Binding EditCharacterPostHistoryCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />

                            <Separator Margin="0,18,0,12" />
                            <Button HorizontalAlignment="Left"
                                    Content="编辑全局聊天提示词"
                                    Command="{Binding OpenGlobalPromptCommand}"
                                    CommandParameter="ChatSystem"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding CharacterPromptStatus}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Persona">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="用户 Persona 与全局预设"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="Persona 名称" />
                            <TextBox Margin="0,5,0,0"
                                     Text="{Binding PersonaName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,0,10">
                            <TextBlock Text="用户设定" />
                            <TextBox Margin="0,5,0,0"
                                     MinHeight="90"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding PersonaDescription, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3">
                            <TextBlock Text="全局聊天提示词" />
                            <TextBlock Margin="0,5,0,8"
                                       Text="统一在“设置 → 提示词管理”维护；这里不再保存第二份副本。"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <Button HorizontalAlignment="Left"
                                    Content="编辑全局聊天提示词"
                                    Command="{Binding OpenGlobalPromptCommand}"
                                    CommandParameter="ChatSystem"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Margin="0,10,0,0">
                            <TextBlock Margin="0,0,0,8"
                                       Text="{Binding PersonaStatus}"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <Button Content="保存 Persona"
                                    Command="{Binding SavePersonaCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="记忆">
                    <TabControl Margin="10">
                        <TabItem Header="正文">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Memory.OwnerLabel}"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Memory.Status}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{Binding Memory.CheckpointText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Row="2"
                                         Text="{Binding Memory.Body, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" />
                                <Grid Grid.Row="3" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center" Text="目标 tokens" />
                                        <TextBox Width="86"
                                                 Margin="8,0,0,0"
                                                 Text="{Binding Memory.TargetTokens, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="直接保存正文"
                                            Command="{Binding Memory.SaveBodyCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="工作流">
                            <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="增量更新与压缩"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Margin="0,2,0,8"
                                               Text="默认每新增 20 个用户轮次触发一次；单次最多发送 20 个用户轮次（含对应角色回复）。更新只生成待审核草稿，不会自动覆盖记忆正文。"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <CheckBox Margin="0,4,0,0"
                                              Content="达到阈值后自动生成待保存草稿（不会自动覆盖正文）"
                                              IsChecked="{Binding Memory.AutoGenerateEnabled}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="新增用户轮次阈值" />
                                            <TextBox Margin="0,5,0,0"
                                                     Text="{Binding Memory.UpdateIntervalTurns, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="单次最多发送用户轮次" />
                                            <TextBox Margin="0,5,0,0"
                                                     Text="{Binding Memory.MaximumSourceUserTurns, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Margin="0,10,0,0"
                                              Content="仅发送自上次检查点后的新增对话（默认开启）"
                                              IsChecked="{Binding Memory.SendOnlyNewMessages}" />
                                    <Button Margin="0,10,0,0"
                                            Content="保存工作流设置"
                                            Command="{Binding Memory.SaveSettingsCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Margin="0,0,7,0"
                                                Content="编辑全局记忆更新提示词"
                                                Command="{Binding OpenGlobalPromptCommand}"
                                                CommandParameter="MemoryUpdateSystem"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="编辑全局记忆压缩提示词"
                                                Command="{Binding OpenGlobalPromptCommand}"
                                                CommandParameter="MemoryCompressionSystem"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </WrapPanel>
                                    <TextBlock Margin="0,8,0,0"
                                               Text="记忆更新与压缩统一使用全局模板；本页保存当前记忆银行的触发频率、单次发送量和新增对话范围。"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Margin="0,0,7,7"
                                                Content="仅预览更新结构"
                                                Command="{Binding Memory.PreviewUpdateCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Margin="0,0,7,7"
                                                Content="生成更新草稿"
                                                Command="{Binding Memory.GenerateUpdateCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                        <Button Margin="0,0,7,7"
                                                Content="生成压缩草稿"
                                                Command="{Binding Memory.GenerateCompressionCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Margin="0,0,0,7"
                                                Content="停止"
                                                Command="{Binding Memory.StopGenerationCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </WrapPanel>
                                    <TextBlock Margin="0,2,0,0"
                                               Text="{Binding Memory.Status}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,10,0,4"
                                               Text="本次更新结构预览"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Memory.RequestPreview, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             MaxHeight="220" />

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="草稿">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Memory.PendingTargetText}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TabControl Grid.Row="1" Margin="0,10,0,0">
                                    <TabItem Header="可编辑正文">
                                        <TextBox Text="{Binding Memory.PendingBody, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </TabItem>
                                    <TabItem Header="API 发送结构">
                                        <TextBox Text="{Binding Memory.RequestPreview, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </TabItem>
                                </TabControl>
                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="1"
                                            Margin="0,0,8,0"
                                            Content="丢弃草稿"
                                            Command="{Binding Memory.DiscardDraftCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Grid.Column="2"
                                            Content="保存草稿并推进检查点"
                                            Command="{Binding Memory.SaveDraftCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>
                <TabItem Header="群聊"
                         Visibility="{Binding Group.IsGroupConversation, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
                        <StackPanel IsEnabled="{Binding Group.IsGroupConversation}">
                            <TextBlock Text="群聊接力与记忆合并"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding Group.Status}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding Group.RelayStateText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,14,0,0" Text="接力模式" />
                            <ComboBox Margin="0,5,0,0"
                                      ItemsSource="{Binding Group.RelayModes}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Group.RelayMode}" />
                            <CheckBox Margin="0,10,0,0"
                                      Content="自动继续角色间接力"
                                      IsChecked="{Binding Group.AutoContinueEnabled}" />
                            <CheckBox Margin="0,6,0,0"
                                      Content="识别到 @USER / Persona 时自动暂停"
                                      IsChecked="{Binding Group.PauseOnUserMention}" />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="每轮自动接力上限" />
                                <TextBox Width="72"
                                         Margin="8,0,0,0"
                                         Text="{Binding Group.MaximumAutomaticTurns, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <TextBlock Margin="0,14,0,5" Text="启用成员" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Group.Members}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="2,3"
                                                  Content="{Binding Character.Name}"
                                                  IsChecked="{Binding IsEnabled}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,12,0,5" Text="手动/首位发言者" />
                            <ComboBox ItemsSource="{Binding Group.Members}"
                                      DisplayMemberPath="Character.Name"
                                      SelectedItem="{Binding Group.SelectedNextSpeaker}" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Margin="0,0,7,7"
                                        Content="{Binding Group.PauseButtonText}"
                                        Command="{Binding Group.PauseOrResumeCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="0,0,7,7"
                                        Content="继续群聊"
                                        Command="{Binding Group.ContinueRelayCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Margin="0,0,0,7"
                                        Content="保存群聊设置"
                                        Command="{Binding Group.SaveSettingsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="7,0,0,7"
                                        Content="编辑全局群聊提示词"
                                        Command="{Binding OpenGlobalPromptCommand}"
                                        CommandParameter="GroupRelaySystem"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </WrapPanel>

                            <Border Margin="0,12,0,0"
                                    Padding="12"
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="当前群聊的接力提示词（高级）"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,6"
                                               Text="只补充当前群聊的角色接力规则；群聊记忆合并仍统一使用全局模板。"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <Expander Header="群聊接力 · 额外 System Prompt">
                                        <TextBox MinHeight="170"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding Group.GroupSystemPrompt, UpdateSourceTrigger=PropertyChanged}" />
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0"
                                    Padding="10"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="把群聊记忆合并到角色记忆"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,8"
                                               Text="角色本体记忆为主，群聊记忆为辅；先生成可编辑草稿，再到“记忆 → 草稿”保存。"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <ComboBox ItemsSource="{Binding Group.Members}"
                                              DisplayMemberPath="Character.Name"
                                              SelectedItem="{Binding Group.SelectedMergeMember}" />
                                    <Button Margin="0,8,0,0"
                                            Content="生成角色合并草稿"
                                            Command="{Binding Group.MergeMemoryCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Margin="0,8,0,0"
                                            Content="编辑全局记忆合并提示词"
                                            Command="{Binding OpenGlobalPromptCommand}"
                                            CommandParameter="GroupMemoryMergeSystem"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="世界书">
                    <TextBlock Margin="12"
                               Text="当前会从角色卡 character_book 中注入 constant 条目和命中关键词的条目；实际发送内容可在“上下文 → API 结构”核对。" />
                </TabItem>
                <TabItem Header="工具">
                    <TextBlock Margin="12" Text="聊天辅助工具与 MCP 将在后续里程碑接入。" />
                </TabItem>
            </TabControl>
        </Border>

        <!-- Keep this overlay after the pane so the composer cannot paint over the toggle. -->
        <Button x:Name="RightPanelToggleButton"
                Grid.Column="3"
                Panel.ZIndex="1000"
                Width="24"
                Height="24"
                Margin="0,0,0,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="RightPanelToggleButton_OnClick"
                ToolTip="折叠右侧栏"
                AutomationProperties.Name="折叠右侧栏"
                Style="{StaticResource SidebarToggleButtonStyle}">
            <Grid Width="16" Height="16">
                <Border Width="14"
                        Height="14"
                        CornerRadius="3"
                        BorderBrush="{StaticResource MutedTextBrush}"
                        BorderThickness="1" />
                <Border Width="1"
                        Height="8"
                        HorizontalAlignment="Right"
                        Margin="0,0,3,0"
                        Background="{StaticResource MutedTextBrush}" />
                <Path x:Name="RightPanelCollapseArrow"
                      Data="M 10,4 L 6,8 L 10,12"
                      Stroke="{StaticResource MutedTextBrush}"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
                <Path x:Name="RightPanelExpandArrow"
                      Data="M 6,4 L 10,8 L 6,12"
                      Visibility="Collapsed"
                      Stroke="{StaticResource MutedTextBrush}"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
            </Grid>
        </Button>
    </Grid>
</UserControl>
