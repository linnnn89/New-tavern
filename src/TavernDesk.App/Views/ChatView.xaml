<UserControl x:Class="TavernDesk.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:TavernDesk.Core.Models;assembly=TavernDesk.Core"
             xmlns:chat="clr-namespace:TavernDesk.App.Views.Chat"
             xmlns:presentation="clr-namespace:TavernDesk.App.Presentation">
    <UserControl.Resources>
        <Style x:Key="ComposerStatusLink" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComposerSendPart" TargetType="Button" BasedOn="{StaticResource ComposerStatusLink}">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySmall}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Part" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Part" Property="Opacity" Value="0.8" /></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextDisabled}" /></Trigger>
                <DataTrigger Binding="{Binding IsEnabled, ElementName=ChatSendButton}" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextDisabled}" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="ChatLayoutRoot"
          Margin="16"
          Background="{DynamicResource WindowBackgroundBrush}"
          UseLayoutRounding="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ConversationListColumn" Width="280" MinWidth="220" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="ConversationBodyColumn" Width="*" MinWidth="360" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="RightPanelColumn" Width="360" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <chat:ChatConversationList Grid.Column="0" />

        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <Border Grid.Column="2"
                Style="{StaticResource AppicaChatWorkspaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource AppicaChatHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="20"
                                ClipToBounds="True">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppicaShellIconFont}"
                                           FontSize="17"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="&#xE77B;" />
                                <Image Source="{Binding SelectedConversationAvatarPath, Converter={StaticResource AvatarImageConverter}, ConverterParameter=48}"
                                       Stretch="UniformToFill">
                                    <Image.Clip>
                                        <EllipseGeometry Center="20,20"
                                                         RadiusX="20"
                                                         RadiusY="20" />
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="12,0,14,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedConversation.Title, TargetNullValue={StaticResource Chat.NoConversationSelected}}"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                <Ellipse Width="7"
                                         Height="7"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessBrush}" />
                                <TextBlock Text="{Binding Status}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="{StaticResource Chat.ConversationLoaded}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Chat.DisplayLabel}" VerticalAlignment="Center" Margin="0,0,5,0"
                                       FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource MutedTextBrush}" />
                            <ComboBox Width="92" Margin="0,0,8,0" MinHeight="32"
                                      AutomationProperties.AutomationId="ChatDisplayMode"
                                      AutomationProperties.Name="{StaticResource Chat.Session.DisplayMode}"
                                      ToolTip="{StaticResource Chat.Session.DisplayMode}"
                                      ItemsSource="{Binding DisplayModes}" ItemTemplate="{StaticResource ChatCompactOptionTemplate}"
                                      SelectedValuePath="Value" SelectedValue="{Binding DisplayMode}" />
                            <Button x:Name="ChatArchiveMenuButton"
                                    Margin="0,0,8,0"
                                    Content="⋯"
                                    Click="ChatArchiveMenuButton_OnClick"
                                    ToolTip="{StaticResource Chat.ArchiveToolTip}"
                                    Style="{StaticResource AppicaHeaderIconButtonStyle}" />
                            <Popup x:Name="ChatArchiveMenuPopup"
                                   PlacementTarget="{Binding ElementName=ChatArchiveMenuButton}"
                                   Placement="Bottom"
                                   StaysOpen="True"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Width="180"
                                        Style="{StaticResource AppicaPopupSurfaceStyle}">
                                    <StackPanel>
                                        <Button Content="{StaticResource Chat.ImportJsonl}"
                                                Command="{Binding ImportChatArchiveCommand}"
                                                ToolTip="{StaticResource Chat.ImportJsonlToolTip}"
                                                Style="{StaticResource MessageToolButtonStyle}" />
                                        <Button Content="{StaticResource Chat.ExportCurrent}"
                                                Command="{Binding ExportChatArchiveCommand}"
                                                ToolTip="{StaticResource Chat.ExportCurrentToolTip}"
                                                Style="{StaticResource MessageToolButtonStyle}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <Button Content="{StaticResource Common.Stop}"
                                    Command="{Binding StopGenerationCommand}"
                                    ToolTip="{StaticResource Chat.StopGenerationToolTip}"
                                    Visibility="{Binding IsCurrentConversationGenerating, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource AppicaHeaderActionButtonStyle}" />
                        </StackPanel>
                        <Button x:Name="RightPanelToggleButton"
                                Grid.Column="3"
                                Width="32"
                                Height="32"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="RightPanelToggleButton_OnClick"
                                ToolTip="{StaticResource Chat.CollapseRightPanel}"
                                AutomationProperties.Name="{StaticResource Chat.CollapseRightPanel}"
                                Style="{StaticResource SidebarToggleButtonStyle}">
                            <Grid Width="16" Height="16">
                                <Border Width="14"
                                        Height="14"
                                        CornerRadius="5"
                                        BorderBrush="{DynamicResource MutedTextBrush}"
                                        BorderThickness="1" />
                                <Border Width="1"
                                        Height="8"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,3,0"
                                        Background="{DynamicResource MutedTextBrush}" />
                                <Path x:Name="RightPanelCollapseArrow"
                                      Data="M 6,4 L 10,8 L 6,12"
                                      Stroke="{DynamicResource MutedTextBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <Path x:Name="RightPanelExpandArrow"
                                      Data="M 10,4 L 6,8 L 10,12"
                                      Visibility="Collapsed"
                                      Stroke="{DynamicResource MutedTextBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <Border x:Name="GroupMemberStrip"
                        Grid.Row="1"
                        Padding="18,8"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="{Binding Group.IsGroupConversation, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel LastChildFill="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsControl ItemsSource="{Binding Group.Members}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="70" Margin="0,0,8,0">
                                            <Border Padding="3" CornerRadius="24" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNextSpeaker}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                        <Button Width="36"
                                                Height="36"
                                                Margin="0"
                                                Padding="0"
                                                BorderThickness="0"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                PreviewMouseLeftButtonDown="GroupMember_OnPreviewMouseLeftButtonDown">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="18"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="15"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       Text="{Binding AvatarLabel}" />
                                                            <Image Source="{Binding Character.AvatarPath, Converter={StaticResource AvatarImageConverter}, ConverterParameter=48}"
                                                                   Stretch="UniformToFill">
                                                                <Image.Clip>
                                                                    <EllipseGeometry Center="18,18"
                                                                                     RadiusX="18"
                                                                                     RadiusY="18" />
                                                                </Image.Clip>
                                                            </Image>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.ContextMenu>
                                                <ContextMenu Width="220"
                                                             MaxWidth="240"
                                                             StaysOpen="True"
                                                             Opened="GroupMemberContextMenu_OnOpened"
                                                             Closed="GroupMemberContextMenu_OnClosed"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <TextBlock MaxWidth="220"
                                                               Margin="10,8,10,5"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Character.Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Character.Name}" />
                                                    <Separator />
                                                    <MenuItem Header="{StaticResource Chat.Group.TakeTurn}"
                                                              Command="{Binding TakeTurnCommand}" />
                                                    <MenuItem Header="{StaticResource Chat.Group.RemoveMember}"
                                                              Command="{Binding RemoveMemberCommand}" />
                                                    <MenuItem Header="{StaticResource Chat.Group.OpenCharacter}"
                                                              Command="{Binding OpenCharacterCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="{StaticResource Common.Close}"
                                                              Click="GroupMemberMenuClose_OnClick" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                            </Border>
                                            <TextBlock Text="{Binding Character.Name}" ToolTip="{Binding Character.Name}"
                                                       HorizontalAlignment="Center" MaxWidth="70" TextTrimming="CharacterEllipsis"
                                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,2,0,0" />
                                            <Button Content="{StaticResource Chat.Group.TakeTurnShort}" Margin="0,2,0,0" Padding="3,1" MinHeight="20"
                                                    ToolTip="{StaticResource Chat.Group.TakeTurn}" AutomationProperties.AutomationId="GroupTakeTurn"
                                                    AutomationProperties.Name="{Binding Character.Name}" Command="{Binding TakeTurnCommand}"
                                                    IsEnabled="{Binding DataContext.Group.CanEditMembers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    HorizontalAlignment="Center" Style="{StaticResource ComposerStatusLink}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Messages.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="{StaticResource Chat.EmptyConversation}" FontSize="{DynamicResource FontSizeSubtitle}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{StaticResource Chat.EmptyConversationHelp}" TextWrapping="Wrap" MaxWidth="300" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" />
            </StackPanel>
            <ListBox x:Name="ConversationMessageList"
                     presentation:ScrollViewerWheelRouter.UsePixelWheelScrolling="True"
                     Grid.Row="2"
                     ItemsSource="{Binding Messages}"
                     Padding="24,18"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="MessageContainer"
                                  Margin="0,0,20,20"
                                  MaxWidth="760"
                                 HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border x:Name="LeftMessageSpacer"
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Width="12" />

                                 <Border x:Name="MessageAvatar"
                                         Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="0"
                                         VerticalAlignment="Top"
                                         Style="{StaticResource AppicaMessageAvatarStyle}">
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppicaShellIconFont}"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="&#xE77B;" />
                                        <Image Source="{Binding AvatarPath, Converter={StaticResource AvatarImageConverter}, ConverterParameter=48}"
                                               Stretch="UniformToFill">
                                            <Image.Clip>
                                                <EllipseGeometry Center="21,21"
                                                                 RadiusX="21"
                                                                 RadiusY="21" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                 </Border>

                                <Border x:Name="RightMessageSpacer"
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="3"
                                        Width="12"
                                        Visibility="Collapsed" />

                                <StackPanel x:Name="MessageMetadata"
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Margin="3,0,0,7"
                                            Orientation="Horizontal">
                                    <TextBlock Text="{Binding SenderLabel}"
                                               Style="{StaticResource AppicaMessageNameStyle}" />
                                    <TextBlock Text="{Binding TimestampText}"
                                               Style="{StaticResource AppicaMessageTimeStyle}" />
                                </StackPanel>

                                <Grid x:Name="MessageHost"
                                      Grid.Row="1"
                                      Grid.Column="2"
                                      HorizontalAlignment="Left"
                                      Margin="0,16,0,0">
                                    <Border x:Name="MessageBubble"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource AppicaMessageBubbleStyle}"
                                            PreviewMouseRightButtonUp="MessageBubble_OnPreviewMouseRightButtonUp">
                                        <presentation:MarkdownMessagePresenter MarkdownText="{Binding DisplayContent}"
                                                                               FontSize="{DynamicResource ChatFontSize}" />
                                    </Border>
                                    <Border x:Name="HoverActions"
                                            Margin="0,-16,4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource AppicaMessageHoverBarStyle}">
                                                <Setter Property="Opacity" Value="0" />
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=MessageHost}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Setter Property="IsHitTestVisible" Value="True" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Setter Property="IsHitTestVisible" Value="True" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding CopyCommand}"
                                                    ToolTip="{StaticResource Common.Copy}"
                                                    Style="{StaticResource AppicaMessageHoverButtonStyle}">
                                                <TextBlock Text="▣" FontSize="12" />
                                            </Button>
                                            <Button Command="{Binding EditCommand}"
                                                    ToolTip="{StaticResource Common.Edit}"
                                                    Style="{StaticResource AppicaMessageHoverButtonStyle}">
                                                <TextBlock Text="✎" FontSize="13" />
                                            </Button>
                                            <Button Command="{Binding ForkCommand}"
                                                    ToolTip="{StaticResource Chat.IndependentBranch}"
                                                    Style="{StaticResource AppicaMessageHoverButtonStyle}">
                                                <TextBlock Text="⑂" FontSize="13" />
                                            </Button>
                                            <Button Command="{Binding RegenerateCommand}"
                                                    ToolTip="{StaticResource Chat.RegenerateToolTip}"
                                                    Style="{StaticResource AppicaMessageHoverButtonStyle}">
                                                <TextBlock Text="↻" FontSize="13" />
                                            </Button>
                                            <Button Command="{Binding ContinueCommand}"
                                                    ToolTip="{StaticResource Chat.ContinueGenerationToolTip}"
                                                    Style="{StaticResource AppicaMessageHoverButtonStyle}">
                                                <TextBlock Text="▶" FontSize="11" />
                                            </Button>
                                            <Button Command="{Binding DeleteCommand}"
                                                    ToolTip="{StaticResource Common.Delete}"
                                                    Style="{StaticResource AppicaMessageHoverButtonStyle}">
                                                <TextBlock Text="✕" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel x:Name="MessageActions"
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Left"
                                            Orientation="Horizontal">
                                    <Border x:Name="CandidateNavigator"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Padding="1"
                                            Panel.ZIndex="2"
                                            Visibility="Collapsed"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="‹"
                                                    Command="{Binding PreviousCandidateCommand}"
                                                    Style="{StaticResource CandidateNavigationButtonStyle}"
                                                    ToolTip="{StaticResource Chat.PreviousCandidateToolTip}" />
                                            <TextBlock MinWidth="28"
                                                       Margin="1,0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Text="{Binding CandidateNavigationLabel}"
                                                       FontSize="{DynamicResource FontSizeCaption2}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <Button Content="›"
                                                    Command="{Binding NextCandidateCommand}"
                                                    Style="{StaticResource CandidateNavigationButtonStyle}"
                                                    ToolTip="{StaticResource Chat.NextCandidateToolTip}" />
                                        </StackPanel>
                                    </Border>

                                    <Button Style="{StaticResource MessagePlusButtonStyle}"
                                            AutomationProperties.Name="{StaticResource Chat.MessageToolsToolTip}"
                                            ToolTip="{StaticResource Chat.MessageToolsToolTip}"
                                            PreviewMouseLeftButtonDown="MessagePlus_OnPreviewMouseLeftButtonDown"
                                            Click="MessagePlus_OnClick"
                                            MouseLeave="MessagePlus_OnMouseLeave" />
                                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SenderKind}" Value="Character">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Command="{Binding SpeakCommand}"
                                                AutomationProperties.AutomationId="SpeakMessage"
                                                AutomationProperties.Name="{StaticResource Speech.Speak}"
                                                ToolTip="{Binding SpeechToolTip}" ToolTipService.ShowOnDisabled="True"
                                                Width="30" Height="28" Padding="3"
                                                Style="{StaticResource AppicaMessageHoverButtonStyle}">
                                            <TextBlock Text="{Binding SpeechGlyph}" FontFamily="{StaticResource AppicaShellIconFont}" FontSize="15" />
                                        </Button>
                                        <Button Command="{Binding SpeechSettingsCommand}"
                                                AutomationProperties.AutomationId="MessageSpeechSettings"
                                                AutomationProperties.Name="{StaticResource Speech.Title}"
                                                ToolTip="{StaticResource Speech.Title}"
                                                Width="28" Height="28" Padding="3"
                                                Style="{StaticResource AppicaMessageHoverButtonStyle}">
                                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource AppicaShellIconFont}" FontSize="12" />
                                        </Button>
                                        <TextBlock Text="{Binding SpeechStatus}" MaxWidth="280" TextWrapping="Wrap"
                                                   Margin="5,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <Popup IsOpen="{Binding IsToolbarOpen, Mode=TwoWay}"
                                       DataContext="{Binding}"
                                       PlacementTarget="{Binding ElementName=MessageBubble}"
                                       Placement="MousePoint"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Width="178"
                                            Style="{StaticResource AppicaPopupSurfaceStyle}">
                                        <StackPanel>
                                            <Button Command="{Binding EditCommand}"
                                                    Style="{StaticResource MessageToolButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="28" Text="✎" FontSize="17" />
                                                    <TextBlock Text="{StaticResource Common.Edit}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding CopyCommand}"
                                                    Style="{StaticResource MessageToolButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="28" Text="▣" FontSize="15" />
                                                    <TextBlock Text="{StaticResource Common.Copy}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ForkCommand}"
                                                    Style="{StaticResource MessageToolButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="28" Text="⑂" FontSize="17" />
                                                    <TextBlock Text="{StaticResource Chat.IndependentBranch}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding RegenerateCommand}"
                                                    ToolTip="{StaticResource Chat.RegenerateToolTip}"
                                                    Style="{StaticResource MessageToolButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="28" Text="↻" FontSize="17" />
                                                    <TextBlock Text="{StaticResource Chat.Regenerate}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ContinueCommand}"
                                                    ToolTip="{StaticResource Chat.ContinueGenerationToolTip}"
                                                    Style="{StaticResource MessageToolButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="28" Text="▶" FontSize="15" />
                                                    <TextBlock Text="{StaticResource Chat.ContinueGeneration}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Border Height="1"
                                                    Margin="8,5"
                                                    Background="{DynamicResource BorderBrush}" />
                                            <Button Command="{Binding DeleteCommand}"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    Style="{StaticResource MessageToolButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="28" Text="⌫" FontSize="17"
                                                               Foreground="{DynamicResource DangerBrush}" />
                                                    <TextBlock Text="{StaticResource Common.Delete}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource DangerBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding SenderKind}" Value="{x:Static models:MessageSenderKind.User}">
                                    <Setter TargetName="MessageBubble" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Setter TargetName="MessageBubble" Property="BorderBrush" Value="{DynamicResource AppicaSelectedBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasMultipleCandidates}" Value="True">
                                    <Setter TargetName="CandidateNavigator"
                                            Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                 <DataTrigger Binding="{Binding DataContext.IsNovelMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Value="True">
                                    <Setter TargetName="MessageContainer"
                                            Property="HorizontalAlignment"
                                            Value="Stretch" />
                                    <Setter TargetName="MessageContainer"
                                            Property="MaxWidth"
                                            Value="1200" />
                                    <Setter TargetName="MessageBubble"
                                            Property="Background"
                                            Value="Transparent" />
                                    <Setter TargetName="MessageBubble"
                                            Property="BorderThickness"
                                            Value="0" />
                                     <Setter TargetName="MessageBubble"
                                             Property="Padding"
                                             Value="4,8,20,8" />
                                 </DataTrigger>
                                <DataTrigger Binding="{Binding SenderKind}" Value="{x:Static models:MessageSenderKind.User}">
                                    <Setter TargetName="MessageContainer" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="MessageAvatar" Property="Grid.Column" Value="4" />
                                    <Setter TargetName="LeftMessageSpacer" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="RightMessageSpacer" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="MessageMetadata" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="MessageMetadata" Property="Margin" Value="0,0,3,7" />
                                    <Setter TargetName="MessageHost" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="HoverActions" Property="HorizontalAlignment" Value="Left" />
                                    <Setter TargetName="HoverActions" Property="Margin" Value="4,-16,0,0" />
                                    <Setter TargetName="MessageActions" Property="HorizontalAlignment" Value="Right" />
                                </DataTrigger>
                             </DataTemplate.Triggers>
                        </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button x:Name="ScrollToBottomButton" Grid.Row="2" Panel.ZIndex="5"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                    Content="{DynamicResource Chat.ScrollToBottom}" Visibility="Collapsed"
                    AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                    Click="ScrollToBottomButton_OnClick" Style="{StaticResource SecondaryButtonStyle}" />

            <!-- A reasoning stream is a transient progress signal. A whole-string
                 pulse works for every supported language without per-character assumptions. -->
            <TextBlock Grid.Row="2"
                       Margin="0,0,0,12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Text="{StaticResource Chat.Thinking}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       IsHitTestVisible="False"
                       Visibility="{Binding IsModelThinking, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock.RenderTransform>
                    <TranslateTransform />
                </TextBlock.RenderTransform>
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.45"
                                                 To="0.9"
                                                 Duration="0:0:0.65"
                                                 AutoReverse="True" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="1"
                                                 To="-2"
                                                 Duration="0:0:0.65"
                                                 AutoReverse="True" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>

            <StackPanel Grid.Row="2"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Panel.ZIndex="4"
                        Orientation="Horizontal"
                        Visibility="{Binding IsGroupAutoRelayCountdownVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding GroupAutoRelayCountdownText}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Opacity="0.68"
                           Foreground="{DynamicResource MutedTextBrush}"
                           AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0.38"
                                                     To="0.78"
                                                     Duration="0:0:0.8"
                                                     AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <Button Margin="8,0,0,0"
                        Height="22"
                        MinWidth="54"
                        Padding="5,1"
                        FontSize="{DynamicResource FontSizeCaption}"
                        Content="{StaticResource Chat.Group.StopAutoRelay}"
                        Command="{Binding StopGroupAutoRelayCommand}"
                        ToolTip="{StaticResource Chat.Group.StopAutoRelayToolTip}"
                        AutomationProperties.Name="{StaticResource Chat.Group.StopAutoRelayToolTip}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>

            <Border Grid.Row="3" Style="{StaticResource AppicaChatComposerStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource WarningBg}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                            Visibility="{Binding IsGenerationModelMissing, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.AutomationId="ModelAssignmentNotice">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="12,0,0,0"
                                    Command="{Binding OpenModelSettingsCommand}" AutomationProperties.AutomationId="AssignChatModel"
                                    Style="{StaticResource ComposerStatusLink}">
                                <TextBlock Text="{StaticResource Chat.AssignModel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource AccentBrush}" />
                            </Button>
                            <TextBlock Text="{Binding ActiveModelText}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <TextBox x:Name="ChatComposer" AutomationProperties.AutomationId="ChatComposer"
                                 AutomationProperties.Name="{StaticResource Chat.ComposerToolTip}"
                                 Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource AppicaComposerTextBoxStyle}"
                                 ToolTip="{StaticResource Chat.ComposerToolTip}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendLocalCommand}" />
                                <KeyBinding Key="Esc" Command="{Binding StopGenerationCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{StaticResource Chat.ComposerPlaceholder}" IsHitTestVisible="False" Margin="3,4"
                                   FontSize="{DynamicResource ChatFontSize}" Foreground="{DynamicResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding ComposerText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button AutomationProperties.AutomationId="ContextSummary" Click="ContextSummary_OnClick"
                                    ToolTip="{Binding EstimatedTokenBreakdown}" Margin="0,3,14,3" Style="{StaticResource ComposerStatusLink}">
                                <TextBlock Text="{Binding EstimatedTokenCompactText}" Style="{StaticResource TokenUsageTextStyle}" />
                            </Button>
                            <Button AutomationProperties.AutomationId="MemorySummary" Click="MemorySummary_OnClick"
                                    ToolTip="{Binding Memory.Status}" Margin="0,3,0,3" Style="{StaticResource ComposerStatusLink}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource AppicaShellIconFont}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Memory.SummaryText}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <Grid Grid.Column="1" MinWidth="98" VerticalAlignment="Center">
                            <Border CornerRadius="8" Visibility="{Binding IsCurrentConversationGenerating, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsEnabled, ElementName=ChatSendButton}" Value="False"><Setter Property="Background" Value="{DynamicResource ControlDisabledBackground}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                    <Button x:Name="ChatSendButton" AutomationProperties.AutomationId="ChatSendButton" Content="{StaticResource Chat.Send}"
                                            Command="{Binding SendLocalCommand}" Style="{StaticResource ComposerSendPart}" ToolTip="{StaticResource Chat.ComposerToolTip}" />
                                    <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Margin="0,8" />
                                    <Button x:Name="SendModeMenu" Grid.Column="2" Content="⌄" Click="SendModeMenu_OnClick"
                                            AutomationProperties.AutomationId="ChatSendModeMenu" AutomationProperties.Name="{StaticResource Chat.SendModeToolTip}"
                                            ToolTip="{StaticResource Chat.SendModeToolTip}" Style="{StaticResource ComposerSendPart}" Padding="3,8">
                                        <Button.ContextMenu>
                                            <ContextMenu StaysOpen="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{StaticResource Chat.SendMode.SendAndGenerate}" Command="{Binding SetSendModeCommand}"
                                                          CommandParameter="{x:Static models:ChatSendMode.SendAndGenerate}" Click="SendModeChoice_OnClick">
                                                    <MenuItem.Icon><TextBlock Text="✓"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SendMode}" Value="{x:Static models:ChatSendMode.SendAndGenerate}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{StaticResource Chat.SendMode.SaveOnly}" Command="{Binding SetSendModeCommand}"
                                                          CommandParameter="{x:Static models:ChatSendMode.SaveOnly}" Click="SendModeChoice_OnClick">
                                                    <MenuItem.Icon><TextBlock Text="✓"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SendMode}" Value="{x:Static models:ChatSendMode.SaveOnly}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="{StaticResource Common.Close}" Click="SendModeChoice_OnClick" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </Border>
                            <Button Content="{StaticResource Common.Stop}" Command="{Binding StopGenerationCommand}" Style="{StaticResource DestructiveButtonStyle}"
                                    Visibility="{Binding IsCurrentConversationGenerating, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            </Grid>
        </Border>

        <GridSplitter x:Name="RightPanelSplitter"
                      Grid.Column="3"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <Border x:Name="RightPanel"
                Grid.Column="4"
                PreviewKeyDown="RightPanel_OnPreviewKeyDown"
                Style="{StaticResource AppicaChatInspectorStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="RightPanelOverlayHeader" Visibility="Collapsed" Padding="8,4"
                        Background="{DynamicResource SurfaceSunken}">
                    <Button x:Name="RightPanelOverlayCloseButton" Content="×"
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="RightPanelOverlayCloseButton"
                            AutomationProperties.Name="{StaticResource Chat.RightPanel.Collapse}"
                            ToolTip="{StaticResource Chat.RightPanel.Collapse}"
                            Style="{StaticResource MessageToolButtonStyle}"
                            Click="RightPanelOverlayCloseButton_OnClick" />
                </Border>
            <TabControl x:Name="InspectorTabs" Grid.Row="1" Style="{StaticResource InspectorActivityControlStyle}">
                <TabItem Header="{StaticResource Chat.Tab.Context}" Tag="&#xE8A5;">
                    <chat:ChatContextPanel />
                </TabItem>
                <TabItem Header="{StaticResource Chat.Tab.Character}" Tag="&#xE77B;"
                         Visibility="{Binding IsSingleCharacterConversation, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <chat:ChatCharacterPanel />
                </TabItem>
                <TabItem Header="{StaticResource Chat.Tab.Persona}" Tag="&#xE716;">
                    <chat:ChatPersonaPanel />
                </TabItem>
                <TabItem Header="{StaticResource Chat.Tab.Memory}" Tag="&#xE8F1;">
                    <chat:ChatMemoryPanel />
                </TabItem>
                <TabItem Header="{StaticResource Chat.Tab.Session}" Tag="&#xE713;">
                    <chat:ChatSessionPanel />
                </TabItem>
            </TabControl>
            </Grid>
        </Border>


    </Grid>
</UserControl>
