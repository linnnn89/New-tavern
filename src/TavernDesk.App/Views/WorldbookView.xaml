<UserControl x:Class="TavernDesk.App.Views.WorldbookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:TavernDesk.App.Presentation">
    <UserControl.Resources>
        <presentation:WorldbookEntryTextConverter x:Key="WorldbookEntryTextConverter" />
    </UserControl.Resources>
    <Grid Margin="16,16,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{StaticResource Worldbook.Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <Button Content="{StaticResource Worldbook.Refresh}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="ImportOptionsButton"
                        Margin="8,0,0,0"
                        Content="{StaticResource Worldbook.ImportAction}"
                        Click="ImportOptionsButton_OnClick"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Padding="10,8"
                CornerRadius="12"
                Background="{DynamicResource AccentSoftBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel>
                    <TextBlock Text="{StaticResource Worldbook.MountSummary}" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding Mounts.Count, StringFormat={StaticResource Worldbook.MountCountFormat}}"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <Button x:Name="MountManagementButton"
                        DockPanel.Dock="Right"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Content="{StaticResource Worldbook.ManageMounts}"
                        Click="MountManagementButton_OnClick"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </DockPanel>
        </Border>

        <Popup x:Name="ImportOptionsPopup"
               PlacementTarget="{Binding ElementName=ImportOptionsButton}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <Border Width="560"
                    MaxHeight="460"
                    Padding="16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect Color="#54000000"
                                      BlurRadius="18"
                                      ShadowDepth="5"
                                      Opacity="0.42" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{StaticResource Worldbook.ImportSection}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Margin="0,4,0,12"
                                   Text="{StaticResource Worldbook.ImportDescription}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{StaticResource Worldbook.ImportScope}" />
                        <ComboBox Margin="0,5,0,0"
                                  ItemsSource="{Binding ScopeOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedScopeOption}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{StaticResource Worldbook.InitialCharacterBinding}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCharacterScope}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ComboBox Grid.Column="1"
                                      Margin="8,0,18,0"
                                      ItemsSource="{Binding Characters}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedCharacter}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox"
                                           BasedOn="{StaticResource ModernComboBoxStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCharacterScope}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                            <TextBlock Grid.Column="2"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Text="{StaticResource Worldbook.InitialCampaignBinding}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCampaignScope}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding CampaignScenarios}"
                                      DisplayMemberPath="Title"
                                      SelectedItem="{Binding SelectedCampaignScenario}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox"
                                           BasedOn="{StaticResource ModernComboBoxStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCampaignScope}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </Grid>
                        <TextBlock Margin="0,12,0,0"
                                   Text="{StaticResource Worldbook.TriggerDescription}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <Button Margin="0,14,0,0"
                                Content="{StaticResource Worldbook.SelectAndImport}"
                                Command="{Binding ImportCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="{DynamicResource InsetMd}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="WorldbookSelectorLabel" Text="{StaticResource Worldbook.Library}" />
                            <ComboBox Margin="{DynamicResource LabelGap}"
                                      AutomationProperties.AutomationId="WorldbookSelector"
                                      AutomationProperties.LabeledBy="{Binding ElementName=WorldbookSelectorLabel}"
                                      ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,12,0"
                                   Text="{Binding SelectedBook.IndexedChunkCount, StringFormat={StaticResource Worldbook.IndexedChunkCountFormat}}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="{StaticResource Worldbook.RebuildIndex}"
                                    Command="{Binding RebuildIndexCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="{StaticResource Worldbook.Delete}"
                                    Margin="8,0,0,0"
                                    Command="{Binding DeleteCommand}"
                                    Style="{StaticResource DestructiveButtonStyle}" />
                        </WrapPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{DynamicResource WorldbookEntryListWidth}" />
                            <ColumnDefinition Width="{DynamicResource PaneGapWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="0">
                            <ListBox AutomationProperties.AutomationId="WorldbookEntries" ItemsSource="{Binding Entries}"
                                     SelectedItem="{Binding SelectedEntry}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItemStyle}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,7">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding ContentType, Converter={StaticResource WorldbookEntryTextConverter}}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border Grid.Column="2"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="WorldbookEntryTitleLabel" Text="{StaticResource Worldbook.EntryName}"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox AutomationProperties.AutomationId="WorldbookEntryTitle"
                                                 IsReadOnly="{Binding IsSavingEntry}"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=WorldbookEntryTitleLabel}"
                                                 Text="{Binding EntryTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="{DynamicResource FontSizeSubtitle}"
                                                 FontWeight="SemiBold" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Height="32"
                                                MinHeight="0"
                                                Content="{StaticResource Worldbook.SaveEntryName}"
                                                Command="{Binding SaveEntryTitleCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{StaticResource Worldbook.EntryNameUnsaved}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Visibility="{Binding IsEntryTitleDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Margin="0,5,0,12"
                                               Text="{Binding SelectedEntry.Comment}"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBox Text="{Binding EntryContent, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="WorldbookEntryContent"
                                             AutomationProperties.Name="{StaticResource Worldbook.EntryBody}"
                                             IsReadOnly="{Binding IsSavingEntry}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="120"
                                             VerticalContentAlignment="Top" />
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding SelectedEntry.Keys, Converter={StaticResource WorldbookEntryTextConverter}, StringFormat={StaticResource Worldbook.KeywordsFormat}}"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
        </Border>
    </Grid>
</UserControl>
