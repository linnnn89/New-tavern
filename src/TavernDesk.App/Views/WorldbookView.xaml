<UserControl x:Class="TavernDesk.App.Views.WorldbookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="世界书" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Content="刷新"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="导入世界书 / 角色卡"
                        Margin="8,0,0,0"
                        Command="{Binding ImportCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Padding="10,8"
                CornerRadius="9"
                Background="{StaticResource AccentSoftBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="175" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="新导入挂载：" />
                <ComboBox Grid.Column="1"
                          Margin="8,0,18,0"
                          ItemsSource="{Binding ScopeOptions}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedScopeOption}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="初始绑定角色：">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCharacterScope}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          Margin="8,0,0,0"
                          ItemsSource="{Binding Characters}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCharacter}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCharacterScope}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Text="初始绑定剧本：">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCampaignScope}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ComboBox Grid.Row="1"
                          Grid.Column="3"
                          Margin="8,0,0,0"
                          ItemsSource="{Binding CampaignScenarios}"
                          DisplayMemberPath="Title"
                          SelectedItem="{Binding SelectedCampaignScenario}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCampaignScope}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <TextBlock Grid.Row="0"
                           Grid.RowSpan="2"
                           Grid.Column="4"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Text="关键词/常驻触发保持酒馆原语义；FTS/向量索引使用词条名、关键词和正文。"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" MinWidth="210" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="16,14,16,10"
                               Text="世界书库"
                               FontWeight="SemiBold" />
                    <ListBox Grid.Row="1"
                             Margin="8,0"
                             Padding="0"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding Books}"
                             SelectedItem="{Binding SelectedBook}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="11,10" CornerRadius="7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="{Binding SourceKindText}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding EntryCount, StringFormat=条目 {0} 个}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="225" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedBook.Name}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,12,0"
                                   Text="{Binding SelectedBook.IndexedChunkCount, StringFormat=索引 {0} 个向量块}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="重建索引"
                                    Command="{Binding RebuildIndexCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="删除"
                                    Margin="8,0,0,0"
                                    Command="{Binding DeleteCommand}"
                                    Foreground="{StaticResource DangerBrush}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Padding="10"
                            Background="{StaticResource SurfaceAltBrush}"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="当前挂载"
                                           FontWeight="SemiBold" />
                                <ScrollViewer Grid.Row="1"
                                              Margin="0,6,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Mounts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,0,0,4"
                                                           Text="{Binding ScopeText}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                            <Border Grid.Column="1"
                                    Margin="0,2"
                                    Width="1"
                                    Background="{StaticResource BorderBrush}" />
                            <TabControl Grid.Column="2"
                                        Margin="0,0,0,0">
                                <TabItem Header="角色绑定">
                                    <Grid Margin="8,8,8,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="选择要挂载到此世界书的角色"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal">
                                                <Button Content="全选"
                                                        Height="28"
                                                        MinHeight="0"
                                                        Padding="6,0"
                                                        Command="{Binding SelectAllCharacterBindingsCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="清空"
                                                        Height="28"
                                                        MinHeight="0"
                                                        Margin="4,0,0,0"
                                                        Padding="6,0"
                                                        Command="{Binding ClearCharacterBindingsCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="保存"
                                                        Height="28"
                                                        MinHeight="0"
                                                        Margin="4,0,0,0"
                                                        Padding="7,0"
                                                        Command="{Binding SaveCharacterBindingsCommand}"
                                                        Style="{StaticResource PrimaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <ScrollViewer Grid.Row="1"
                                                      Margin="0,6,0,0"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding CharacterBindings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Name}"
                                                                  IsChecked="{Binding IsBound, Mode=TwoWay}"
                                                                  Margin="2,2,8,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="跑团剧本绑定">
                                    <Grid Margin="8,8,8,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="选择要挂载到此世界书的剧本"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal">
                                                <Button Content="全选"
                                                        Height="28"
                                                        MinHeight="0"
                                                        Padding="6,0"
                                                        Command="{Binding SelectAllCampaignBindingsCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="清空"
                                                        Height="28"
                                                        MinHeight="0"
                                                        Margin="4,0,0,0"
                                                        Padding="6,0"
                                                        Command="{Binding ClearCampaignBindingsCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="保存"
                                                        Height="28"
                                                        MinHeight="0"
                                                        Margin="4,0,0,0"
                                                        Padding="7,0"
                                                        Command="{Binding SaveCampaignBindingsCommand}"
                                                        Style="{StaticResource PrimaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <ScrollViewer Grid.Row="1"
                                                      Margin="0,6,0,0"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding CampaignBindings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="2,2,8,5">
                                                            <CheckBox Content="{Binding Title}"
                                                                      IsChecked="{Binding IsBound, Mode=TwoWay}" />
                                                            <TextBlock Margin="20,2,0,0"
                                                                       Text="{Binding Summary}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{StaticResource MutedTextBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="0">
                            <ListBox ItemsSource="{Binding Entries}"
                                     SelectedItem="{Binding SelectedEntry}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,7">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding ContentType}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border Grid.Column="2"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="词条名"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding EntryTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="16"
                                                 FontWeight="SemiBold" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Height="32"
                                                MinHeight="0"
                                                Content="保存词条名"
                                                Command="{Binding SaveEntryTitleCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                    <TextBlock Margin="0,5,0,12"
                                               Text="{Binding SelectedEntry.Comment}"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding SelectedEntry.Content}"
                                             IsReadOnly="True"
                                              AcceptsReturn="True"
                                              TextWrapping="Wrap"
                                              VerticalScrollBarVisibility="Auto"
                                              MinHeight="120"
                                              VerticalContentAlignment="Top" />
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding SelectedEntry.Keys, StringFormat=关键词：{0}}"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
