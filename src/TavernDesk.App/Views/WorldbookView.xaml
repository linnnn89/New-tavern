<UserControl x:Class="TavernDesk.App.Views.WorldbookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="世界书" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Content="刷新"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="导入世界书 / 角色卡"
                        Margin="8,0,0,0"
                        Command="{Binding ImportCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="14,10"
                CornerRadius="9"
                Background="{StaticResource AccentSoftBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="新导入挂载：" />
                <ComboBox Grid.Column="1"
                          Margin="8,0,18,0"
                          ItemsSource="{Binding ScopeOptions}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedScopeOption}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="初始绑定角色：">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCharacterScope}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          Margin="8,0,0,0"
                          ItemsSource="{Binding Characters}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCharacter}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCharacterScope}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Text="初始绑定剧本：">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCampaignScope}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ComboBox Grid.Row="1"
                          Grid.Column="3"
                          Margin="8,0,0,0"
                          ItemsSource="{Binding CampaignScenarios}"
                          DisplayMemberPath="Title"
                          SelectedItem="{Binding SelectedCampaignScenario}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCampaignScope}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <TextBlock Grid.Row="0"
                           Grid.RowSpan="2"
                           Grid.Column="4"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Text="关键词/常驻触发保持酒馆原语义；FTS/向量索引使用词条名、关键词和正文。"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="250" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="16,14,16,10"
                               Text="世界书库"
                               FontWeight="SemiBold" />
                    <ListBox Grid.Row="1"
                             Margin="8,0"
                             Padding="0"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding Books}"
                             SelectedItem="{Binding SelectedBook}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="11,10" CornerRadius="7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="{Binding SourceKindText}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding EntryCount, StringFormat=条目 {0} 个}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="260" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedBook.Name}"
                                       FontSize="24"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding SelectedBook.Description}"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="重建 Embedding 索引"
                                    Command="{Binding RebuildIndexCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="删除"
                                    Margin="8,0,0,0"
                                    Command="{Binding DeleteCommand}"
                                    Foreground="{StaticResource DangerBrush}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="来源" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,18,0"
                                   Text="{Binding SelectedBook.SourceFileName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="索引" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="3"
                                   Margin="8,0,0,0"
                                   Text="{Binding SelectedBook.IndexedChunkCount, StringFormat={}{0} 个向量块}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="10"
                            Background="{StaticResource SurfaceAltBrush}"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="当前挂载"
                                       FontWeight="SemiBold" />
                            <ListBox Grid.Row="1"
                                     Margin="0,5,0,0"
                                     ItemsSource="{Binding Mounts}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ScopeText}"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2" Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="角色绑定（可多选）"
                                                   FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                            <Button Content="全选"
                                                    Padding="5,2"
                                                    Command="{Binding SelectAllCharacterBindingsCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button Content="清空"
                                                    Margin="4,0,0,0"
                                                    Padding="5,2"
                                                    Command="{Binding ClearCharacterBindingsCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button Content="保存绑定"
                                                    Margin="4,0,0,0"
                                                    Padding="5,2"
                                                    Command="{Binding SaveCharacterBindingsCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1"
                                                  Margin="0,6,0,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding CharacterBindings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsBound, Mode=TwoWay}"
                                                          Margin="2,2,8,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                                <Border Grid.Column="1"
                                        Margin="0,2"
                                        Background="{StaticResource BorderBrush}"
                                        Width="1" />
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="跑团剧本绑定（可多选）"
                                                   FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                            <Button Content="全选"
                                                    Padding="5,2"
                                                    Command="{Binding SelectAllCampaignBindingsCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button Content="清空"
                                                    Margin="4,0,0,0"
                                                    Padding="5,2"
                                                    Command="{Binding ClearCampaignBindingsCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button Content="保存绑定"
                                                    Margin="4,0,0,0"
                                                    Padding="5,2"
                                                    Command="{Binding SaveCampaignBindingsCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1"
                                                  Margin="0,6,0,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding CampaignBindings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,2,8,5">
                                                        <CheckBox Content="{Binding Title}"
                                                                  IsChecked="{Binding IsBound, Mode=TwoWay}" />
                                                        <TextBlock Margin="20,2,0,0"
                                                                   Text="{Binding Summary}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="0">
                            <ListBox ItemsSource="{Binding Entries}"
                                     SelectedItem="{Binding SelectedEntry}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="9,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding ContentType}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border Grid.Column="2"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="词条名"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding EntryTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="18"
                                                 FontWeight="SemiBold" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Content="保存词条名"
                                                Command="{Binding SaveEntryTitleCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                    <TextBlock Margin="0,5,0,12"
                                               Text="{Binding SelectedEntry.Comment}"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding SelectedEntry.Content}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="180"
                                             VerticalContentAlignment="Top" />
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding SelectedEntry.Keys, StringFormat=关键词：{0}}"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
