<UserControl x:Class="TavernDesk.App.Views.WorldbookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="世界书" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Content="刷新"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="ImportOptionsButton"
                        Margin="8,0,0,0"
                        Content="导入世界书 / 角色卡…"
                        Click="ImportOptionsButton_OnClick"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Padding="10,8"
                CornerRadius="12"
                Background="{DynamicResource AccentSoftBrush}">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="挂载摘要" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding Mounts.Count, StringFormat=当前挂载：{0} 个角色或跑团剧本}"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <Button x:Name="MountManagementButton"
                        DockPanel.Dock="Right"
                        Content="管理挂载…"
                        Click="MountManagementButton_OnClick"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </DockPanel>
        </Border>

        <Popup x:Name="ImportOptionsPopup"
               PlacementTarget="{Binding ElementName=ImportOptionsButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <Border Width="560"
                    MaxHeight="460"
                    Padding="16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect Color="#54000000"
                                      BlurRadius="18"
                                      ShadowDepth="5"
                                      Opacity="0.42" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="导入世界书或角色卡" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Margin="0,4,0,12"
                                   Text="先选择导入作用域；导入仍使用原有工作副本和绑定命令。"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="导入到" />
                        <ComboBox Margin="0,5,0,0"
                                  ItemsSource="{Binding ScopeOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedScopeOption}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="初始绑定角色：">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCharacterScope}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ComboBox Grid.Column="1"
                                      Margin="8,0,18,0"
                                      ItemsSource="{Binding Characters}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedCharacter}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox"
                                           BasedOn="{StaticResource ModernComboBoxStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCharacterScope}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                            <TextBlock Grid.Column="2"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Text="初始绑定剧本：">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCampaignScope}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding CampaignScenarios}"
                                      DisplayMemberPath="Title"
                                      SelectedItem="{Binding SelectedCampaignScenario}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox"
                                           BasedOn="{StaticResource ModernComboBoxStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCampaignScope}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </Grid>
                        <TextBlock Margin="0,12,0,0"
                                   Text="关键词/常驻触发保持酒馆原语义；FTS/向量索引使用词条名、关键词和正文。"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <Button Margin="0,14,0,0"
                                Content="选择文件并导入"
                                Command="{Binding ImportCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" MinWidth="210" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="16,14,16,10"
                               Text="世界书库"
                               FontWeight="SemiBold" />
                    <ListBox Grid.Row="1"
                             Margin="8,0"
                             Padding="0"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding Books}"
                             SelectedItem="{Binding SelectedBook}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource ModernListBoxItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="11,10" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="{Binding SourceKindText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding EntryCount, StringFormat=条目 {0} 个}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedBook.Name}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,12,0"
                                   Text="{Binding SelectedBook.IndexedChunkCount, StringFormat=索引 {0} 个向量块}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="重建索引"
                                    Command="{Binding RebuildIndexCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="删除"
                                    Margin="8,0,0,0"
                                    Command="{Binding DeleteCommand}"
                                    Foreground="{DynamicResource DangerBrush}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="0">
                            <ListBox ItemsSource="{Binding Entries}"
                                     SelectedItem="{Binding SelectedEntry}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,7">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding ContentType}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border Grid.Column="2"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="词条名"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding EntryTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="16"
                                                 FontWeight="SemiBold" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Height="32"
                                                MinHeight="0"
                                                Content="保存词条名"
                                                Command="{Binding SaveEntryTitleCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                    <TextBlock Margin="0,5,0,12"
                                               Text="{Binding SelectedEntry.Comment}"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBox Text="{Binding SelectedEntry.Content}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="120"
                                             VerticalContentAlignment="Top" />
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding SelectedEntry.Keys, StringFormat=关键词：{0}}"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
