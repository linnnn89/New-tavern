<UserControl x:Class="TavernDesk.App.Views.ProviderSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:TavernDesk.App.ViewModels">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{StaticResource Settings.Title}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ListBox Style="{StaticResource SettingsNavListBoxStyle}"
                         SelectedValuePath="Tag"
                         SelectedValue="{Binding SelectedSettingsPage, Mode=TwoWay}">
                    <ListBoxItem Content="{StaticResource Settings.Section.AiModels}"
                                 IsEnabled="False"
                                 Style="{StaticResource SettingsNavSectionHeaderStyle}" />
                    <ListBoxItem Content="{StaticResource Settings.Tab.Providers}"
                                 Tag="{x:Static viewModels:SettingsPage.Providers}" />
                    <ListBoxItem Content="{StaticResource Settings.Tab.ModelCatalog}"
                                 Tag="{x:Static viewModels:SettingsPage.ModelCatalog}" />
                    <ListBoxItem Content="{StaticResource Settings.Tab.Assignments}"
                                 Tag="{x:Static viewModels:SettingsPage.Assignments}" />
                    <ListBoxItem Content="{StaticResource Settings.Tab.Prompts}"
                                 Tag="{x:Static viewModels:SettingsPage.Prompts}" />

                    <ListBoxItem Content="{StaticResource Settings.Section.Personal}"
                                 IsEnabled="False"
                                 Style="{StaticResource SettingsNavSectionHeaderStyle}" />
                    <ListBoxItem Content="{StaticResource Settings.Tab.Personas}"
                                 Tag="{x:Static viewModels:SettingsPage.Personas}" />
                    <ListBoxItem Content="{StaticResource Settings.Tab.DefaultBehavior}"
                                 Tag="{x:Static viewModels:SettingsPage.DefaultBehavior}" />

                    <ListBoxItem Content="{StaticResource Settings.Section.System}"
                                 IsEnabled="False"
                                 Style="{StaticResource SettingsNavSectionHeaderStyle}" />
                    <ListBoxItem Content="{StaticResource Settings.Tab.Interface}"
                                 Tag="{x:Static viewModels:SettingsPage.Interface}" />
                    <ListBoxItem Content="{StaticResource Settings.Tab.Data}"
                                 Tag="{x:Static viewModels:SettingsPage.Data}" />
                </ListBox>
            </ScrollViewer>

            <TabControl Grid.Column="2"
                        Style="{StaticResource SettingsContentTabControlStyle}"
                        SelectedValuePath="Tag"
                        SelectedValue="{Binding SelectedSettingsPage, Mode=TwoWay}">
            <TabItem Header="{StaticResource Settings.Tab.Providers}"
                     Tag="{x:Static viewModels:SettingsPage.Providers}">
                <Grid Margin="18,12,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="180" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="16,10,10,8">
                                <TextBlock Text="{StaticResource Settings.Providers.Title}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                                <Button HorizontalAlignment="Right"
                                        Width="54"
                                        Height="30"
                                        Padding="8,3"
                                        Content="{StaticResource Common.Add}"
                                        Click="AddProviderButton_OnClick"
                                        ToolTip="{StaticResource Settings.Providers.AddToolTip}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <ListBox x:Name="ProviderList"
                                     Grid.Row="1"
                                     Margin="8,0"
                                     Padding="0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemsSource="{Binding Profiles}"
                                     SelectionChanged="ProviderList_OnSelectionChanged"
                                     ToolTip="{StaticResource Settings.Providers.ListToolTip}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource ModernListBoxItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,9"
                                                Tag="{Binding DataContext.DeleteProviderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="{StaticResource Common.Delete}"
                                                              Command="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding BaseUrl}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.ColumnSpan="2"
                                           Text="{StaticResource Settings.Providers.Configuration}"
                                           FontSize="24"
                                           FontWeight="SemiBold" />

                                <TextBlock Grid.Row="1" Margin="0,18,0,0" VerticalAlignment="Center" Text="{StaticResource Settings.Providers.Name}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,18,0,0"
                                         Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Margin="0,14,0,0" VerticalAlignment="Center" Text="{StaticResource Settings.Providers.ConnectionMode}" />
                                <Border Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,14,0,0"
                                        MinHeight="36"
                                        Padding="10,6"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding ConnectionKindLabel}"
                                               FontWeight="SemiBold" />
                                </Border>

                                <TextBlock Grid.Row="3"
                                           Margin="0,14,0,0"
                                           VerticalAlignment="Center"
                                           Text="{StaticResource Settings.Providers.Address}"
                                           Visibility="{Binding IsHttpApiSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <StackPanel Grid.Row="3"
                                            Grid.Column="1"
                                            Margin="0,14,0,0"
                                            Visibility="{Binding IsHttpApiSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBox Text="{Binding Editor.BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{StaticResource Settings.Providers.AddressToolTip}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{StaticResource Settings.Providers.AddressHelp}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Row="3"
                                        Grid.ColumnSpan="2"
                                        Margin="0,14,0,0"
                                        Padding="12"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Visibility="{Binding IsGrokCliSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{StaticResource Settings.Providers.GrokAddress}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{StaticResource Settings.Providers.GrokAuthHelp}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Row="4"
                                           Margin="0,14,0,0"
                                           VerticalAlignment="Center"
                                           Text="{StaticResource Settings.Providers.NewApiKey}"
                                           Visibility="{Binding IsHttpApiSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <PasswordBox x:Name="ApiKeyBox"
                                             Grid.Row="4"
                                             Grid.Column="1"
                                             Margin="0,14,0,0"
                                             MinHeight="36"
                                             Padding="10,6"
                                             PasswordChanged="ApiKeyBox_OnPasswordChanged"
                                             ToolTip="{StaticResource Settings.Providers.ApiKeyToolTip}"
                                             Visibility="{Binding IsHttpApiSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <TextBlock Grid.Row="5" Margin="0,14,0,0" VerticalAlignment="Center" Text="{StaticResource Settings.Providers.Timeout}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,14,0,0"
                                         Text="{Binding Editor.RequestTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />

                                <CheckBox Grid.Row="6"
                                          Grid.Column="1"
                                          Margin="0,14,0,0"
                                          Content="{StaticResource Settings.Providers.Enable}"
                                          IsChecked="{Binding Editor.IsEnabled}" />

                                <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,22,0,0">
                                    <Border Padding="12"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding KeyStatus}" />
                                             <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding CredentialHelpText}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="0,12,0,0"
                                               Text="{StaticResource Settings.Providers.SaveOffline}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,12,0,0"
                                               HorizontalAlignment="Right">
                                        <Button Margin="0,0,8,0"
                                                Content="{StaticResource Settings.Providers.ClearKey}"
                                                Command="{Binding ClearKeyCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="{StaticResource Settings.Providers.Save}"
                                                 Command="{Binding SaveCommand}"
                                                 Style="{StaticResource PrimaryButtonStyle}" />
                                    </WrapPanel>
                                    <Button Margin="0,10,0,0"
                                            HorizontalAlignment="Right"
                                            Content="{StaticResource Settings.Providers.OpenModelCatalog}"
                                            Command="{Binding OpenModelCatalogCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{StaticResource Settings.Tab.ModelCatalog}"
                     Tag="{x:Static viewModels:SettingsPage.ModelCatalog}">
                <Grid Margin="18,12,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding CatalogProvider}"
                                      DisplayMemberPath="Name"
                                      ToolTip="{StaticResource Settings.Models.SelectProviderToolTip}" />
                            <TextBox Grid.Column="1"
                                     Margin="12,0"
                                     Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{StaticResource Settings.Models.SearchToolTip}" />
                            <Button Grid.Column="2"
                                    Margin="0,0,10,0"
                                    Content="{Binding CustomModelButtonText}"
                                    Command="{Binding AddCustomModelCommand}"
                                    ToolTip="{StaticResource Settings.Models.AddCustomToolTip}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="3"
                                    Content="{StaticResource Settings.Models.RefreshCatalog}"
                                    Command="{Binding RefreshModelsCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="330" MinWidth="240" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Padding="8">
                            <ListBox ItemsSource="{Binding VisibleCatalogModels}"
                                     SelectedItem="{Binding SelectedCatalogModel}"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="{Binding ModelId}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource Settings.Models.LocalLimits}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding SelectedCatalogModel.ModelId, TargetNullValue={StaticResource Settings.Models.SelectModel}}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,16,0,0" Text="{StaticResource Settings.Models.ContextLimit}" />
                                <TextBox Margin="0,5,0,0"
                                         Text="{Binding ModelContextLimit, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,12,0,0" Text="{StaticResource Settings.Models.OutputLimit}" />
                                <TextBox Margin="0,5,0,0"
                                         Text="{Binding ModelMaxOutputTokens, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,12,0,0"
                                           Text="{StaticResource Settings.Models.RefreshPreservesLimits}"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <Button Margin="0,18,0,0"
                                        Content="{StaticResource Settings.Models.SaveLimits}"
                                        Command="{Binding SaveModelLimitsCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{StaticResource Settings.Tab.Assignments}"
                     Tag="{x:Static viewModels:SettingsPage.Assignments}">
                <Grid Margin="18,12,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding FunctionOptions}"
                                      SelectedItem="{Binding SelectedFunction}"
                                      DisplayMemberPath="Label"
                                      ToolTip="{StaticResource Settings.Assignments.SelectFunctionToolTip}" />
                            <ComboBox Grid.Column="1"
                                      Margin="12,0,0,0"
                                      ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding AssignmentProvider}"
                                      DisplayMemberPath="Name"
                                      ToolTip="{StaticResource Settings.Assignments.SelectProviderToolTip}" />
                            <TextBox Grid.Column="2"
                                     Margin="12,0,0,0"
                                     Text="{Binding AssignmentSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{StaticResource Settings.Assignments.SearchModelToolTip}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1"
                            Margin="0,10,0,0"
                            Padding="12,9"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding IsSelectedFunctionUnassigned, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{StaticResource Settings.Assignments.SelectedFunctionUnassigned}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" MinWidth="260" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Padding="8">
                            <ListBox ItemsSource="{Binding VisibleAssignmentModels}"
                                     SelectedItem="{Binding SelectedAssignmentModel}"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="{Binding ModelId}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1.05*" />
                                    <RowDefinition Height="1.35*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="{StaticResource Settings.Assignments.Overview}" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Margin="0,2,0,6"
                                               Text="{StaticResource Settings.Assignments.Saved}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1"
                                              Margin="0,0,0,10"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding AssignmentOverview}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander Margin="0,0,0,4"
                                                          IsEnabled="{Binding IsReasoningAvailable}"
                                                          ToolTip="{StaticResource Settings.Assignments.DeepSeekToolTip}">
                                                    <Expander.Header>
                                                        <Border Padding="7,5"
                                                                Background="{DynamicResource SurfaceAltBrush}"
                                                                CornerRadius="8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="126" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding TargetText}"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding TargetText}" />
                                                            </Grid>
                                                        </Border>
                                                    </Expander.Header>
                                                    <Grid Margin="24,7,5,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="36" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{StaticResource Settings.Assignments.DeepSeekReasoning}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{StaticResource Settings.Assignments.ReasoningParameter}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                                        </StackPanel>
                                                        <ToggleButton Grid.Column="1"
                                                                      IsChecked="{Binding IsReasoningEnabled, Mode=OneWay}"
                                                                      Command="{Binding DataContext.ToggleReasoningCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}"
                                                                      Style="{StaticResource ReasoningToggleStyle}" />
                                                        <TextBlock Grid.Column="2"
                                                                   Margin="7,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding ReasoningStateText}"
                                                                   FontWeight="SemiBold" />
                                                    </Grid>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ScrollViewer Grid.Row="2"
                                              Margin="0,0,0,0"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEmbeddingFunctionSelected}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{StaticResource Settings.Assignments.RequestParameters}"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="{Binding SelectedAssignmentModel.ModelId, TargetNullValue={StaticResource Settings.Assignments.SelectModelFirst}}"
                                                   TextWrapping="Wrap" />

                                        <Grid Margin="0,10,0,0" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="126" />
                                                <ColumnDefinition Width="180" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock VerticalAlignment="Center" Text="{StaticResource Settings.Models.ContextLimit}" />
                                            <TextBox Grid.Column="1"
                                                     MinHeight="32"
                                                     Text="{Binding AssignmentContextLimit, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Row="1"
                                                       Margin="0,8,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="{StaticResource Settings.Models.OutputLimit}" />
                                            <TextBox Grid.Row="1"
                                                     Grid.Column="1"
                                                     Margin="0,8,0,0"
                                                     MinHeight="32"
                                                     Text="{Binding AssignmentMaxOutputTokens, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Row="2"
                                                       Margin="0,8,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="{StaticResource Settings.Assignments.Temperature}" />
                                            <TextBox Grid.Row="2"
                                                     Grid.Column="1"
                                                     Margin="0,8,0,0"
                                                     MinHeight="32"
                                                     Text="{Binding AssignmentTemperature, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Row="3"
                                                       Margin="0,8,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="{StaticResource Settings.Assignments.TopP}" />
                                            <TextBox Grid.Row="3"
                                                     Grid.Column="1"
                                                     Margin="0,8,0,0"
                                                     MinHeight="32"
                                                     Text="{Binding AssignmentTopP, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEmbeddingFunctionSelected}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{StaticResource Settings.Assignments.EmbeddingModel}"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="{Binding SelectedAssignmentModel.ModelId, TargetNullValue={StaticResource Settings.Assignments.SelectModelFirst}}"
                                                   TextWrapping="Wrap" />
                                        <Border Margin="0,12,0,0"
                                                Padding="12"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                CornerRadius="10">
                                            <TextBlock Text="{StaticResource Settings.Assignments.EmbeddingHelp}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>

                                    <Button Width="180"
                                            Margin="0,14,0,0"
                                            HorizontalAlignment="Right"
                                            Content="{StaticResource Settings.Assignments.Save}"
                                            Command="{Binding SaveAssignmentCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{StaticResource Settings.Tab.DefaultBehavior}"
                     Tag="{x:Static viewModels:SettingsPage.DefaultBehavior}">
                <ScrollViewer Margin="18,12,16,16"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{StaticResource Settings.Tab.DefaultBehavior}"
                                   Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Margin="0,2,0,14"
                                   Text="{StaticResource Settings.DefaultBehavior.Description}"
                                   Foreground="{DynamicResource MutedTextBrush}" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource Settings.DefaultBehavior.Chat}"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <CheckBox Margin="0,8,0,0"
                                          Content="{StaticResource Settings.DefaultBehavior.AutoScroll}"
                                          IsChecked="{Binding ChatAutoScrollEnabled}" />
                                <TextBlock Margin="24,5,0,0"
                                           Text="{StaticResource Settings.DefaultBehavior.AutoScrollHelp}"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Content="{StaticResource Settings.RestoreDefaults}"
                                    Command="{Binding RestoreInterfaceDefaultsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="{StaticResource Settings.DefaultBehavior.Save}"
                                    Command="{Binding SaveInterfaceSettingsCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding InterfaceSettingsStatus}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{StaticResource Settings.Tab.Personas}"
                     Tag="{x:Static viewModels:SettingsPage.Personas}">
                <Grid Margin="18,12,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="180" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="7,5,7,10">
                                <TextBlock Text="{StaticResource Settings.Personas.Saved}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                                <Button DockPanel.Dock="Right"
                                        Width="54"
                                        Padding="6,3"
                                        Content="{StaticResource Settings.Personas.New}"
                                        Command="{Binding Personas.NewCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </DockPanel>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Personas.Profiles}"
                                     SelectedItem="{Binding Personas.SelectedProfile, Mode=TwoWay}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource ModernListBoxItemStyle}">
                                        <Setter Property="Padding" Value="8,7" />
                                        <Setter Property="Margin" Value="0,1,8,1" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="{Binding Description}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2"
                                    Margin="7,10,7,2"
                                    Content="{StaticResource Settings.Personas.DeleteCurrent}"
                                    Command="{Binding Personas.DeleteCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <ScrollViewer Margin="18,12,12,12"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{StaticResource Settings.Personas.Title}"
                                           Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Margin="0,2,0,14"
                                           Text="{StaticResource Settings.Personas.Description}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{StaticResource Settings.Personas.Name}" />
                                <TextBox Margin="0,5,0,0"
                                         Text="{Binding Personas.EditorName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,14,0,0" Text="{StaticResource Settings.Personas.UserSettings}" />
                                <TextBox Margin="0,5,0,0"
                                         MinHeight="180"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         Text="{Binding Personas.EditorDescription, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Margin="0,14,0,0"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <Button Margin="0,0,8,0"
                                            Content="{StaticResource Settings.Personas.CancelChanges}"
                                            Command="{Binding Personas.CancelCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Content="{StaticResource Settings.Personas.Save}"
                                            Command="{Binding Personas.SaveCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                                <TextBlock Margin="0,10,0,0"
                                           Text="{Binding Personas.Status}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{StaticResource Settings.Tab.Prompts}"
                     Tag="{x:Static viewModels:SettingsPage.Prompts}">
                <Grid Margin="18,12,16,16">
                    <Grid.Resources>
                        <CollectionViewSource x:Key="PromptNavigationView"
                                              Source="{Binding Prompts.NavigationItems}">
                            <CollectionViewSource.GroupDescriptions>
                                <PropertyGroupDescription PropertyName="CategoryName" />
                            </CollectionViewSource.GroupDescriptions>
                        </CollectionViewSource>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="180" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="7,5,7,10"
                                       Text="{StaticResource Settings.Prompts.CategoryAndFunction}"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Source={StaticResource PromptNavigationView}}"
                                     SelectedValuePath="Prompt"
                                     SelectedValue="{Binding Prompts.SelectedPrompt, Mode=TwoWay}"
                                     SelectionMode="Single"
                                     IsSynchronizedWithCurrentItem="False"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="7,8,7,5"
                                                           Text="{Binding Name}"
                                                           FontWeight="SemiBold" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource ModernListBoxItemStyle}">
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="Margin" Value="0,1,10,1" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="SelectionBorder"
                                                            Padding="{TemplateBinding Padding}"
                                                            CornerRadius="9"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="1">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SelectionBorder"
                                                                    Property="Background"
                                                                    Value="{DynamicResource ControlHoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="SelectionBorder"
                                                                    Property="Background"
                                                                    Value="{DynamicResource AccentSoftBrush}" />
                                                            <Setter TargetName="SelectionBorder"
                                                                    Property="BorderBrush"
                                                                    Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Prompt.Label}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Prompts.SelectedPrompt.Label}"
                                       Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,6,0,12"
                                       Text="{Binding Prompts.SelectedPrompt.Description}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <Border Grid.Row="2"
                                    Margin="0,0,0,12"
                                    Padding="10,8"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="{StaticResource Settings.Prompts.Scope}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding Prompts.SelectedPrompt.LocalOverrideHint}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                            <TextBox Grid.Row="3"
                                     MinHeight="280"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Prompts.SelectedPrompt.Text, UpdateSourceTrigger=PropertyChanged}" />
                            <WrapPanel Grid.Row="4"
                                       Margin="0,12,0,0"
                                       HorizontalAlignment="Right">
                                <Button Margin="0,0,8,8"
                                        Content="{StaticResource Settings.Prompts.RestoreDefault}"
                                        Command="{Binding Prompts.RestoreDefaultCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="0,0,8,8"
                                        Content="{StaticResource Settings.Prompts.SaveAs}"
                                        Command="{Binding Prompts.ExportCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="0,0,0,8"
                                        Content="{StaticResource Settings.Prompts.SaveGlobal}"
                                        Command="{Binding Prompts.SaveCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </WrapPanel>
                            <TextBlock Grid.Row="5"
                                       Margin="0,12,0,0"
                                       Text="{Binding Prompts.Status}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{StaticResource Settings.Tab.Interface}"
                     Tag="{x:Static viewModels:SettingsPage.Interface}">
                <ScrollViewer Margin="18,12,16,16"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                            <TextBlock Text="{StaticResource Settings.Tab.Interface}"
                                   Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Margin="0,2,0,14"
                                   Text="{StaticResource Settings.Interface.Description}"
                                   Foreground="{DynamicResource MutedTextBrush}" />

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="{StaticResource Settings.Interface.Language}"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{StaticResource Settings.Interface.LanguageHelp}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{StaticResource Settings.Interface.LanguageRestartHelp}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Width="190"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding LanguageOptions}"
                                          DisplayMemberPath="NativeName"
                                          SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="{StaticResource Settings.Interface.Scale}"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="{StaticResource Settings.Interface.ScaleHelp}"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="{StaticResource Settings.Interface.ScalePreviewHelp}"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Width="190"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding AvailableInterfaceScaleOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedInterfaceScaleOption, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock Margin="0,12,0,0"
                                           Text="{Binding InterfaceScaleRecommendationText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource Settings.Interface.GlobalFont}"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,7,0,4"
                                           Text="{StaticResource Settings.Interface.Font}" />
                                <ComboBox ItemsSource="{Binding AvailableInterfaceFontFamilies}"
                                          SelectedItem="{Binding InterfaceFontFamily}"
                                          IsTextSearchEnabled="True" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="54" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="10"
                                            Maximum="32"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding InterfaceFontSize}" />
                                    <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Text="{Binding InterfaceFontSize, StringFormat={}{0:0}}" />
                                </Grid>
                                <TextBlock Margin="0,3,0,0"
                                           Text="{StaticResource Settings.Interface.FontSizeHelp}"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <Border Margin="0,12,0,0"
                                        Padding="12"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        CornerRadius="10">
                                    <TextBlock Text="{StaticResource Settings.Interface.FontPreview}"
                                               FontFamily="{Binding InterfaceFontFamily}"
                                               FontSize="{Binding InterfaceFontSize}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                 Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="{StaticResource Settings.Interface.Theme}"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{StaticResource Settings.Interface.ThemeHelp}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{StaticResource Settings.Interface.ThemePreviewHelp}"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Width="190"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding AvailableInterfaceThemeOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedInterfaceThemeOption, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <StackPanel Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Content="{StaticResource Settings.RestoreDefaults}"
                                    Command="{Binding RestoreInterfaceDefaultsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="{StaticResource Settings.Interface.Save}"
                                    Command="{Binding SaveInterfaceSettingsCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding InterfaceSettingsStatus}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{StaticResource Settings.Tab.Data}"
                     Tag="{x:Static viewModels:SettingsPage.Data}">
                <ScrollViewer Margin="18,12,16,16"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{StaticResource Settings.Data.Title}"
                                   Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Margin="0,2,0,14"
                                   Text="{StaticResource Settings.Data.Description}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource Settings.Data.CurrentRoot}"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="{StaticResource Settings.Data.CurrentRootHelp}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DataRoot, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsDataRootExternallyOverridden}" />
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Content="{StaticResource Settings.Data.Browse}"
                                            Command="{Binding PickDataRootCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>

                                <TextBlock Margin="0,9,0,0"
                                           Text="{StaticResource Settings.Data.ConfigurationFile}"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding DataRootConfigurationPath}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Margin="0,9,0,0"
                                           Text="{Binding DataRootStatus}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Content="{StaticResource Settings.Data.SaveAndSwitch}"
                                    Command="{Binding ChangeDataRootCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>

                        <Border Margin="0,18,0,0"
                                Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource Settings.Diagnostics.Title}"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="{StaticResource Settings.Diagnostics.Description}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <TextBlock Margin="0,16,0,0"
                                           Text="{StaticResource Settings.Diagnostics.ErrorLogTitle}"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="{StaticResource Settings.Diagnostics.ErrorLogDescription}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Margin="0,9,0,0"
                                           Text="{StaticResource Settings.Diagnostics.ErrorLogPath}"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBox Margin="0,4,0,0"
                                         Text="{Binding ErrorLogDirectory, Mode=OneWay}"
                                         IsReadOnly="True" />

                                <Border Margin="0,18,0,0"
                                        Padding="0,18,0,0"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="{StaticResource Settings.Diagnostics.TestModeTitle}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Margin="0,5,0,0"
                                                           Text="{StaticResource Settings.Diagnostics.TestModeDescription}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsApiTestModeEnabled, Mode=OneWay}"
                                                          Command="{Binding SetApiTestModeCommand}"
                                                          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                                          ToolTip="{StaticResource Settings.Diagnostics.TestModeToggle}"
                                                          AutomationProperties.Name="{StaticResource Settings.Diagnostics.TestModeToggle}"
                                                          Style="{StaticResource ReasoningToggleStyle}" />
                                        </Grid>

                                        <TextBlock Margin="0,12,0,0"
                                                   Text="{StaticResource Settings.Diagnostics.PrivacyWarning}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                        <TextBlock Margin="0,12,0,0"
                                                   Text="{StaticResource Settings.Diagnostics.OutputPath}"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding ApiTestOutputDirectory, Mode=OneWay}"
                                                 IsReadOnly="True" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Text="{Binding ApiTestOutputSummary}"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <StackPanel Margin="0,12,0,0"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal">
                                            <Button Margin="0,0,8,0"
                                                    Content="{StaticResource Settings.Diagnostics.OpenOutput}"
                                                    Command="{Binding OpenApiTestOutputCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button Content="{StaticResource Settings.Diagnostics.ClearOutput}"
                                                    Command="{Binding ClearApiTestOutputCommand}"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,10,0,0"
                                                   Text="{Binding DiagnosticsStatus}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
