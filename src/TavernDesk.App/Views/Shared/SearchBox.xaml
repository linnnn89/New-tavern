<UserControl x:Class="TavernDesk.App.Views.Shared.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False">
    <Border MinHeight="40" Padding="10,0" CornerRadius="10"
            Background="{DynamicResource SurfaceBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Root}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       Margin="0,0,8,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False" />
            <TextBox x:Name="SearchInput" Grid.Column="1"
                     Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{Binding ToolTip, ElementName=Root}"
                     VerticalContentAlignment="Center" FontSize="{DynamicResource FontSizeBodySmall}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock Grid.Column="1" Text="{Binding Placeholder, ElementName=Root}"
                       VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodySmall}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Grid.Column="2" Content="×" MinWidth="28" Padding="4,0" Margin="4,0,-4,0"
                    Click="Clear_OnClick" ToolTip="{StaticResource Common.Clear}"
                    AutomationProperties.Name="{StaticResource Common.Clear}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MessageToolButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
