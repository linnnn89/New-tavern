<UserControl x:Class="TavernDesk.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="34,28,34,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,26,0,28">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="角色" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding CharacterCount}" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="本地角色书架" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="会话" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding ConversationCount}" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="全部保存在本地" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="接入商" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding ProviderCount}" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="保存配置不会联网" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="最近会话" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock HorizontalAlignment="Right"
                           Text="仪表盘仅展示本地状态"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>

            <ItemsControl Grid.Row="3" ItemsSource="{Binding RecentConversations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,0,10"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                Cursor="Hand"
                                PreviewMouseLeftButtonDown="RecentConversation_OnPreviewMouseLeftButtonDown"
                                Click="RecentConversation_OnClick"
                                MouseLeave="RecentConversation_OnMouseLeave">
                            <Border Style="{StaticResource CardStyle}" Padding="16,13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LastMessagePreview}"
                                                   MaxHeight="42"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="20,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
