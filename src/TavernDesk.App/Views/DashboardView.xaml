<UserControl x:Class="TavernDesk.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="StatTileTemplate">
            <Button Margin="{DynamicResource TileGap}"
                    AutomationProperties.Name="{Binding ActionLabel}"
                    ToolTip="{Binding ActionLabel}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AppicaDashboardStatButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Destination}" Value="Characters">
                                <Setter Property="Command" Value="{Binding DataContext.ShowCharactersCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Destination}" Value="Conversations">
                                <Setter Property="Command" Value="{Binding DataContext.ShowChatCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Destination}" Value="Providers">
                                <Setter Property="Command" Value="{Binding DataContext.ShowSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Count}" Style="{StaticResource AppicaDashboardStatMetricStyle}" />
                        <TextBlock Text="{Binding Label}" Margin="{DynamicResource LabelGap}"
                                   Style="{StaticResource AppicaDashboardStatLabelStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="&#xE72A;" VerticalAlignment="Center"
                               FontFamily="{StaticResource AppicaShellIconFont}"
                               Foreground="{DynamicResource TextSecondary}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource PageInset}">
            <Border Style="{StaticResource AppicaDashboardHeroStyle}" Margin="{DynamicResource SectionGap}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource AppicaDashboardHeroTitleStyle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource AppicaDashboardHeroSubtitleStyle}" />
                    <Button HorizontalAlignment="Left" Margin="{DynamicResource LabelGap}"
                            Command="{Binding ResumeLatestCommand}" Content="{StaticResource Dashboard.ResumeRecent}"
                            MinHeight="{DynamicResource ControlHeightMd}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecentConversation}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Statistics}" ItemTemplate="{StaticResource StatTileTemplate}"
                          Margin="{DynamicResource SectionGap}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border Padding="{DynamicResource InsetLg}" Margin="{DynamicResource SectionGap}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppicaDashboardRecentPanelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRecentConversation}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{StaticResource Dashboard.GetStarted}" FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{StaticResource Dashboard.GetStartedHelp}" Margin="{DynamicResource ContentGap}"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                    <WrapPanel>
                        <Button Content="{StaticResource Dashboard.ImportCharacter}" Margin="{DynamicResource TileGap}"
                                Command="{Binding DataContext.ImportCharacterFromDashboardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="{StaticResource Dashboard.ConfigureModels}" Margin="{DynamicResource TileGap}"
                                Command="{Binding DataContext.ShowSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Margin="{DynamicResource SectionGap}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppicaDashboardRecentPanelStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRecentConversation}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Margin="{DynamicResource InsetMd}">
                        <TextBlock Text="{StaticResource Dashboard.RecentConversations}"
                                   FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{StaticResource Dashboard.ResumeConversation}" Margin="{DynamicResource LabelGap}"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding RecentConversations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AppicaDashboardRecentRowButtonStyle}"
                                        AutomationProperties.Name="{Binding Title}"
                                        PreviewMouseLeftButtonDown="RecentConversation_OnPreviewMouseLeftButtonDown"
                                        Click="RecentConversation_OnClick" MouseLeave="RecentConversation_OnMouseLeave">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LastMessagePreview}" Margin="{DynamicResource LabelGap}"
                                                       Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                                                   Margin="{DynamicResource InsetSm}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <StackPanel Visibility="{Binding ShowCharacterShortcuts, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{StaticResource Dashboard.StartChat}" FontWeight="SemiBold"
                           Margin="{DynamicResource ContentGap}" Foreground="{DynamicResource TextPrimary}" />
                <ItemsControl ItemsSource="{Binding DataContext.Characters.Characters, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource RecentCharactersConverter}}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Margin="{DynamicResource TileGap}"
                                    AutomationProperties.Name="{Binding Name}" ToolTip="{StaticResource Dashboard.StartChat}"
                                    Command="{Binding DataContext.Characters.StartChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
