<UserControl x:Class="TavernDesk.App.Views.Chat.ChatConversationList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:TavernDesk.App.Views.Shared">
    <Border
            Style="{StaticResource AppicaChatSidebarStyle}">
        <Grid Margin="16,16,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
                <Grid Margin="2,0,0,14">
                    <TextBlock Text="{StaticResource Chat.Title}" Style="{StaticResource AppicaPaneTitleStyle}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="{StaticResource Chat.NewGroup}"
                                Command="{Binding Group.CreateGroupCommand}"
                                Style="{StaticResource AppicaHeaderActionButtonStyle}" />
                    </StackPanel>
                </Grid>
                <shared:SearchBox Text="{Binding ConversationSearchText, UpdateSourceTrigger=PropertyChanged}"
                         Placeholder="{StaticResource Chat.SearchPlaceholder}"
                         ToolTip="{StaticResource Chat.SearchToolTip}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ConversationGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Button Command="{Binding ToggleCommand}"
                                        ToolTip="{StaticResource Chat.ToggleConversations}"
                                        Style="{StaticResource AppicaConversationGroupButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44"
                                                Height="44"
                                                CornerRadius="22"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                ClipToBounds="True">
                                             <Grid>
                                                <TextBlock x:Name="ConversationAvatarGlyph" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource AppicaShellIconFont}"
                                                           FontSize="18"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Text="&#xE77B;" />
                                                 <Image Source="{Binding AvatarPath, Converter={StaticResource AvatarImageConverter}, ConverterParameter=48}"
                                                        Stretch="UniformToFill">
                                                    <Image.Clip>
                                                        <EllipseGeometry Center="22,22"
                                                                         RadiusX="22"
                                                                         RadiusY="22" />
                                                    </Image.Clip>
                                                </Image>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="{DynamicResource InterfaceFontSize}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LatestPreview}"
                                                       Margin="0,2,0,0"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UpdatedText}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock x:Name="ExpandGlyph"
                                                       Margin="0,3,0,0"
                                                       FontSize="18"
                                                       Text="⌄"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Border ClipToBounds="True"
                                        MaxHeight="0"
                                        Opacity="0"
                                        Margin="10,0,0,5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="MaxHeight" Value="0" />
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                                 To="1600"
                                                                                 Duration="0:0:0.22">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 To="1"
                                                                                 Duration="0:0:0.18" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                                 To="0"
                                                                                 Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseIn" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 To="0"
                                                                                 Duration="0:0:0.14" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ItemsControl ItemsSource="{Binding VisibleConversations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource AppicaConversationItemStyle}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="{StaticResource Chat.OpenNewWindow}"
                                                                      Command="{Binding OpenInNewWindowCommand}" />
                                                            <Separator />
                                                            <MenuItem Header="{StaticResource Chat.DeleteConversation}"
                                                                      Command="{Binding DeleteConversationCommand}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="{DynamicResource FontSizeBodySmall}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding PreviewText}"
                                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding GenerationStatusText}"
                                                                           Margin="7,0,0,0"
                                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="8,0,0,0"
                                                                   Text="{Binding UpdatedText}"
                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter TargetName="ConversationAvatarGlyph" Property="Text" Value="&#xE902;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter TargetName="ExpandGlyph" Property="Text" Value="⌃" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
