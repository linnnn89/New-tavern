<UserControl x:Class="TavernDesk.App.Views.Chat.ChatContextPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ContextDetailRow" TargetType="Border">
            <Setter Property="Padding" Value="0,12" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style x:Key="BudgetDetailExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" Padding="0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" /></Border></ControlTemplate></ToggleButton.Template>
                                <DockPanel><TextBlock x:Name="Chevron" Text="›" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" /><ContentPresenter Content="{TemplateBinding Header}" /></DockPanel>
                            </ToggleButton>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" />
                            <ContentPresenter x:Name="Detail" Content="{TemplateBinding Content}" Visibility="Collapsed" Margin="0,5,0,8" />
                        </StackPanel>
                        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Detail" Property="Visibility" Value="Visible" /><Setter TargetName="Chevron" Property="Text" Value="⌄" /></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource AppicaInspectorBodyScrollStyle}">
        <StackPanel>
            <Border Style="{StaticResource AppicaInspectorCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{StaticResource Chat.TokenUsage}"
                                   Style="{StaticResource AppicaInspectorCardTitleStyle}" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding EstimatedTokenHeadline}" ToolTip="{Binding EstimatedTokenText}"
                                   FontSize="{DynamicResource FontSizeBodyLarge}"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <ProgressBar Margin="0,14,0,0"
                                 Value="{Binding EstimatedTokenUsagePercent, Mode=OneWay}" ToolTip="{Binding EstimatedTokenBreakdown}"
                                 Style="{StaticResource AppicaTokenProgressStyle}" />
                    <TextBlock Text="{Binding EstimatedInputTokens, StringFormat={StaticResource Chat.Budget.InputCompositionFormat}}" ToolTip="{StaticResource Chat.Budget.Help}" TextWrapping="Wrap" Margin="0,10,0,6"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Grid x:Name="BudgetBar" Height="16" AutomationProperties.AutomationId="ContextBudgetBar" />
                    <StackPanel x:Name="BudgetDetails" Margin="0,8,0,0" />

                    <TextBlock Margin="0,5,0,0"
                               Text="{Binding LastGenerationUsageText}"
                               TextWrapping="Wrap"
                               Style="{StaticResource AppicaComposerMetaTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppicaInspectorCardStyle}">
                <Expander Header="{StaticResource Chat.RequestStructure}" Style="{StaticResource BudgetDetailExpander}"><StackPanel>
                    <TextBlock Margin="0,6,0,12"
                               Text="{StaticResource Chat.RequestStructureHelp}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Expander Header="{StaticResource Chat.SentSections}" IsExpanded="False" Style="{StaticResource BudgetDetailExpander}">
                        <ItemsControl Margin="0,9,0,0"
                                      ItemsSource="{Binding ContextSegments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Style="{StaticResource ContextDetailRow}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Margin="8,0,0,0"
                                                           Text="{Binding ProviderRole}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </DockPanel>
                                            <TextBlock Margin="0,4,0,0"
                                                       MaxHeight="68"
                                                       Text="{Binding Content}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander Margin="0,8,0,0" Header="{StaticResource Chat.ApiRequestStructure}" Style="{StaticResource BudgetDetailExpander}">
                        <TextBox MinHeight="150"
                                 MaxHeight="240"
                                 Margin="0,9,0,0"
                                 Text="{Binding ApiRequestPreview, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Expander>
                </StackPanel></Expander>
            </Border>

            <Border Style="{StaticResource AppicaInspectorCardStyle}">
                <Expander Header="{StaticResource Chat.Retrieval.Current}" Style="{StaticResource BudgetDetailExpander}"><StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{StaticResource Chat.Retrieval.Current}"
                                   Style="{StaticResource AppicaInspectorCardTitleStyle}" />
                        <CheckBox Grid.Column="1"
                                  Margin="12,0,0,0"
                                  Content="{StaticResource Common.Enable}"
                                  IsChecked="{Binding Retrieval.IsEnabled}"
                                  VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding Retrieval.Status}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <DockPanel Margin="0,9,0,0">
                        <TextBlock Text="{StaticResource Chat.Retrieval.ActualMatches}"
                                   FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding Retrieval.ExcludedCount, StringFormat={StaticResource Chat.Retrieval.ExcludedCountFormat}}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </DockPanel>
                    <Expander Margin="0,10,0,0"
                              Header="{StaticResource Chat.Retrieval.SettingsAndResults}" Style="{StaticResource BudgetDetailExpander}">
                        <StackPanel Margin="0,9,0,0">
                            <TextBlock Text="{StaticResource Chat.Retrieval.Scope}" />
                            <ComboBox Margin="0,5,0,0"
                                      ItemsSource="{Binding Retrieval.ScopeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Retrieval.Scope}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{StaticResource Chat.Retrieval.RecentMessages}" />
                                    <TextBox Margin="0,5,0,0"
                                             Text="{Binding Retrieval.RecentMessageCount, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{StaticResource Chat.Retrieval.MaximumResults}" />
                                    <TextBox Margin="0,5,0,0"
                                             Text="{Binding Retrieval.MaximumResults, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Margin="0,10,0,0" Text="{StaticResource Chat.Retrieval.TokenBudget}" />
                            <TextBox Margin="0,5,0,0"
                                     Text="{Binding Retrieval.TokenBudget, UpdateSourceTrigger=PropertyChanged}" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Margin="0,0,8,8"
                                        Content="{StaticResource Chat.Retrieval.SaveSettings}"
                                        Command="{Binding Retrieval.SaveSettingsCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Margin="0,0,0,8"
                                        Content="{StaticResource Chat.Retrieval.ClearExclusions}"
                                        Command="{Binding Retrieval.ClearExclusionsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </WrapPanel>
                            <ItemsControl Margin="0,5,0,0"
                                          ItemsSource="{Binding Retrieval.Matches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Style="{StaticResource ContextDetailRow}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button DockPanel.Dock="Right"
                                                            Margin="8,0,0,0"
                                                            Content="{StaticResource Chat.Retrieval.Exclude}"
                                                            Command="{Binding DataContext.Retrieval.ExcludeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                </DockPanel>
                                                <TextBlock Margin="0,5,0,0"
                                                           MaxHeight="84"
                                                           Text="{Binding Content}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Expander Margin="0,7,0,0" Header="{StaticResource Chat.Retrieval.Diagnostics}" Style="{StaticResource BudgetDetailExpander}">
                                <ItemsControl Margin="0,7,0,0"
                                              ItemsSource="{Binding Retrieval.Diagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,5"
                                                       Text="{Binding}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Expander>
                </StackPanel></Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
