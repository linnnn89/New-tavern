<UserControl x:Class="TavernDesk.App.Views.Chat.ChatSessionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource AppicaInspectorBodyScrollStyle}">
        <StackPanel>
            <Border Padding="10"
                    Background="{DynamicResource SurfaceAltBrush}"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="{StaticResource Chat.Session.Current}" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding SelectedConversation.Title, TargetNullValue={StaticResource Chat.Session.NoneSelected}}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding Status}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <StackPanel Margin="{DynamicResource LabelGap}">
                        <TextBlock x:Name="DisplayModeLabel" Text="{StaticResource Chat.Session.DisplayMode}" />
                        <ComboBox Margin="{DynamicResource LabelGap}"
                                  AutomationProperties.AutomationId="ChatDisplayMode"
                                  AutomationProperties.LabeledBy="{Binding ElementName=DisplayModeLabel}"
                                  ToolTip="{StaticResource Chat.LayoutToolTip}"
                                  ItemsSource="{Binding DisplayModes}"
                                  ItemTemplate="{StaticResource ChatCompactOptionTemplate}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding DisplayMode}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Margin="0,12,0,0"
                        IsEnabled="{Binding Group.IsGroupConversation}"
                        Visibility="{Binding Group.IsGroupConversation, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{StaticResource Chat.Group.RelayAndMemory}"
                       Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="{Binding Group.Status}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,5,0,0"
                       Text="{Binding Group.RelayStateText}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />

            <TextBlock Margin="0,14,0,0" Text="{StaticResource Chat.Group.RelayMode}" />
            <TextBlock Margin="0,5,0,0"
                       Text="{StaticResource GroupChat.Relay.FixedOrder}"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <CheckBox Margin="0,10,0,0"
                      Content="{StaticResource Chat.Group.AutoRelay}"
                      IsChecked="{Binding Group.AutoContinueEnabled}" />
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="{StaticResource Chat.Group.MaximumRelay}" />
                <TextBox Width="72"
                         Margin="8,0,0,0"
                         Text="{Binding Group.MaximumAutomaticTurns, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Margin="0,14,0,5" Text="{StaticResource Chat.Group.EnabledMembers}" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Group.Members}"
                          IsEnabled="{Binding CanEditGroupMembers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Margin="2,3"
                                  Content="{Binding Character.Name}"
                                  IsChecked="{Binding IsEnabled}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,12,0,5"
                       Text="{StaticResource Chat.Group.ManualSpeaker}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />
            <WrapPanel Margin="0,10,0,0">
                <Button Margin="0,0,7,7"
                        Content="{Binding Group.PauseButtonText}"
                        Command="{Binding Group.PauseOrResumeCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Margin="7,0,0,7"
                        Content="{StaticResource Chat.Group.EditGlobalPrompt}"
                        Command="{Binding OpenGlobalPromptCommand}"
                        CommandParameter="GroupRelaySystem"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </WrapPanel>

            <Border Margin="0,12,0,0"
                    Padding="12"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="{StaticResource Chat.Group.RelayPrompt}"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,6"
                               Text="{StaticResource Chat.Group.RelayPromptHelp}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Expander Header="{StaticResource Chat.Group.ExtraSystemPrompt}">
                        <TextBox MinHeight="170"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Text="{Binding Group.GroupSystemPrompt, UpdateSourceTrigger=PropertyChanged}" />
                    </Expander>
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="10"
                    Background="{DynamicResource SurfaceAltBrush}"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="{StaticResource Chat.Group.MemoryReliability}"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,8"
                               Text="{StaticResource Chat.Group.MemoryReliabilityHelp}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <CheckBox Content="{StaticResource Chat.Group.MemberMemoryEnabled}"
                              IsChecked="{Binding Group.MemberMemoryEnabled}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{StaticResource Chat.Group.MemberMemoryEnabledHelp}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{StaticResource Chat.Group.MemoryTokenThreshold}" />
                         <TextBox Width="88"
                                  Margin="8,0,0,0"
                                  AutomationProperties.Name="{StaticResource Chat.Group.MemoryTokenThreshold}"
                                  Text="{Binding Group.MemoryPendingTokenThreshold, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                     <TextBlock Margin="0,8,0,0"
                                Text="{Binding Group.MemoryStatus}"
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{DynamicResource MutedTextBrush}"
                                TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Margin="0,0,7,0"
                                Content="{StaticResource Chat.Group.SaveSettings}"
                                Command="{Binding Group.SaveSettingsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="{StaticResource Chat.Group.UpdateMemoryNow}"
                                Command="{Binding Group.UpdateMemoryCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="10"
                    Background="{DynamicResource SurfaceAltBrush}"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="{StaticResource Chat.Group.MergeMemory}"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,8"
                               Text="{StaticResource Chat.Group.MergeMemoryHelp}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding Group.Members}"
                              DisplayMemberPath="Character.Name"
                              SelectedItem="{Binding Group.SelectedMergeMember}" />
                    <Button Margin="0,8,0,0"
                            Content="{StaticResource Chat.Group.GenerateMergeDraft}"
                            Command="{Binding Group.MergeMemoryCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Margin="0,8,0,0"
                            Content="{StaticResource Chat.Group.EditMergePrompt}"
                            Command="{Binding OpenGlobalPromptCommand}"
                            CommandParameter="GroupMemoryMergeSystem"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
