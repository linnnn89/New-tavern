<UserControl x:Class="TavernDesk.App.Views.Chat.ChatMemoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:TavernDesk.App.Presentation">
    <TabControl Margin="18">
        <TabItem Header="{StaticResource Chat.Memory.BodyTab}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Memory.OwnerLabel}"
                           Style="{StaticResource SectionTitleStyle}" />
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Memory.Status}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0"
                               Text="{Binding Memory.CheckpointText}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBox Grid.Row="2"
                         Text="{Binding Memory.Body, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" />
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Text="{StaticResource Chat.Memory.TargetTokens}" />
                        <TextBox Width="86"
                                 Margin="8,0,0,0"
                                 Text="{Binding Memory.TargetTokens, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{StaticResource Chat.Memory.SaveBody}"
                            Command="{Binding Memory.SaveBodyCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="{StaticResource Chat.Memory.AdvancedWorkflowTab}">
            <ScrollViewer Margin="10,10,0,10" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{StaticResource Chat.Memory.IncrementalUpdate}"
                               Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Margin="0,2,0,8"
                               Text="{StaticResource Chat.Memory.IncrementalUpdateHelp}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <CheckBox Margin="0,4,0,0"
                              Content="{StaticResource Chat.Memory.AutoUpdate}"
                              IsChecked="{Binding Memory.AutoGenerateEnabled}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{StaticResource Chat.Memory.NewTurnsThreshold}" />
                            <TextBox Margin="0,5,0,0"
                                     Text="{Binding Memory.UpdateIntervalTurns, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{StaticResource Chat.Memory.MaximumTurns}" />
                            <TextBox Margin="0,5,0,0"
                                     Text="{Binding Memory.MaximumSourceUserTurns, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Margin="0,10,0,0"
                              Content="{StaticResource Chat.Memory.IncrementalOnly}"
                              IsChecked="{Binding Memory.SendOnlyNewMessages}" />
                    <Button Margin="0,10,0,0"
                            Content="{StaticResource Chat.Memory.SaveWorkflow}"
                            Command="{Binding Memory.SaveSettingsCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Margin="0,0,7,0"
                                Content="{StaticResource Chat.Memory.EditUpdatePrompt}"
                                Command="{Binding OpenGlobalPromptCommand}"
                                CommandParameter="MemoryUpdateSystem"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="{StaticResource Chat.Memory.EditCompressionPrompt}"
                                Command="{Binding OpenGlobalPromptCommand}"
                                CommandParameter="MemoryCompressionSystem"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0"
                               Text="{StaticResource Chat.Memory.TemplateHelp}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Margin="0,0,7,7"
                                Content="{StaticResource Chat.Memory.PreviewUpdate}"
                                Command="{Binding Memory.PreviewUpdateCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Margin="0,0,7,7"
                                Content="{StaticResource Chat.Memory.GenerateUpdateDraft}"
                                Command="{Binding Memory.GenerateUpdateCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Margin="0,0,7,7"
                                Content="{StaticResource Chat.Memory.GenerateCompressionDraft}"
                                Command="{Binding Memory.GenerateCompressionCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Margin="0,0,0,7"
                                Content="{StaticResource Common.Stop}"
                                 Command="{Binding Memory.StopGenerationCommand}"
                                 Visibility="Collapsed"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding Memory.Status}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,4"
                               Text="{StaticResource Chat.Memory.UpdatePreview}"
                               FontWeight="SemiBold" />
                    <TextBox Text="{Binding Memory.RequestPreview, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto"
                             MaxHeight="220" />

                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{StaticResource Chat.Memory.DraftTab}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="Normal" FontSize="{DynamicResource FontSizeSmall}" Text="{Binding Memory.PendingTargetText}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TabControl Grid.Row="1" Margin="0,10,0,0">
                    <TabItem Header="{StaticResource Memory.Diff.Short}" AutomationProperties.AutomationId="MemoryDraftDiffTab">
                        <DockPanel Margin="4">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Memory.DiffStatus}" TextWrapping="Wrap"
                                       Margin="0,0,0,8" Foreground="{DynamicResource MutedTextBrush}" />
                            <ListBox ItemsSource="{Binding Memory.PendingDiff}" AutomationProperties.AutomationId="MemoryDraftDiff"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Padding="4,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static presentation:MemoryDiffKind.Added}">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessFg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static presentation:MemoryDiffKind.Removed}">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBg}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningFg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{StaticResource Memory.Body.Short}" AutomationProperties.AutomationId="MemoryDraftBodyTab">
                        <TextBox Text="{Binding Memory.PendingBody, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding Memory.IsGenerating}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalScrollBarVisibility="Auto" />
                    </TabItem>

                </TabControl>
                <Expander Grid.Row="2" Margin="0,8,0,0" Header="{StaticResource Memory.Request.Short}"
                          FontSize="{DynamicResource FontSizeSmall}" AutomationProperties.AutomationId="MemoryDraftRequest">
                    <TextBox Text="{Binding Memory.RequestPreview, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{StaticResource Memory.Request.Short}"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                </Expander>
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                    <Button AutomationProperties.AutomationId="DiscardMemoryDraft" FontSize="{DynamicResource FontSizeSmall}" Padding="10,8"
                            Command="{Binding Memory.DiscardDraftCommand}"
                            Foreground="{DynamicResource DangerBrush}" Style="{StaticResource SecondaryButtonStyle}">
                        <TextBlock Text="{StaticResource Chat.Memory.DiscardDraft}" TextWrapping="Wrap" TextAlignment="Center"
                                   FontWeight="Normal" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Grid.Column="1" Margin="10,0,0,0" AutomationProperties.AutomationId="SaveMemoryDraft"
                            FontSize="{DynamicResource FontSizeSmall}" Padding="10,8" Command="{Binding Memory.SaveDraftCommand}"
                            Style="{StaticResource PrimaryButtonStyle}">
                        <TextBlock Text="{StaticResource Chat.Memory.SaveDraft}" TextWrapping="Wrap" TextAlignment="Center"
                                   FontWeight="Normal" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
