<UserControl x:Class="TavernDesk.App.Views.CampaignsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid Visibility="{Binding IsLibrary, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="30,24,30,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="跑团" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="剧本是 GM 的结构化主持模板；每一局保存独立历史，可继续或用左侧剧本开新局。"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,18,0,16" Orientation="Horizontal">
                    <Button Content="新建剧本"
                            Command="{Binding NewScenarioCommand}"
                            ToolTip="按问卷式结构填写并保存一个新的跑团剧本。"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="导入剧本卡"
                            Margin="8,0,0,0"
                            Command="{Binding ImportScenarioCommand}"
                            ToolTip="从本地选择一张剧本卡并加入剧本库。"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="编辑所选剧本"
                            Margin="8,0,0,0"
                            Command="{Binding EditScenarioCommand}"
                            ToolTip="打开所选剧本的结构化编辑界面；保存后更新剧本库。"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="用所选剧本开新局"
                            Margin="24,0,0,0"
                            Command="{Binding OpenScenarioLobbyCommand}"
                            ToolTip="进入起始大厅，选择 GM、参与方式、角色和模型后创建一局全新跑团。"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="继续所选跑团"
                            Margin="24,0,0,0"
                            Command="{Binding ContinueCampaignCommand}"
                            ToolTip="打开右侧选中的跑团，并从已自动保存的状态继续。"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="剧本库" Style="{StaticResource SectionTitleStyle}" />
                            <ListBox Grid.Row="1"
                                     Margin="0,12,0,0"
                                     HorizontalContentAlignment="Stretch"
                                     ItemsSource="{Binding Scenarios}"
                                     SelectedItem="{Binding SelectedScenario}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource ModernListBoxItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,2" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="2"
                                                Padding="10,9"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,4,0,0"
                                                           MaxHeight="40"
                                                           Text="{Binding Summary}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Grid.Row="2"
                                                           Margin="0,5,0,0"
                                                           Text="{Binding SourceFileName}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="已保存的跑团" Style="{StaticResource SectionTitleStyle}" />
                            <ListBox Grid.Row="1"
                                     Margin="0,12,0,0"
                                     HorizontalContentAlignment="Stretch"
                                     ItemsSource="{Binding Campaigns}"
                                     SelectedItem="{Binding SelectedCampaign}"
                                     ToolTip="选择跑团继续；右键可重命名或永久删除该局及其记录。">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                            <Grid.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="重命名…"
                                                              Command="{Binding PlacementTarget.Tag.RenameCampaignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="删除跑团…"
                                                              Command="{Binding PlacementTarget.Tag.DeleteCampaignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Foreground="{StaticResource MutedTextBrush}">
                                                    <Run Text="回合 " />
                                                    <Run Text="{Binding CurrentRound, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding ParticipantCount, Mode=OneWay}" />
                                                    <Run Text=" 席位" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StatusLabel}" />
                                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="3"
                           Margin="0,14,0,0"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Grid>

        <Grid Visibility="{Binding IsScenarioEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,22,30,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ScenarioEditorTitle}" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="{Binding ScenarioEditorDescription}"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Content="返回剧本库"
                                    Command="{Binding BackToLibraryCommand}"
                                    ToolTip="放弃未保存的剧本修改并返回剧本库。"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="保存剧本"
                                    Margin="8,0,0,0"
                                    Command="{Binding SaveScenarioCommand}"
                                    ToolTip="保存当前结构化字段；不会改写原始来源卡片文件。"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,18,0,0"
                            Padding="18"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="按结构填写剧本"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,18"
                                       Text="每一项都会成为独立的剧本资料。可以先写简短版本，保存后再继续编辑。"
                                       Foreground="{StaticResource MutedTextBrush}" />

                            <TabControl Margin="0,4,0,0">
                                <TabItem Header="基础">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,12,0,4">
                                            <TextBlock Text="剧本标题" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,7"
                                                       Text="剧本名称或冒险主题。"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Text="{Binding ScenarioTitle, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,18,0,0" Text="剧本简介" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,7"
                                                       Text="用几句话说明玩家将面对什么故事。"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Height="110"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding ScenarioSummary, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="世界与规则">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,12,0,4">
                                            <TextBlock Text="世界观" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,7"
                                                       Text="时代、地点、势力、重要事实、能力体系和氛围。"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Height="220"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding ScenarioWorldSetting, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,18,0,0" Text="公开规则" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,7"
                                                       Text="玩家行动、掷骰和 GM 裁定的公开边界。"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Height="220"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding ScenarioPublicRules, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="主持与开场">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,12,0,4">
                                            <TextBlock Text="GM 主持指令" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,7"
                                                       Text="GM 的叙事口吻、主持职责、信息公开方式和边界。"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Height="220"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding ScenarioGmInstructions, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,18,0,0" Text="开场设置" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,7"
                                                       Text="第一幕开始时的任务、地点、人物关系和待解决问题。"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Height="180"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding ScenarioOpeningSetup, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,18,0,0" Text="开场旁白" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,7"
                                                       Text="玩家看到的第一段场景文字或事件。"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Height="180"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding ScenarioOpeningNarration, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="叙事权限">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,12,0,4">
                                            <TextBlock Text="GM 可以改变什么"
                                                       Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,16"
                                                       Text="这些权限会在开局时冻结。‘仅限玩家明确提交’要求变化关联本轮已经锁定的 PlayerIntent。"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}" />

                                            <TextBlock Text="新增 NPC" />
                                            <ComboBox Margin="0,6,0,0"
                                                      ItemsSource="{Binding NarrativePermissionChoices}"
                                                      SelectedItem="{Binding ScenarioNewNpcPermission}"
                                                      DisplayMemberPath="Name" />
                                            <TextBlock Margin="0,5,0,16"
                                                       Text="{Binding ScenarioNewNpcPermission.Description}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}" />

                                            <TextBlock Text="改变关系或互动对象" />
                                            <ComboBox Margin="0,6,0,0"
                                                      ItemsSource="{Binding NarrativePermissionChoices}"
                                                      SelectedItem="{Binding ScenarioRelationshipChangePermission}"
                                                      DisplayMemberPath="Name" />
                                            <TextBlock Margin="0,5,0,16"
                                                       Text="{Binding ScenarioRelationshipChangePermission.Description}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}" />

                                            <TextBlock Text="开启独立剧情支线" />
                                            <ComboBox Margin="0,6,0,0"
                                                      ItemsSource="{Binding NarrativePermissionChoices}"
                                                      SelectedItem="{Binding ScenarioIndependentPlotPermission}"
                                                      DisplayMemberPath="Name" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Text="{Binding ScenarioIndependentPlotPermission.Description}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="资料">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,12,0,4">
                                            <Expander Header="旧示例 / 历史归档（可选）">
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock Text="旧对话示例、参考片段或迁移记录；不会伪装成当前跑团历史。"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBox Margin="0,8,0,0"
                                                             Height="180"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             VerticalContentAlignment="Top"
                                                             VerticalScrollBarVisibility="Auto"
                                                             Text="{Binding ScenarioLegacyExamplesArchive, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Expander>
                                            <TextBlock Margin="0,18,0,0" Text="世界书绑定" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,10"
                                                       Text="选择会随这个剧本一起使用的世界书；保存逻辑保持不变。"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <ItemsControl ItemsSource="{Binding ScenarioWorldbookBindings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,7"
                                                                Padding="10,8"
                                                                Background="{StaticResource SurfaceAltBrush}"
                                                                CornerRadius="10">
                                                            <StackPanel>
                                                                <CheckBox Content="{Binding Name}"
                                                                          IsChecked="{Binding IsBound, Mode=TwoWay}"
                                                                          FontWeight="SemiBold" />
                                                                <TextBlock Margin="24,3,0,0"
                                                                           Text="{Binding Description}"
                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="尚未导入世界书；也可以先保存剧本，再到“世界书”页面选择跑团剧本绑定。"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ScenarioWorldbookBindings.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,14,0,0"
                               Text="{Binding StatusText}"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="原始来源卡片不会被覆盖；保存的是 TavernDesk 本地剧本副本。已经开始的跑团不会被事后编辑影响。"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Visibility="{Binding IsLobby, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="30,22,30,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="起始大厅" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="点击“开始游戏”时冻结剧本、角色快照、记忆导入与初始模型；首次问候和旧聊天示例不会作为开场历史发送。"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Content="返回剧本库"
                                Command="{Binding BackToLibraryCommand}"
                                ToolTip="放弃当前未保存的界面改动并返回剧本库。"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="4" Text="本局设置" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Grid.Row="1" Margin="0,14,10,0" Text="本局标题" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,14,16,0"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,14,10,0" Text="流程方式" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,14,0,0"
                                      ItemsSource="{Binding FlowChoices}"
                                      SelectedItem="{Binding SelectedFlow}"
                                      DisplayMemberPath="Name" />

                            <TextBlock Grid.Row="2" Margin="0,10,10,0" Text="谁担任 GM" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,10,16,0"
                                      ItemsSource="{Binding GmChoices}"
                                      SelectedItem="{Binding SelectedGm}"
                                      DisplayMemberPath="Name" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,10,10,0" Text="GM 模型" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,10,0,0"
                                      ItemsSource="{Binding ModelOptions}"
                                      SelectedItem="{Binding SelectedGmRoute}"
                                      DisplayMemberPath="DisplayLabel"
                                      Visibility="{Binding IsAiGm, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="3" Margin="0,10,10,0" Text="你的参与方式" VerticalAlignment="Top" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,10,16,0">
                                <ComboBox ItemsSource="{Binding UserParticipationChoices}"
                                          SelectedItem="{Binding SelectedUserParticipation}"
                                          DisplayMemberPath="Name" />
                                <TextBlock Margin="2,5,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding SelectedUserParticipation.Description}" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,10,10,0"
                                       Text="你的席位名称"
                                       VerticalAlignment="Top" />
                            <TextBox Grid.Row="3" Grid.Column="3" Margin="0,10,0,0"
                                     VerticalAlignment="Top"
                                     Text="{Binding UserPersonaName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                       Margin="0,8,16,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding SelectedGm.Description}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding SelectedFlow.Description}" />

                            <Expander Grid.Row="5"
                                      Grid.RowSpan="2"
                                      Grid.ColumnSpan="4"
                                      Margin="0,12,0,0"
                                      Header="高级设置">
                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,10,0"
                                                   Text="玩家历史 tokens"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Margin="0,0,16,0"
                                                 Text="{Binding PlayerHistoryBudget}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="0,0,10,0"
                                                   Text="GM 历史 tokens"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding GmHistoryBudget}" />
                                    </Grid>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Margin="0,0,8,0"
                                                Content="编辑 GM 职责提示词"
                                                Command="{Binding OpenGlobalPromptCommand}"
                                                CommandParameter="CampaignGmSystem"
                                                ToolTip="打开全局提示词设置，编辑 AI GM 在所有跑团中遵循的主持职责。"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="编辑 AI 玩家职责提示词"
                                                Command="{Binding OpenGlobalPromptCommand}"
                                                CommandParameter="CampaignPlayerSystem"
                                                ToolTip="打开全局提示词设置，编辑所有 AI 玩家在跑团中遵循的行动规范。"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="剧本内容摘要" Style="{StaticResource SectionTitleStyle}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="世界观" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,0,0"
                                               MaxHeight="70"
                                               Text="{Binding WorldSetting}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="公开规则" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,0,0"
                                               MaxHeight="70"
                                               Text="{Binding Rules}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="开场设置" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,0,0"
                                               MaxHeight="70"
                                               Text="{Binding OpeningPrompt}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                            <Expander Margin="0,12,0,0" Header="本局覆盖剧本内容…">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="世界观" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBox Margin="0,8,0,0" MinHeight="150"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding WorldSetting}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="公开规则" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBox Margin="0,8,0,0" MinHeight="150"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding Rules}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="开场设置（给 GM）" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBox Margin="0,8,0,0" MinHeight="150"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding OpeningPrompt}" />
                                    </StackPanel>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="AI 玩家（0–4 个；勾选角色即增加，取消勾选即减少）"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="旁观模式至少选择 1 名 AI 玩家；参与模式也允许只有 USER 玩家。每个 AI 席位可使用不同模型。"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Padding="10,6"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="12">
                                    <TextBlock Text="{Binding LobbyRosterText}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ItemsControl Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding CharacterChoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="10"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Content="{Binding Name}"
                                                          FontWeight="SemiBold"
                                                          IsChecked="{Binding IsSelected}"
                                                          IsEnabled="{Binding IsSelectionEnabled}"
                                                          ToolTip="勾选加入本局，取消勾选移出本局"
                                                          VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1" Margin="12,0"
                                                          ItemsSource="{Binding DataContext.ModelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding SelectedRoute}"
                                                          DisplayMemberPath="DisplayLabel" />
                                                <CheckBox Grid.Column="2" Margin="8,0"
                                                          Content="导入聊天记忆"
                                                          IsChecked="{Binding IncludeMemory}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,16,0,0">
                        <TextBlock Text="{Binding StatusText}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Content="保存大厅草稿"
                                    Command="{Binding SaveLobbyCommand}"
                                    ToolTip="保存当前剧本、角色、GM、参与方式与模型选择；暂不开始游玩。"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="开始本局并冻结配置"
                                    Margin="8,0,0,0"
                                    Command="{Binding StartCampaignCommand}"
                                    ToolTip="校验并冻结剧本、角色快照、记忆与初始模型，然后生成 GM 开场并进入第 1 回合。"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid Visibility="{Binding IsGame, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="22,18,22,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding GameTitle}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{Binding GamePhaseText}" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="跑团设置"
                                Click="MemorySettingsButton_OnClick"
                                ToolTip="管理当前跑团的上下文预算与升级版跑团记忆。"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="↻ 刷新"
                                Margin="8,0,0,0"
                                Command="{Binding RefreshGameCommand}"
                                ToolTip="从本地数据库重新载入当前跑团；不会调用模型或新增记录。"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="返回剧本库"
                                Margin="8,0,0,0"
                                Command="{Binding BackToLibraryCommand}"
                                ToolTip="离开游玩页并返回剧本库；本局记录已自动保存，可随时继续。"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="245" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="玩家席位" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="协作圆桌可任选未行动的 AI；严格先攻只开放当前席位。"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Margin="0,10,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Seats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,9" Padding="10"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   Text="{Binding KindLabel}"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                    </Grid>
                                                    <TextBlock Margin="0,4,0,7"
                                                               Text="{Binding RoundStatus}"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                    <Button Margin="0,6,0,0"
                                                            Content="{Binding ActionButtonText}"
                                                            IsEnabled="{Binding CanGenerateAction}"
                                                            Command="{Binding DataContext.GenerateAiSeatActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding ActionHelpText}"
                                                            Visibility="{Binding ShowActionButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button"
                                                                   BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRetryAction}"
                                                                                 Value="True">
                                                                        <Setter Property="Background"
                                                                                Value="{StaticResource AccentBrush}" />
                                                                        <Setter Property="Foreground"
                                                                                Value="White" />
                                                                        <Setter Property="BorderBrush"
                                                                                Value="{StaticResource AccentBrush}" />
                                                                        <Setter Property="FontWeight"
                                                                                Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Expander Margin="0,8,0,0"
                                                              Header="席位模型设置"
                                                              Visibility="{Binding IsAi, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <StackPanel Margin="0,7,0,0">
                                                            <ComboBox ItemsSource="{Binding DataContext.ModelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      SelectedItem="{Binding SelectedRoute}"
                                                                      DisplayMemberPath="DisplayLabel" />
                                                            <Button Margin="0,6,0,0"
                                                            Content="从下次行动起使用此模型"
                                                            Command="{Binding DataContext.ApplySeatRouteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="仅切换这个 AI 席位之后的模型；角色卡、记忆快照和既有记录保持不变。"
                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="跑团记录" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding SaveStateText}"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" Margin="0,10,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Events}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10" Padding="12"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10">
                                                <StackPanel>
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ActorName}" FontWeight="SemiBold" />
                                                            <TextBlock Margin="8,0,0,0"
                                                                       Text="{Binding KindLabel}"
                                                                       Foreground="{StaticResource MutedTextBrush}" />
                                                        </StackPanel>
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   Text="{Binding StatusLabel}"
                                                                   Foreground="{StaticResource AccentBrush}" />
                                                    </Grid>
                                                    <StackPanel Margin="0,6,0,0"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal"
                                                                Visibility="{Binding HasCandidates, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="GM 候选"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                        <Button Content="‹"
                                                                Command="{Binding DataContext.PreviousGmCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Style="{StaticResource CandidateNavigationButtonStyle}"
                                                                ToolTip="查看上一个 GM 候选" />
                                                        <TextBlock MinWidth="32"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   Text="{Binding CandidateNavigationLabel}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                        <Button Content="›"
                                                                Command="{Binding DataContext.NextGmCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Style="{StaticResource CandidateNavigationButtonStyle}"
                                                                ToolTip="查看下一个 GM 候选" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding CandidateHelpText}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Visibility="{Binding HasCandidates, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Margin="0,7,0,0"
                                                               Text="{Binding DisplayContent}"
                                                               TextWrapping="Wrap" />
                                                    <Button Margin="0,8,0,0"
                                                            HorizontalAlignment="Left"
                                                            Content="{Binding RetryButtonText}"
                                                            Command="{Binding DataContext.RetryEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding RetryHelpText}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="当前步骤" Style="{StaticResource SectionTitleStyle}" />
                                    <StackPanel Margin="0,8,0,0">
                                        <Border Margin="0,0,0,6"
                                                Padding="9,6"
                                                Background="{StaticResource AccentSoftBrush}"
                                                CornerRadius="10">
                                            <TextBlock Text="{Binding GmModeText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <Border Padding="9,6"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                CornerRadius="10">
                                            <TextBlock Text="{Binding ParticipationModeText}"
                                                       FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,14,0,0"
                                               Text="{Binding CurrentStepTitle}"
                                               FontSize="19"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="{Binding CurrentStepDescription}"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding CurrentStepProgressText}"
                                               FontSize="12"
                                               Foreground="{StaticResource AccentBrush}" />

                                    <Expander Margin="0,12,0,0"
                                              Header="本轮上下文估算"
                                              IsExpanded="False"
                                              Visibility="{Binding HasContextPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding ContextPreviewSummary}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <ItemsControl Margin="0,8,0,0"
                                                          ItemsSource="{Binding ContextPreviewItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8"
                                                                Padding="9,7"
                                                                Background="{StaticResource SurfaceAltBrush}"
                                                                CornerRadius="10">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Margin="0,3,0,0"
                                                                           Text="{Binding BudgetText}"
                                                                           FontSize="12" />
                                                                <TextBlock Margin="0,3,0,0"
                                                                           Text="{Binding StatusText}"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{StaticResource AccentBrush}" />
                                                                <ItemsControl Margin="0,6,0,0"
                                                                              ItemsSource="{Binding Sections}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,1,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{Binding Title}"
                                                                                           FontSize="11"
                                                                                           TextWrapping="Wrap" />
                                                                                <StackPanel Grid.Column="1"
                                                                                            Margin="6,0,0,0">
                                                                                    <TextBlock Text="{Binding TokenText}"
                                                                                               FontSize="11"
                                                                                               HorizontalAlignment="Right" />
                                                                                    <TextBlock Text="{Binding StateText}"
                                                                                               FontSize="10"
                                                                                               HorizontalAlignment="Right"
                                                                                               Foreground="{StaticResource MutedTextBrush}" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>

                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding ShowUserActionSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="你的本回合行动"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="提交时会自动附带一枚 1d20；GM 会结合角色、行动方法和局势灵活裁定。"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBox Margin="0,7,0,0"
                                                 MinHeight="88"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding ActionInput, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Margin="0,8,0,0"
                                                Content="提交我的行动"
                                                IsEnabled="{Binding CanSubmitUserAction}"
                                                Command="{Binding SubmitUserActionCommand}"
                                                ToolTip="{Binding UserActionHelpText}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding ShowBlindAiAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="AI 秘密行动"
                                                   FontWeight="SemiBold" />
                                        <Button Margin="0,7,0,0"
                                                Content="让所有 AI 秘密提交行动"
                                                IsEnabled="{Binding CanGenerateBlindAiActions}"
                                                Command="{Binding GenerateAiActionsCommand}"
                                                ToolTip="{Binding BlindAiActionHelpText}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding ShowResolveSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="本回合 GM 裁定"
                                                   FontWeight="SemiBold" />
                                        <TextBox Margin="0,7,0,0"
                                                 MinHeight="88"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding GmResolutionInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsUserGm, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Margin="0,8,0,0"
                                                Content="{Binding ResolveButtonText}"
                                                IsEnabled="{Binding CanResolve}"
                                                Command="{Binding ResolveRoundCommand}"
                                                ToolTip="{Binding ResolveHelpText}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Style="{StaticResource CardStyle}"
                                    Visibility="{Binding ShowUserJoinSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="想亲自加入？"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="可以预约 USER 席位，从下一完整回合开始参与；当前回合不会改变。"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <Button Margin="0,8,0,0"
                                            Content="{Binding ScheduleUserJoinButtonText}"
                                            IsEnabled="{Binding CanScheduleUserJoin}"
                                            Command="{Binding ScheduleUserJoinCommand}"
                                            ToolTip="{Binding ScheduleUserJoinHelpText}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                                <Expander Header="额外掷骰与记录">
                                    <StackPanel Margin="0,9,0,0">
                                        <TextBlock Text="每次玩家行动已经自动附带一枚 1d20。这里仅用于额外的剧情、环境或 GM 公开掷骰。"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding DiceExpression, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Margin="8,0,0,0"
                                                    Content="进行额外公开掷骰"
                                                    Command="{Binding RollDiceCommand}"
                                                    ToolTip="按左侧表达式生成一条独立的公开骰点记录；它不会替代玩家行动自动附带的 1d20。"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}"
                                    Visibility="{Binding IsAiGm, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Expander Header="GM 模型设置">
                                    <StackPanel Margin="0,9,0,0">
                                        <ComboBox ItemsSource="{Binding ModelOptions}"
                                                  SelectedItem="{Binding SelectedGmRoute}"
                                                  DisplayMemberPath="DisplayLabel" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Margin="0,0,10,0"
                                                       VerticalAlignment="Center"
                                                       Text="GM 输出 Token" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding GmMaxOutputTokensText, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <TextBlock Margin="0,5,0,0"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="每次 GM 裁定的最大输出长度；范围 512–6000，且不能超过所选模型能力。" />
                                        <Button Margin="0,8,0,0"
                                                Content="应用 GM 模型与输出长度"
                                                Command="{Binding ApplyGmRouteCommand}"
                                                ToolTip="从下一次裁定起使用所选模型与输出长度；剧本、世界状态和既有记录保持不变。"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <TextBlock Grid.Row="2" Margin="0,12,0,0"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
