<UserControl x:Class="TavernDesk.App.Views.CampaignsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:TavernDesk.Core.Models;assembly=TavernDesk.Core">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Visibility="{Binding IsLibrary, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="30,24,30,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{StaticResource Campaigns.Title}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{StaticResource Campaigns.Description}"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,18,0,16" Orientation="Horizontal">
                    <Button Content="{StaticResource Campaigns.NewScenario}"
                            Command="{Binding NewScenarioCommand}"
                            ToolTip="{StaticResource Campaigns.NewScenarioToolTip}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="{StaticResource Campaigns.ImportScenario}"
                            Margin="8,0,0,0"
                            Command="{Binding ImportScenarioCommand}"
                            ToolTip="{StaticResource Campaigns.ImportScenarioToolTip}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="{StaticResource Campaigns.EditScenario}"
                            Margin="8,0,0,0"
                            Command="{Binding EditScenarioCommand}"
                            ToolTip="{StaticResource Campaigns.EditScenarioToolTip}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="{StaticResource Campaigns.StartNew}"
                            Margin="24,0,0,0"
                            Command="{Binding OpenScenarioLobbyCommand}"
                            ToolTip="{StaticResource Campaigns.StartNewToolTip}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="{StaticResource Campaigns.Continue}"
                            Margin="24,0,0,0"
                            Command="{Binding ContinueCampaignCommand}"
                            ToolTip="{StaticResource Campaigns.ContinueToolTip}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{StaticResource Campaigns.ScenarioLibrary}" Style="{StaticResource SectionTitleStyle}" />
                            <ListBox Grid.Row="1"
                                     Margin="0,12,0,0"
                                     HorizontalContentAlignment="Stretch"
                                     ItemsSource="{Binding Scenarios}"
                                     SelectedItem="{Binding SelectedScenario}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource ModernListBoxItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,2" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="2"
                                                Padding="10,9"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,4,0,0"
                                                           MaxHeight="40"
                                                           Text="{Binding Summary}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock Grid.Row="2"
                                                           Margin="0,5,0,0"
                                                           Text="{Binding SourceFileName}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{StaticResource Campaigns.SavedCampaigns}" Style="{StaticResource SectionTitleStyle}" />
                            <ListBox Grid.Row="1"
                                     Margin="0,12,0,0"
                                     HorizontalContentAlignment="Stretch"
                                     ItemsSource="{Binding Campaigns}"
                                     SelectedItem="{Binding SelectedCampaign}"
                                     ToolTip="{StaticResource Campaigns.SavedCampaignsToolTip}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                            <Grid.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="{StaticResource Campaigns.Rename}"
                                                              Command="{Binding PlacementTarget.Tag.RenameCampaignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="{StaticResource Campaigns.DeleteCampaign}"
                                                              Command="{Binding PlacementTarget.Tag.DeleteCampaignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}">
                                                    <Run Text="{StaticResource Campaigns.RoundPrefix}" />
                                                    <Run Text="{Binding CurrentRound, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding ParticipantCount, Mode=OneWay}" />
                                                    <Run Text="{StaticResource Campaigns.SeatSuffix}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StatusLabel}" />
                                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="3"
                           Margin="0,14,0,0"
                           Text="{Binding StatusText}"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
        </Grid>

        <Grid Visibility="{Binding IsScenarioEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,22,30,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ScenarioEditorTitle}" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="{Binding ScenarioEditorDescription}"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Content="{StaticResource Campaigns.BackToLibrary}"
                                    Command="{Binding BackToLibraryCommand}"
                                    ToolTip="{StaticResource Campaigns.BackDiscardToolTip}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="{StaticResource Campaigns.SaveScenario}"
                                    Margin="8,0,0,0"
                                    Command="{Binding SaveScenarioCommand}"
                                    ToolTip="{StaticResource Campaigns.SaveScenarioToolTip}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,18,0,0"
                            Padding="18"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{StaticResource Campaigns.Edit.StructuredTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,18"
                                       Text="{StaticResource Campaigns.Edit.StructuredDescription}"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <TabControl Margin="0,4,0,0">
                                <TabItem Header="{StaticResource Campaigns.Edit.Tab.Basic}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,12,0,4">
                                            <TextBlock Text="{StaticResource Campaigns.Edit.ScenarioTitle}" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,7"
                                                       Text="{StaticResource Campaigns.Edit.ScenarioTitleHelp}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBox Text="{Binding ScenarioTitle, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,18,0,0" Text="{StaticResource Campaigns.Edit.Summary}" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,7"
                                                       Text="{StaticResource Campaigns.Edit.SummaryHelp}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBox Height="110"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding ScenarioSummary, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{StaticResource Campaigns.Edit.Tab.WorldRules}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,12,0,4">
                                            <TextBlock Text="{StaticResource Campaigns.Edit.World}" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,7"
                                                       Text="{StaticResource Campaigns.Edit.WorldHelp}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBox Height="220"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding ScenarioWorldSetting, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,18,0,0" Text="{StaticResource Campaigns.Edit.PublicRules}" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,7"
                                                       Text="{StaticResource Campaigns.Edit.PublicRulesHelp}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBox Height="220"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding ScenarioPublicRules, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{StaticResource Campaigns.Edit.Tab.GmOpening}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,12,0,4">
                                            <TextBlock Text="{StaticResource Campaigns.Edit.GmInstructions}" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,7"
                                                       Text="{StaticResource Campaigns.Edit.GmInstructionsHelp}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBox Height="220"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding ScenarioGmInstructions, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,18,0,0" Text="{StaticResource Campaigns.Edit.OpeningSetup}" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,7"
                                                       Text="{StaticResource Campaigns.Edit.OpeningSetupHelp}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBox Height="180"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding ScenarioOpeningSetup, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,18,0,0" Text="{StaticResource Campaigns.Edit.OpeningNarration}" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,7"
                                                       Text="{StaticResource Campaigns.Edit.OpeningNarrationHelp}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBox Height="180"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding ScenarioOpeningNarration, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{StaticResource Campaigns.Edit.Tab.NarrativeAuthority}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,12,0,4">
                                            <TextBlock Text="{StaticResource Campaigns.Edit.AuthorityTitle}"
                                                       Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,16"
                                                       Text="{StaticResource Campaigns.Edit.AuthorityHelp}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}" />

                                            <TextBlock Text="{StaticResource Campaigns.Edit.AddNpc}" />
                                            <ComboBox Margin="0,6,0,0"
                                                      ItemsSource="{Binding NarrativePermissionChoices}"
                                                      SelectedItem="{Binding ScenarioNewNpcPermission}"
                                                      DisplayMemberPath="Name" />
                                            <TextBlock Margin="0,5,0,16"
                                                       Text="{Binding ScenarioNewNpcPermission.Description}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}" />

                                            <TextBlock Text="{StaticResource Campaigns.Edit.ChangeRelationship}" />
                                            <ComboBox Margin="0,6,0,0"
                                                      ItemsSource="{Binding NarrativePermissionChoices}"
                                                      SelectedItem="{Binding ScenarioRelationshipChangePermission}"
                                                      DisplayMemberPath="Name" />
                                            <TextBlock Margin="0,5,0,16"
                                                       Text="{Binding ScenarioRelationshipChangePermission.Description}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}" />

                                            <TextBlock Text="{StaticResource Campaigns.Edit.StartSubplot}" />
                                            <ComboBox Margin="0,6,0,0"
                                                      ItemsSource="{Binding NarrativePermissionChoices}"
                                                      SelectedItem="{Binding ScenarioIndependentPlotPermission}"
                                                      DisplayMemberPath="Name" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Text="{Binding ScenarioIndependentPlotPermission.Description}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{StaticResource Campaigns.Edit.Tab.Materials}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,12,0,4">
                                            <Expander Header="{StaticResource Campaigns.Edit.LegacyArchive}">
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock Text="{StaticResource Campaigns.Edit.LegacyArchiveHelp}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBox Margin="0,8,0,0"
                                                             Height="180"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             VerticalContentAlignment="Top"
                                                             VerticalScrollBarVisibility="Auto"
                                                             Text="{Binding ScenarioLegacyExamplesArchive, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Expander>
                                            <TextBlock Margin="0,18,0,0" Text="{StaticResource Campaigns.Edit.WorldbookBindings}" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,10"
                                                       Text="{StaticResource Campaigns.Edit.WorldbookBindingsHelp}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <ItemsControl ItemsSource="{Binding ScenarioWorldbookBindings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,7"
                                                                Padding="10,8"
                                                                Background="{DynamicResource SurfaceAltBrush}"
                                                                CornerRadius="10">
                                                            <StackPanel>
                                                                <CheckBox Content="{Binding Name}"
                                                                          IsChecked="{Binding IsBound, Mode=TwoWay}"
                                                                          FontWeight="SemiBold" />
                                                                <TextBlock Margin="24,3,0,0"
                                                                           Text="{Binding Description}"
                                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{StaticResource Campaigns.Edit.NoWorldbooks}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ScenarioWorldbookBindings.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,14,0,0"
                               Text="{Binding StatusText}"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{StaticResource Campaigns.Edit.SourcePreserved}"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Visibility="{Binding IsLobby, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="30,22,30,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{StaticResource Campaigns.Lobby.Title}" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="{StaticResource Campaigns.Lobby.Description}"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Content="{StaticResource Campaigns.BackToLibrary}"
                                Command="{Binding BackToLibraryCommand}"
                                ToolTip="{StaticResource Campaigns.Lobby.BackToolTip}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="4" Text="{StaticResource Campaigns.Lobby.Settings}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Grid.Row="1" Margin="0,14,10,0" Text="{StaticResource Campaigns.Lobby.TitleLabel}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,14,16,0"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,14,10,0" Text="{StaticResource Campaigns.Lobby.FlowMode}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,14,0,0"
                                      ItemsSource="{Binding FlowChoices}"
                                      SelectedItem="{Binding SelectedFlow}"
                                      DisplayMemberPath="Name" />

                            <TextBlock Grid.Row="2" Margin="0,10,10,0" Text="{StaticResource Campaigns.Lobby.GmOwner}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,10,16,0"
                                      ItemsSource="{Binding GmChoices}"
                                      SelectedItem="{Binding SelectedGm}"
                                      DisplayMemberPath="Name" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,10,10,0" Text="{StaticResource Campaigns.Lobby.GmModel}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,10,0,0"
                                      ItemsSource="{Binding ModelOptions}"
                                      SelectedItem="{Binding SelectedGmRoute}"
                                      DisplayMemberPath="DisplayLabel"
                                      Visibility="{Binding IsAiGm, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="3" Margin="0,10,10,0" Text="{StaticResource Campaigns.Lobby.Participation}" VerticalAlignment="Top" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,10,16,0">
                                <ComboBox ItemsSource="{Binding UserParticipationChoices}"
                                          SelectedItem="{Binding SelectedUserParticipation}"
                                          DisplayMemberPath="Name" />
                                <TextBlock Margin="2,5,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{Binding SelectedUserParticipation.Description}" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,10,10,0"
                                       Text="{StaticResource Campaigns.Lobby.UserSeatName}"
                                       VerticalAlignment="Top" />
                            <TextBox Grid.Row="3" Grid.Column="3" Margin="0,10,0,0"
                                     VerticalAlignment="Top"
                                     Text="{Binding UserPersonaName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                       Margin="0,8,16,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding SelectedGm.Description}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding SelectedFlow.Description}" />

                            <Expander Grid.Row="5"
                                      Grid.RowSpan="2"
                                      Grid.ColumnSpan="4"
                                      Margin="0,12,0,0"
                                      Header="{StaticResource Campaigns.Lobby.Advanced}">
                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,10,0"
                                                   Text="{StaticResource Campaigns.Lobby.PlayerHistoryTokens}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Margin="0,0,16,0"
                                                 Text="{Binding PlayerHistoryBudget}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="0,0,10,0"
                                                   Text="{StaticResource Campaigns.Lobby.GmHistoryTokens}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding GmHistoryBudget}" />
                                    </Grid>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Margin="0,0,8,0"
                                                Content="{StaticResource Campaigns.Lobby.EditGmPrompt}"
                                                Command="{Binding OpenGlobalPromptCommand}"
                                                CommandParameter="CampaignGmSystem"
                                                ToolTip="{StaticResource Campaigns.Lobby.EditGmPromptToolTip}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="{StaticResource Campaigns.Lobby.EditPlayerPrompt}"
                                                Command="{Binding OpenGlobalPromptCommand}"
                                                CommandParameter="CampaignPlayerSystem"
                                                ToolTip="{StaticResource Campaigns.Lobby.EditPlayerPromptToolTip}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{StaticResource Campaigns.Lobby.Summary}" Style="{StaticResource SectionTitleStyle}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{StaticResource Campaigns.Edit.World}" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,0,0"
                                               MaxHeight="70"
                                               Text="{Binding WorldSetting}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="{StaticResource Campaigns.Edit.PublicRules}" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,0,0"
                                               MaxHeight="70"
                                               Text="{Binding Rules}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="{StaticResource Campaigns.Edit.OpeningSetup}" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,0,0"
                                               MaxHeight="70"
                                               Text="{Binding OpeningPrompt}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                            <Expander Margin="0,12,0,0" Header="{StaticResource Campaigns.Lobby.OverrideScenario}">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{StaticResource Campaigns.Edit.World}" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBox Margin="0,8,0,0" MinHeight="150"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding WorldSetting}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="{StaticResource Campaigns.Edit.PublicRules}" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBox Margin="0,8,0,0" MinHeight="150"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding Rules}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="{StaticResource Campaigns.Lobby.OpeningForGm}" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBox Margin="0,8,0,0" MinHeight="150"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding OpeningPrompt}" />
                                    </StackPanel>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{StaticResource Campaigns.Lobby.AiPlayers}"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{StaticResource Campaigns.Lobby.AiPlayersHelp}"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Padding="10,6"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="12">
                                    <TextBlock Text="{Binding LobbyRosterText}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ItemsControl Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding CharacterChoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="10"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Content="{Binding Name}"
                                                          FontWeight="SemiBold"
                                                          IsChecked="{Binding IsSelected}"
                                                          IsEnabled="{Binding IsSelectionEnabled}"
                                                          ToolTip="{StaticResource Campaigns.Lobby.IncludeCharacterToolTip}"
                                                          VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1" Margin="12,0"
                                                          ItemsSource="{Binding DataContext.ModelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding SelectedRoute}"
                                                          DisplayMemberPath="DisplayLabel" />
                                                <CheckBox Grid.Column="2" Margin="8,0"
                                                          Content="{StaticResource Campaigns.Lobby.ImportChatMemory}"
                                                          IsChecked="{Binding IncludeMemory}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,16,0,0">
                        <TextBlock Text="{Binding StatusText}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Content="{StaticResource Campaigns.Lobby.SaveDraft}"
                                    Command="{Binding SaveLobbyCommand}"
                                    ToolTip="{StaticResource Campaigns.Lobby.SaveDraftToolTip}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="{StaticResource Campaigns.Lobby.Start}"
                                    Margin="8,0,0,0"
                                    Command="{Binding StartCampaignCommand}"
                                    ToolTip="{StaticResource Campaigns.Lobby.StartToolTip}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid Visibility="{Binding IsGame, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="22,18,22,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding GameTitle}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{Binding GamePhaseText}" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="{StaticResource Campaigns.Play.Settings}"
                                Click="MemorySettingsButton_OnClick"
                                ToolTip="{StaticResource Campaigns.Play.SettingsToolTip}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="{StaticResource Campaigns.Play.Refresh}"
                                Margin="8,0,0,0"
                                Command="{Binding RefreshGameCommand}"
                                ToolTip="{StaticResource Campaigns.Play.RefreshToolTip}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="{StaticResource Campaigns.BackToLibrary}"
                                Margin="8,0,0,0"
                                Command="{Binding BackToLibraryCommand}"
                                ToolTip="{StaticResource Campaigns.Play.BackToolTip}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Seats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MinWidth="88"
                                    Margin="0,0,8,0"
                                    Padding="10,8"
                                    CornerRadius="12"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentTurn}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Text="{Binding RoundStatus}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="245" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{StaticResource Campaigns.Play.PlayerSeats}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{StaticResource Campaigns.Play.PlayerSeatsHelp}"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Margin="0,10,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Seats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,9" Padding="10"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   Text="{Binding KindLabel}"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                    </Grid>
                                                    <TextBlock Margin="0,4,0,7"
                                                               Text="{Binding RoundStatus}"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                    <Button Margin="0,6,0,0"
                                                            Content="{Binding ActionButtonText}"
                                                            IsEnabled="{Binding CanGenerateAction}"
                                                            Command="{Binding DataContext.GenerateAiSeatActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding ActionHelpText}"
                                                            Visibility="{Binding ShowActionButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button"
                                                                   BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRetryAction}"
                                                                                 Value="True">
                                                                        <Setter Property="Background"
                                                                                Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="Foreground"
                                                                                Value="White" />
                                                                        <Setter Property="BorderBrush"
                                                                                Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="FontWeight"
                                                                                Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Expander Margin="0,8,0,0"
                                                              Header="{StaticResource Campaigns.Play.SeatModelSettings}"
                                                              Visibility="{Binding IsAi, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <StackPanel Margin="0,7,0,0">
                                                            <ComboBox ItemsSource="{Binding DataContext.ModelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      SelectedItem="{Binding SelectedRoute}"
                                                                      DisplayMemberPath="DisplayLabel" />
                                                            <Button Margin="0,6,0,0"
                                                            Content="{StaticResource Campaigns.Play.ApplySeatModel}"
                                                            Command="{Binding DataContext.ApplySeatRouteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{StaticResource Campaigns.Play.ApplySeatModelToolTip}"
                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="{StaticResource Campaigns.Play.Log}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding SaveStateText}"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" Margin="0,10,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Events}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Border Width="3"
                                                            HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource MutedTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Event.Kind}"
                                                                                 Value="{x:Static models:CampaignEventKind.PlayerIntent}">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Event.Kind}"
                                                                                 Value="{x:Static models:CampaignEventKind.GmOpening}">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Event.Kind}"
                                                                                 Value="{x:Static models:CampaignEventKind.GmResolution}">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Event.Kind}"
                                                                                 Value="{x:Static models:CampaignEventKind.DiceRoll}">
                                                                        <Setter Property="Background" Value="{DynamicResource AppicaDashboardPurpleBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Event.Kind}"
                                                                                 Value="{x:Static models:CampaignEventKind.System}">
                                                                        <Setter Property="Background" Value="{DynamicResource AppicaDashboardPurpleBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Event.Kind}"
                                                                                 Value="{x:Static models:CampaignEventKind.PrivateDelivery}">
                                                                        <Setter Property="Background" Value="{DynamicResource AppicaDashboardPurpleBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Event.Kind}"
                                                                                 Value="{x:Static models:CampaignEventKind.StateDelta}">
                                                                        <Setter Property="Background" Value="{DynamicResource AppicaDashboardPurpleBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                <StackPanel Margin="14,12,12,12">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ActorName}" FontWeight="SemiBold" />
                                                            <TextBlock Margin="8,0,0,0"
                                                                       Text="{Binding KindLabel}"
                                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                                        </StackPanel>
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   Text="{Binding StatusLabel}"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Grid>
                                                    <StackPanel Margin="0,6,0,0"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal"
                                                                Visibility="{Binding HasCandidates, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{StaticResource Campaigns.Play.GmCandidate}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                        <Button Content="‹"
                                                                Command="{Binding DataContext.PreviousGmCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Style="{StaticResource CandidateNavigationButtonStyle}"
                                                                ToolTip="{StaticResource Campaigns.Play.PreviousGmCandidateToolTip}" />
                                                        <TextBlock MinWidth="32"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   Text="{Binding CandidateNavigationLabel}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                        <Button Content="›"
                                                                Command="{Binding DataContext.NextGmCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Style="{StaticResource CandidateNavigationButtonStyle}"
                                                                ToolTip="{StaticResource Campaigns.Play.NextGmCandidateToolTip}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding CandidateHelpText}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               Visibility="{Binding HasCandidates, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Margin="0,7,0,0"
                                                               Text="{Binding DisplayContent}"
                                                               TextWrapping="Wrap" />
                                                    <Button Margin="0,8,0,0"
                                                            HorizontalAlignment="Left"
                                                            Content="{Binding RetryButtonText}"
                                                            Command="{Binding DataContext.RetryEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding RetryHelpText}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{StaticResource Campaigns.Play.CurrentStep}" Style="{StaticResource SectionTitleStyle}" />
                                    <StackPanel Margin="0,8,0,0">
                                        <Border Margin="0,0,0,6"
                                                Padding="9,6"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="10">
                                            <TextBlock Text="{Binding GmModeText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <Border Padding="9,6"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                CornerRadius="10">
                                            <TextBlock Text="{Binding ParticipationModeText}"
                                                       FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,14,0,0"
                                               Text="{Binding CurrentStepTitle}"
                                               FontSize="19"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="{Binding CurrentStepDescription}"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding CurrentStepProgressText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}" />

                                    <Expander Margin="0,12,0,0"
                                              Header="{StaticResource Campaigns.Play.ContextEstimate}"
                                              IsExpanded="False"
                                              Visibility="{Binding HasContextPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding ContextPreviewSummary}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <ItemsControl Margin="0,8,0,0"
                                                          ItemsSource="{Binding ContextPreviewItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8"
                                                                Padding="9,7"
                                                                Background="{DynamicResource SurfaceAltBrush}"
                                                                CornerRadius="10">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Margin="0,3,0,0"
                                                                           Text="{Binding BudgetText}"
                                                                           FontSize="12" />
                                                                <TextBlock Margin="0,3,0,0"
                                                                           Text="{Binding StatusText}"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                                <ItemsControl Margin="0,6,0,0"
                                                                              ItemsSource="{Binding Sections}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,1,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{Binding Title}"
                                                                                           FontSize="11"
                                                                                           TextWrapping="Wrap" />
                                                                                <StackPanel Grid.Column="1"
                                                                                            Margin="6,0,0,0">
                                                                                    <TextBlock Text="{Binding TokenText}"
                                                                                               FontSize="11"
                                                                                               HorizontalAlignment="Right" />
                                                                                    <TextBlock Text="{Binding StateText}"
                                                                                               FontSize="10"
                                                                                               HorizontalAlignment="Right"
                                                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>

                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding ShowUserActionSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{StaticResource Campaigns.Play.UserAction}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="{StaticResource Campaigns.Play.UserActionHelp}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBox Margin="0,7,0,0"
                                                 MinHeight="88"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding ActionInput, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Margin="0,8,0,0"
                                                Content="{StaticResource Campaigns.Play.SubmitUserAction}"
                                                IsEnabled="{Binding CanSubmitUserAction}"
                                                Command="{Binding SubmitUserActionCommand}"
                                                ToolTip="{Binding UserActionHelpText}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding ShowBlindAiAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{StaticResource Campaigns.Play.SecretActions}"
                                                   FontWeight="SemiBold" />
                                        <Button Margin="0,7,0,0"
                                                Content="{StaticResource Campaigns.Play.SubmitSecretActions}"
                                                IsEnabled="{Binding CanGenerateBlindAiActions}"
                                                Command="{Binding GenerateAiActionsCommand}"
                                                ToolTip="{Binding BlindAiActionHelpText}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding ShowResolveSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{StaticResource Campaigns.Play.GmResolution}"
                                                   FontWeight="SemiBold" />
                                        <TextBox Margin="0,7,0,0"
                                                 MinHeight="88"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding GmResolutionInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsUserGm, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Margin="0,8,0,0"
                                                Content="{Binding ResolveButtonText}"
                                                IsEnabled="{Binding CanResolve}"
                                                Command="{Binding ResolveRoundCommand}"
                                                ToolTip="{Binding ResolveHelpText}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Style="{StaticResource CardStyle}"
                                    Visibility="{Binding ShowUserJoinSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{StaticResource Campaigns.Play.JoinTitle}"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="{StaticResource Campaigns.Play.JoinHelp}"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <Button Margin="0,8,0,0"
                                            Content="{Binding ScheduleUserJoinButtonText}"
                                            IsEnabled="{Binding CanScheduleUserJoin}"
                                            Command="{Binding ScheduleUserJoinCommand}"
                                            ToolTip="{Binding ScheduleUserJoinHelpText}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                                <Expander Header="{StaticResource Campaigns.Play.ExtraDice}">
                                    <StackPanel Margin="0,9,0,0">
                                        <TextBlock Text="{StaticResource Campaigns.Play.ExtraDiceHelp}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button MinWidth="54"
                                                    MinHeight="28"
                                                    Margin="0,0,8,0"
                                                    Padding="10,2"
                                                    Content="1d20"
                                                    Command="{Binding RollDicePresetCommand}"
                                                    CommandParameter="1d20"
                                                    ToolTip="{StaticResource Campaigns.Play.RollExtraDiceToolTip}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button MinWidth="54"
                                                    MinHeight="28"
                                                    Margin="0,0,8,0"
                                                    Padding="10,2"
                                                    Content="2d6"
                                                    Command="{Binding RollDicePresetCommand}"
                                                    CommandParameter="2d6"
                                                    ToolTip="{StaticResource Campaigns.Play.RollExtraDiceToolTip}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button MinWidth="54"
                                                    MinHeight="28"
                                                    Padding="10,2"
                                                    Content="1d100"
                                                    Command="{Binding RollDicePresetCommand}"
                                                    CommandParameter="1d100"
                                                    ToolTip="{StaticResource Campaigns.Play.RollExtraDiceToolTip}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                        </WrapPanel>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding DiceExpression, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Margin="8,0,0,0"
                                                    Content="{StaticResource Campaigns.Play.RollExtraDice}"
                                                    Command="{Binding RollDiceCommand}"
                                                    ToolTip="{StaticResource Campaigns.Play.RollExtraDiceToolTip}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}"
                                    Visibility="{Binding IsAiGm, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Expander Header="{StaticResource Campaigns.Play.GmModelSettings}">
                                    <StackPanel Margin="0,9,0,0">
                                        <ComboBox ItemsSource="{Binding ModelOptions}"
                                                  SelectedItem="{Binding SelectedGmRoute}"
                                                  DisplayMemberPath="DisplayLabel" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Margin="0,0,10,0"
                                                       VerticalAlignment="Center"
                                                       Text="{StaticResource Campaigns.Play.GmOutputTokens}" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding GmMaxOutputTokensText, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <TextBlock Margin="0,5,0,0"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="{StaticResource Campaigns.Play.GmOutputTokensHelp}" />
                                        <Button Margin="0,8,0,0"
                                                Content="{StaticResource Campaigns.Play.ApplyGmModel}"
                                                Command="{Binding ApplyGmRouteCommand}"
                                                ToolTip="{StaticResource Campaigns.Play.ApplyGmModelToolTip}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <TextBlock Grid.Row="2" Margin="0,12,0,0"
                           Text="{Binding StatusText}"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
