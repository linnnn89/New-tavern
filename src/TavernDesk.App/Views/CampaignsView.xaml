<UserControl x:Class="TavernDesk.App.Views.CampaignsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid Visibility="{Binding IsLibrary, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="30,24,30,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="跑团" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="剧本是 GM 的结构化主持模板；每一局保存独立历史，可继续或基于同一故事另开一局。"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,18,0,16" Orientation="Horizontal">
                    <Button Content="导入剧本卡"
                            Command="{Binding ImportScenarioCommand}"
                            ToolTip="从本地选择一张剧本卡并加入剧本库。"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="用所选剧本开新局"
                            Margin="8,0,0,0"
                            Command="{Binding OpenScenarioLobbyCommand}"
                            ToolTip="进入起始大厅，选择 GM、参与方式、角色和模型后创建一局全新跑团。"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="继续所选跑团"
                            Margin="24,0,0,0"
                            Command="{Binding ContinueCampaignCommand}"
                            ToolTip="打开右侧选中的跑团，并从已自动保存的状态继续。"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="同一故事另开一局"
                            Margin="8,0,0,0"
                            Command="{Binding CloneCampaignCommand}"
                            ToolTip="复制所选跑团的剧本与冻结配置为新草稿；不会复制游玩记录。"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="剧本库" Style="{StaticResource SectionTitleStyle}" />
                            <ListBox Grid.Row="1"
                                     Margin="0,12,0,0"
                                     HorizontalContentAlignment="Stretch"
                                     ItemsSource="{Binding Scenarios}"
                                     SelectedItem="{Binding SelectedScenario}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding SourceFileName}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="已保存的跑团" Style="{StaticResource SectionTitleStyle}" />
                            <ListBox Grid.Row="1"
                                     Margin="0,12,0,0"
                                     HorizontalContentAlignment="Stretch"
                                     ItemsSource="{Binding Campaigns}"
                                     SelectedItem="{Binding SelectedCampaign}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Foreground="{StaticResource MutedTextBrush}">
                                                    <Run Text="回合 " />
                                                    <Run Text="{Binding CurrentRound, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding ParticipantCount, Mode=OneWay}" />
                                                    <Run Text=" 席位" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StatusLabel}" />
                                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="3"
                           Margin="0,14,0,0"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Grid>

        <Grid Visibility="{Binding IsLobby, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="30,22,30,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="起始大厅" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="点击“开始游戏”时冻结剧本、角色快照、记忆导入与初始模型；首次问候和旧聊天示例不会作为开场历史发送。"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Content="返回剧本库"
                                Command="{Binding BackToLibraryCommand}"
                                ToolTip="放弃当前未保存的界面改动并返回剧本库。"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="4" Text="本局设置" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Grid.Row="1" Margin="0,14,10,0" Text="本局标题" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,14,16,0"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,14,10,0" Text="流程方式" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,14,0,0"
                                      ItemsSource="{Binding FlowChoices}"
                                      SelectedItem="{Binding SelectedFlow}"
                                      DisplayMemberPath="Name" />

                            <TextBlock Grid.Row="2" Margin="0,10,10,0" Text="谁担任 GM" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,10,16,0"
                                      ItemsSource="{Binding GmChoices}"
                                      SelectedItem="{Binding SelectedGm}"
                                      DisplayMemberPath="Name" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,10,10,0" Text="GM 模型" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,10,0,0"
                                      ItemsSource="{Binding ModelOptions}"
                                      SelectedItem="{Binding SelectedGmRoute}"
                                      DisplayMemberPath="DisplayLabel"
                                      Visibility="{Binding IsAiGm, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="3" Margin="0,10,10,0" Text="你的参与方式" VerticalAlignment="Top" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,10,16,0">
                                <ComboBox ItemsSource="{Binding UserParticipationChoices}"
                                          SelectedItem="{Binding SelectedUserParticipation}"
                                          DisplayMemberPath="Name" />
                                <TextBlock Margin="2,5,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding SelectedUserParticipation.Description}" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,10,10,0"
                                       Text="你的席位名称"
                                       VerticalAlignment="Top" />
                            <TextBox Grid.Row="3" Grid.Column="3" Margin="0,10,0,0"
                                     VerticalAlignment="Top"
                                     Text="{Binding UserPersonaName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                       Margin="0,8,16,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding SelectedGm.Description}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding SelectedFlow.Description}" />

                            <TextBlock Grid.Row="5" Margin="0,10,10,0" Text="玩家历史 tokens" VerticalAlignment="Center" />
                            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,10,16,0" Text="{Binding PlayerHistoryBudget}" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,10,10,0" Text="GM 历史 tokens" VerticalAlignment="Center" />
                            <TextBox Grid.Row="5" Grid.Column="3" Margin="0,10,0,0" Text="{Binding GmHistoryBudget}" />

                            <WrapPanel Grid.Row="6"
                                       Grid.ColumnSpan="4"
                                       Margin="0,12,0,0">
                                <Button Margin="0,0,8,0"
                                        Content="编辑 GM 职责提示词"
                                        Command="{Binding OpenGlobalPromptCommand}"
                                        CommandParameter="CampaignGmSystem"
                                        ToolTip="打开全局提示词设置，编辑 AI GM 在所有跑团中遵循的主持职责。"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="编辑 AI 玩家职责提示词"
                                        Command="{Binding OpenGlobalPromptCommand}"
                                        CommandParameter="CampaignPlayerSystem"
                                        ToolTip="打开全局提示词设置，编辑所有 AI 玩家在跑团中遵循的行动规范。"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="世界观" Style="{StaticResource SectionTitleStyle}" />
                                <TextBox Margin="0,10,0,0" MinHeight="150"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding WorldSetting}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0">
                                <TextBlock Text="公开规则" Style="{StaticResource SectionTitleStyle}" />
                                <TextBox Margin="0,10,0,0" MinHeight="150"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Rules}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="开场设置（给 GM，不是角色首次发言）" Style="{StaticResource SectionTitleStyle}" />
                                <TextBox Margin="0,10,0,0" MinHeight="150"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding OpeningPrompt}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="AI 玩家（0–4 个；勾选角色即增加，取消勾选即减少）"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="旁观模式至少选择 1 名 AI 玩家；参与模式也允许只有 USER 玩家。每个 AI 席位可使用不同模型。"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Padding="10,6"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="12">
                                    <TextBlock Text="{Binding LobbyRosterText}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ItemsControl Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding CharacterChoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="10"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Content="{Binding Name}"
                                                          FontWeight="SemiBold"
                                                          IsChecked="{Binding IsSelected}"
                                                          IsEnabled="{Binding IsSelectionEnabled}"
                                                          ToolTip="勾选加入本局，取消勾选移出本局"
                                                          VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1" Margin="12,0"
                                                          ItemsSource="{Binding DataContext.ModelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding SelectedRoute}"
                                                          DisplayMemberPath="DisplayLabel" />
                                                <CheckBox Grid.Column="2" Margin="8,0"
                                                          Content="导入聊天记忆"
                                                          IsChecked="{Binding IncludeMemory}" />
                                                <CheckBox Grid.Column="3" Margin="8,0,0,0"
                                                          Content="导入原世界知识"
                                                          IsChecked="{Binding IncludeOriginalWorldKnowledge}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,16,0,0">
                        <TextBlock Text="{Binding StatusText}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Content="保存大厅草稿"
                                    Command="{Binding SaveLobbyCommand}"
                                    ToolTip="保存当前剧本、角色、GM、参与方式与模型选择；暂不开始游玩。"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="开始本局并冻结配置"
                                    Margin="8,0,0,0"
                                    Command="{Binding StartCampaignCommand}"
                                    ToolTip="校验并冻结剧本、角色快照、记忆与初始模型，然后生成 GM 开场并进入第 1 回合。"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid Visibility="{Binding IsGame, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="22,18,22,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding GameTitle}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{Binding GamePhaseText}" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="重新载入本局"
                                Command="{Binding RefreshGameCommand}"
                                ToolTip="从本地数据库重新载入当前跑团；不会调用任何模型。"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="返回剧本库"
                                Margin="8,0,0,0"
                                Command="{Binding BackToLibraryCommand}"
                                ToolTip="离开游玩页并返回剧本库；本局记录已自动保存，可随时继续。"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="245" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="玩家席位" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="协作圆桌可任选未行动的 AI；严格先攻只开放当前席位。"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Margin="0,10,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Seats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,9" Padding="10"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    CornerRadius="7">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   Text="{Binding KindLabel}"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                    </Grid>
                                                    <TextBlock Margin="0,4,0,7"
                                                               Text="{Binding RoundStatus}"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                    <Button Margin="0,6,0,0"
                                                            Content="{Binding ActionButtonText}"
                                                            IsEnabled="{Binding CanGenerateAction}"
                                                            Command="{Binding DataContext.GenerateAiSeatActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding ActionHelpText}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Visibility="{Binding ShowActionButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <Expander Margin="0,8,0,0"
                                                              Header="席位模型设置"
                                                              Visibility="{Binding IsAi, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <StackPanel Margin="0,7,0,0">
                                                            <ComboBox ItemsSource="{Binding DataContext.ModelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      SelectedItem="{Binding SelectedRoute}"
                                                                      DisplayMemberPath="DisplayLabel" />
                                                            <Button Margin="0,6,0,0"
                                                            Content="从下次行动起使用此模型"
                                                            Command="{Binding DataContext.ApplySeatRouteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="仅切换这个 AI 席位之后的模型；角色卡、记忆快照和既有记录保持不变。"
                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="跑团记录" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding SaveStateText}"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" Margin="0,10,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Events}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10" Padding="12"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="8">
                                                <StackPanel>
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ActorName}" FontWeight="SemiBold" />
                                                            <TextBlock Margin="8,0,0,0"
                                                                       Text="{Binding KindLabel}"
                                                                       Foreground="{StaticResource MutedTextBrush}" />
                                                        </StackPanel>
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   Text="{Binding StatusLabel}"
                                                                   Foreground="{StaticResource AccentBrush}" />
                                                    </Grid>
                                                    <TextBlock Margin="0,7,0,0"
                                                               Text="{Binding DisplayContent}"
                                                               TextWrapping="Wrap" />
                                                    <Button Margin="0,8,0,0"
                                                            HorizontalAlignment="Left"
                                                            Content="{Binding RetryButtonText}"
                                                            Command="{Binding DataContext.RetryEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding RetryHelpText}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="当前步骤" Style="{StaticResource SectionTitleStyle}" />
                                    <StackPanel Margin="0,8,0,0">
                                        <Border Margin="0,0,0,6"
                                                Padding="9,6"
                                                Background="{StaticResource AccentSoftBrush}"
                                                CornerRadius="7">
                                            <TextBlock Text="{Binding GmModeText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <Border Padding="9,6"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                CornerRadius="7">
                                            <TextBlock Text="{Binding ParticipationModeText}"
                                                       FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,14,0,0"
                                               Text="{Binding CurrentStepTitle}"
                                               FontSize="19"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="{Binding CurrentStepDescription}"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding CurrentStepProgressText}"
                                               FontSize="12"
                                               Foreground="{StaticResource AccentBrush}" />

                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding ShowUserActionSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="你的本回合行动"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="提交时会自动附带一枚 1d20；GM 会结合角色、行动方法和局势灵活裁定。"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBox Margin="0,7,0,0"
                                                 MinHeight="88"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding ActionInput, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Margin="0,8,0,0"
                                                Content="提交我的行动"
                                                IsEnabled="{Binding CanSubmitUserAction}"
                                                Command="{Binding SubmitUserActionCommand}"
                                                ToolTip="{Binding UserActionHelpText}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding ShowBlindAiAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="AI 秘密行动"
                                                   FontWeight="SemiBold" />
                                        <Button Margin="0,7,0,0"
                                                Content="让所有 AI 秘密提交行动"
                                                IsEnabled="{Binding CanGenerateBlindAiActions}"
                                                Command="{Binding GenerateAiActionsCommand}"
                                                ToolTip="{Binding BlindAiActionHelpText}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding ShowResolveSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="本回合 GM 裁定"
                                                   FontWeight="SemiBold" />
                                        <TextBox Margin="0,7,0,0"
                                                 MinHeight="88"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding GmResolutionInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsUserGm, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Margin="0,8,0,0"
                                                Content="{Binding ResolveButtonText}"
                                                IsEnabled="{Binding CanResolve}"
                                                Command="{Binding ResolveRoundCommand}"
                                                ToolTip="{Binding ResolveHelpText}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Style="{StaticResource CardStyle}"
                                    Visibility="{Binding ShowUserJoinSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="想亲自加入？"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="可以预约 USER 席位，从下一完整回合开始参与；当前回合不会改变。"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <Button Margin="0,8,0,0"
                                            Content="{Binding ScheduleUserJoinButtonText}"
                                            IsEnabled="{Binding CanScheduleUserJoin}"
                                            Command="{Binding ScheduleUserJoinCommand}"
                                            ToolTip="{Binding ScheduleUserJoinHelpText}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                                <Expander Header="额外掷骰与记录">
                                    <StackPanel Margin="0,9,0,0">
                                        <TextBlock Text="每次玩家行动已经自动附带一枚 1d20。这里仅用于额外的剧情、环境或 GM 公开掷骰。"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding DiceExpression, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Margin="8,0,0,0"
                                                    Content="进行额外公开掷骰"
                                                    Command="{Binding RollDiceCommand}"
                                                    ToolTip="按左侧表达式生成一条独立的公开骰点记录；它不会替代玩家行动自动附带的 1d20。"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}"
                                    Visibility="{Binding IsAiGm, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Expander Header="GM 模型设置">
                                    <StackPanel Margin="0,9,0,0">
                                        <ComboBox ItemsSource="{Binding ModelOptions}"
                                                  SelectedItem="{Binding SelectedGmRoute}"
                                                  DisplayMemberPath="DisplayLabel" />
                                        <Button Margin="0,8,0,0"
                                                Content="从下一次裁定起使用此模型"
                                                Command="{Binding ApplyGmRouteCommand}"
                                                ToolTip="只切换 AI GM 后续裁定使用的模型；剧本、世界状态和既有记录保持不变。"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <TextBlock Grid.Row="2" Margin="0,12,0,0"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
