<UserControl x:Class="TavernDesk.App.Views.CharactersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:TavernDesk.App.Views.Shared"
             xmlns:presentation="clr-namespace:TavernDesk.App.Presentation">
    <UserControl.Resources>
        <presentation:CharacterPlaceholderConverter x:Key="CharacterPlaceholderConverter" />
        <Style x:Key="DensityChoiceStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Margin="2" Padding="{TemplateBinding Padding}" CornerRadius="6"
                            Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{StaticResource Characters.Title}" Style="{StaticResource PageTitleStyle}" />

            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCharacterToolsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <shared:SearchBox Width="210"
                         Margin="0,0,12,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Placeholder="{StaticResource Characters.SearchPlaceholder}"
                         ToolTip="{StaticResource Characters.SearchToolTip}" />
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton AutomationProperties.AutomationId="CharacterDensityDense" Content="{StaticResource Characters.Layout.Dense}"
                                     GroupName="CharacterDensity" IsChecked="{Binding IsDense, Mode=TwoWay}" Style="{StaticResource DensityChoiceStyle}" />
                        <RadioButton AutomationProperties.AutomationId="CharacterDensityMedium" Content="{StaticResource Characters.Layout.Medium}"
                                     GroupName="CharacterDensity" IsChecked="{Binding IsMedium, Mode=TwoWay}" Style="{StaticResource DensityChoiceStyle}" />
                        <RadioButton AutomationProperties.AutomationId="CharacterDensityLarge" Content="{StaticResource Characters.Layout.Large}"
                                     GroupName="CharacterDensity" IsChecked="{Binding IsLarge, Mode=TwoWay}" Style="{StaticResource DensityChoiceStyle}" />
                    </StackPanel>
                </Border>
                <Button Content="{StaticResource Characters.ImportCard}" Command="{Binding ImportCommand}" Margin="12,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{StaticResource Characters.BackToShelf}"
                    Command="{Binding CloseCharacterToolsCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCharacterToolsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,8,0,14" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCharacterToolsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188" MinWidth="150" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{StaticResource Characters.MyShelves}" Margin="8,6,8,10" Style="{StaticResource SectionTitleStyle}" />
                    <ListBox Grid.Row="1" MaxHeight="360"
                             ItemsSource="{Binding ShelfItems}"
                             SelectedItem="{Binding SelectedShelf}"
                             DisplayMemberPath="Name"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource ModernListBoxItemStyle}">
                                <Setter Property="MinHeight" Value="42" />
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel Grid.Row="2">
                        <Button Content="{StaticResource Characters.NewShelf}"
                                Command="{Binding CreateShelfCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Grid Margin="0,7,0,0">
                            <!-- Narrow left column (~216px): three equal columns plus a
                                 tighter Padding=3,7, so the single-line ellipsis template
                                 shown by SecondaryButtonStyle still fits 3-character
                                 labels such as "Rename". Keep this comment ASCII-only:
                                 Test-Localization.ps1 flags CJK outside dictionaries. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="{StaticResource Characters.Rename}"
                                    Command="{Binding RenameShelfCommand}"
                                    Padding="3,7"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Padding="3,7"
                                    Command="{Binding ToggleShelfBatchModeCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=CharacterCardList}"
                                    ToolTip="{StaticResource Characters.Batch.ToolTip}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Content" Value="{StaticResource Characters.Batch.Start}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShelfBatchMode}" Value="True">
                                                <Setter Property="Content" Value="{StaticResource Characters.Batch.Done}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="2"
                                    Margin="6,0,0,0"
                                    Content="{StaticResource Characters.Delete}"
                                    Command="{Binding DeleteShelfCommand}"
                                    Padding="3,7"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Margin="0,0,0,10"
                        Padding="12,9"
                        CornerRadius="12"
                        Background="{DynamicResource AccentSoftBrush}"
                        Visibility="{Binding IsShelfBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedShelf.Name, StringFormat={StaticResource Characters.BatchTitleFormat}}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{StaticResource Characters.BatchDescription}"
                                       Margin="0,3,12,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Margin="0,0,12,0"
                                       VerticalAlignment="Center">
                                <Run Text="{StaticResource Characters.SelectedPrefix}" />
                                <Run Text="{Binding SelectedItems.Count, ElementName=CharacterCardList, Mode=OneWay}" />
                                <Run Text="{StaticResource Characters.SelectedSuffix}" />
                            </TextBlock>
                            <Button Content="{StaticResource Characters.RemoveSelected}"
                                    Command="{Binding RemoveSelectedFromShelfCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=CharacterCardList}"
                                    ToolTip="{StaticResource Characters.RemoveSelectedToolTip}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource AppicaEmptyStateStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasVisibleCharacters}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="{StaticResource AppicaShellIconFont}"
                                   FontSize="36"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="&#xE8F1;" />
                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                   FontWeight="SemiBold"
                                   Text="{StaticResource Characters.Empty.Title}" />
                        <TextBlock Margin="0,6,0,14"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{StaticResource Characters.Empty.Hint}" />
                        <Button HorizontalAlignment="Center"
                                Content="{StaticResource Characters.ImportCard}"
                                Command="{Binding ImportCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
                <ListBox x:Name="CharacterCardList"
                     Grid.Row="1"
                     ItemsSource="{Binding VisibleCharacters}"
                     SelectionMode="Multiple"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"
                           BasedOn="{StaticResource ModernListBoxItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Height="{Binding DataContext.CardHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Margin="{DynamicResource CardGridGap}" Style="{StaticResource CardStyle}"
                                Padding="{DynamicResource NoInset}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Background="{Binding Name, Converter={StaticResource CharacterPlaceholderConverter}}" IsHitTestVisible="False">
                                    <Grid>
                                        <TextBlock Text="{Binding Name, Converter={StaticResource CharacterPlaceholderConverter}, ConverterParameter=Initial}" Margin="{DynamicResource InsetMd}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center" FontSize="36"
                                                   FontWeight="Medium" Foreground="#33405C" />
                                        <Image Source="{Binding AvatarPath, Converter={StaticResource AvatarImageConverter}, ConverterParameter=240}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <DockPanel Grid.Row="1" Margin="8">
                                    <Button DockPanel.Dock="Right" Content="{StaticResource Characters.Chat}" Padding="7,3" MinHeight="28"
                                            AutomationProperties.AutomationId="{Binding Id, StringFormat=CharacterCardChat_{0}}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.StartChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <TextBlock Text="{Binding Name}" Margin="0,0,5,0" VerticalAlignment="Center"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <Button Grid.Row="0" Panel.ZIndex="1"
                                        AutomationProperties.AutomationId="CharacterCardOpen"
                                        AutomationProperties.Name="{Binding Name}"
                                        ToolTip="{StaticResource Characters.OpenToolsToolTip}"
                                        Command="{Binding DataContext.OpenCharacterToolsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource CharacterCardOpenButtonStyle}" />
                                <Border Grid.Row="0" Panel.ZIndex="2" VerticalAlignment="Bottom"
                                        HorizontalAlignment="Stretch" Margin="{DynamicResource InsetSm}"
                                        Style="{StaticResource CharacterCardActionsStyle}">
                                    <WrapPanel HorizontalAlignment="Center">

                                        <Button Margin="{DynamicResource TileGap}" Padding="{DynamicResource CardActionInset}"
                                                ToolTip="{StaticResource Characters.Edit}"
                                                AutomationProperties.Name="{StaticResource Characters.Edit}"
                                                AutomationProperties.AutomationId="CharacterCardEdit"
                                                Command="{Binding DataContext.EditCharacterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}">
                                            <TextBlock Text="&#xE70F;" Style="{StaticResource IconGlyphStyle}" />
                                        </Button>
                                    </WrapPanel>
                                </Border>
                                <CheckBox Panel.ZIndex="3" Margin="{DynamicResource InsetSm}" Padding="{DynamicResource InsetSm}"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          Content="{StaticResource Characters.Select}" Background="{DynamicResource SurfaceOverlay}"
                                          IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"
                                          Visibility="{Binding DataContext.IsShelfBatchMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <Border Grid.Row="2">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCharacterToolsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ActiveCharacter.Name, StringFormat={StaticResource Characters.HomeTitleFormat}}"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{StaticResource Characters.HomeDescription}"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="12,3,0,0"
                                       Text="{StaticResource Characters.Unsaved}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="{StaticResource Characters.Edit}"
                                        Command="{Binding ShowCharacterEditorCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Margin="8,0,0,0"
                                        Content="{StaticResource Characters.Classify}"
                                        Command="{Binding ToggleClassificationCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="8,0,0,0"
                                        Content="{StaticResource Characters.ReplaceImage}"
                                        Command="{Binding ReplaceCharacterAvatarCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="{StaticResource Characters.Delete}"
                                    Command="{Binding DeleteCharacterCommand}"
                                    Style="{StaticResource DestructiveButtonStyle}" />
                        </DockPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCharacterEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <Grid Margin="0,2,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="126" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="112"
                                        Height="142"
                                        HorizontalAlignment="Left"
                                        ClipToBounds="True"
                                        CornerRadius="12"
                                        Background="{DynamicResource AccentSoftBrush}">
                                    <Image Source="{Binding ActiveCharacter.AvatarPath, Converter={StaticResource AvatarImageConverter}, ConverterParameter=120}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="4,2,0,0">
                                    <TextBlock Text="{Binding ActiveCharacter.Name}"
                                               FontSize="25"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,8,0,14"
                                               MaxHeight="68"
                                               Text="{Binding ActiveCharacter.Description}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <WrapPanel>
                                                <Button Content="{StaticResource Characters.ContinueLastChat}"
                                                        Command="{Binding StartChatCommand}"
                                                        CommandParameter="{Binding ActiveCharacter}"
                                                        Style="{StaticResource PrimaryButtonStyle}" />
                                                <Button Margin="8,0,0,0"
                                                        Content="{StaticResource Characters.NewConversation}"
                                                        Command="{Binding CreateNewChatCommand}"
                                                        CommandParameter="{Binding ActiveCharacter}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,0,0,18"
                                    Padding="14"
                                    CornerRadius="12"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding IsClassificationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{StaticResource Characters.ShelfClassification}" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,9"
                                               Text="{StaticResource Characters.ShelfClassificationHelp}"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <ComboBox Margin="0,0,0,8"
                                              ItemsSource="{Binding CustomShelfItems}"
                                              SelectedItem="{Binding MembershipShelf}"
                                              DisplayMemberPath="Name" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{StaticResource Characters.AddToShelf}"
                                                Command="{Binding AddToShelfCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Content="{StaticResource Characters.RemoveFromShelf}"
                                                Command="{Binding RemoveFromShelfCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{StaticResource Characters.ChatHistory}"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Text="{Binding CharacterConversationCount, StringFormat={StaticResource Characters.ConversationCountFormat}}"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                            <TextBlock Margin="2,14"
                                       HorizontalAlignment="Center"
                                       Text="{StaticResource Characters.NoConversations}"
                                       Foreground="{DynamicResource MutedTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CharacterConversationCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox ItemsSource="{Binding CharacterConversations}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource ModernListBoxItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.OpenCharacterConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="{StaticResource Characters.DeleteConversation}"
                                                              Command="{Binding DeleteConversationCommand}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0,0,0"
                                                           Text="{Binding UpdatedText}"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,5,0,0"
                                                           Text="{Binding PreviewText}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Expander Margin="0,12,0,0" Header="{StaticResource Characters.ImportReport}">
                                <TextBox Margin="0,8,0,0"
                                         MinHeight="120"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Top"
                                         TextWrapping="Wrap"
                                         Text="{Binding ImportReportText, Mode=OneWay}" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCharacterEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <StackPanel DataContext="{Binding Editor}">
                                <TabControl MinHeight="430" Margin="0,0,0,12">
                                    <TabItem Header="{StaticResource Characters.Tab.Basic}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{StaticResource Characters.Name}" />
                                                <TextBox Margin="0,5,0,12"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{StaticResource Characters.Description}" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="120"
                                                         AcceptsReturn="True"
                                                         VerticalContentAlignment="Top"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{StaticResource Characters.Personality}" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="110"
                                                         AcceptsReturn="True"
                                                         VerticalContentAlignment="Top"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding Personality, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{StaticResource Characters.Scenario}" />
                                                <TextBox Margin="0,5,0,8"
                                                         MinHeight="110"
                                                         AcceptsReturn="True"
                                                         VerticalContentAlignment="Top"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding Scenario, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="{StaticResource Characters.Tab.Dialogue}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{StaticResource Characters.FirstMessage}" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="150"
                                                         AcceptsReturn="True"
                                                         VerticalContentAlignment="Top"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding FirstMessage, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{StaticResource Characters.MessageExample}" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="130"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding MessageExample, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{StaticResource Characters.AlternateGreetings}" />
                                                <ItemsControl Margin="0,5,0,0"
                                                              ItemsSource="{Binding AlternateGreetings}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,9"
                                                                    Padding="10"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <DockPanel Margin="0,0,0,7"
                                                                               LastChildFill="False">
                                                                        <TextBlock DockPanel.Dock="Left"
                                                                                   Text="{StaticResource Characters.Greeting}"
                                                                                   VerticalAlignment="Center"
                                                                                   FontWeight="SemiBold" />
                                                                        <Button DockPanel.Dock="Right"
                                                                                Content="{StaticResource Characters.Delete}"
                                                                                Command="{Binding DataContext.RemoveAlternateGreetingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource SecondaryButtonStyle}" />
                                                                    </DockPanel>
                                                                    <TextBox Grid.Row="1"
                                                                             MinHeight="84"
                                                                             AcceptsReturn="True"
                                                                             VerticalContentAlignment="Top"
                                                                             TextWrapping="Wrap"
                                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Margin="0,0,0,12"
                                                        Content="{StaticResource Characters.AppendGreeting}"
                                                        Command="{Binding AddAlternateGreetingCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="{StaticResource Characters.Tab.Prompts}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{StaticResource Characters.SystemPrompt}" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="120"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{StaticResource Characters.PostHistoryInstructions}" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="110"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding PostHistoryInstructions, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{StaticResource Characters.DepthPrompt}" />
                                                <TextBox Margin="0,5,0,8"
                                                         MinHeight="100"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding DepthPrompt, UpdateSourceTrigger=PropertyChanged}" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="82" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="{StaticResource Characters.DepthField}" />
                                                     <TextBox Grid.Column="1"
                                                              Margin="7,0,14,0"
                                                              Padding="5,0"
                                                              TextAlignment="Center"
                                                              VerticalContentAlignment="Center"
                                                              Text="{Binding DepthPromptDepth, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               Text="{StaticResource Characters.RoleField}" />
                                                    <ComboBox Grid.Column="3"
                                                              Margin="7,0,0,0"
                                                              SelectedValuePath="Content"
                                                              SelectedValue="{Binding DepthPromptRole}">
                                                        <ComboBoxItem Content="{StaticResource Characters.Role.System}" />
                                                        <ComboBoxItem Content="{StaticResource Characters.Role.User}" />
                                                        <ComboBoxItem Content="{StaticResource Characters.Role.Assistant}" />
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="{StaticResource Characters.Tab.Metadata}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{StaticResource Characters.Tags}" />
                                                <TextBox Margin="0,5,0,12"
                                                         Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{StaticResource Characters.CreatorNotes}" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="90"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding CreatorNotes, UpdateSourceTrigger=PropertyChanged}" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{StaticResource Characters.Creator}" />
                                                        <TextBox Margin="0,5,0,0"
                                                                 Text="{Binding Creator, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{StaticResource Characters.Version}" />
                                                        <TextBox Margin="0,5,0,0"
                                                                 Text="{Binding CharacterVersion, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{StaticResource Characters.EmbeddedWorldbook}" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="150"
                                                         AcceptsReturn="True"
                                                         AcceptsTab="True"
                                                         TextWrapping="NoWrap"
                                                         FontFamily="Consolas"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Text="{Binding CharacterBookJson, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Content="{StaticResource Characters.EditRawJson}"
                                                        Command="{Binding DataContext.EditRawCardJsonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCharacterEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button HorizontalAlignment="Left"
                                    Padding="14,8"
                                    Content="{StaticResource Characters.Home}"
                                    Command="{Binding ShowCharacterOverviewCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="{StaticResource Characters.BackHomeToolTip}" />
                            <Button Grid.Column="2"
                                    Content="{StaticResource Characters.ExportCard}"
                                    Command="{Binding ExportCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="3"
                                    Margin="8,0,0,0"
                                    Content="{StaticResource Characters.SaveSettings}"
                                    Command="{Binding SaveCharacterCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Grid>
                </Grid>
        </Border>
    </Grid>
</UserControl>
