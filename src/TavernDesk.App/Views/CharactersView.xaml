<UserControl x:Class="TavernDesk.App.Views.CharactersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="角色书架" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCharacterToolsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBox Width="210"
                         Margin="0,0,12,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="按名称、描述或性格即时过滤" />
                <Button Content="密集" Command="{Binding SetDenseCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="中等" Command="{Binding SetMediumCommand}" Margin="6,0"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="大图" Command="{Binding SetLargeCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="导入角色卡" Command="{Binding ImportCommand}" Margin="12,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="← 返回角色书架"
                    Command="{Binding CloseCharacterToolsCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCharacterToolsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="14,9"
                CornerRadius="12"
                Background="{StaticResource AccentSoftBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCharacterToolsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock>
                <Run Text="当前排列：" />
                <Run Text="{Binding ScaleLabel, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="　竖向封面按原比例裁切；悬停放大并提供聊天、编辑两个快捷入口。" />
            </TextBlock>
        </Border>

        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCharacterToolsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188" MinWidth="150" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="我的书架" Margin="8,6,8,10" Style="{StaticResource SectionTitleStyle}" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ShelfItems}"
                             SelectedItem="{Binding SelectedShelf}"
                             DisplayMemberPath="Name"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource ModernListBoxItemStyle}">
                                <Setter Property="MinHeight" Value="42" />
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel Grid.Row="2">
                        <Button Content="+ 新建书架"
                                Command="{Binding CreateShelfCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="重命名"
                                    Command="{Binding RenameShelfCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Command="{Binding ToggleShelfBatchModeCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=CharacterCardList}"
                                    ToolTip="进入或退出角色多选整理模式">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Content" Value="批量" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShelfBatchMode}" Value="True">
                                                <Setter Property="Content" Value="完成" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="2"
                                    Margin="6,0,0,0"
                                    Content="删除"
                                    Command="{Binding DeleteShelfCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Margin="0,0,0,10"
                        Padding="12,9"
                        CornerRadius="12"
                        Background="{StaticResource AccentSoftBrush}"
                        Visibility="{Binding IsShelfBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedShelf.Name, StringFormat=批量整理“{0}”}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="勾选多个角色后可一次移出当前书架；角色卡和聊天记录不会删除。"
                                       Margin="0,3,12,0"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Margin="0,0,12,0"
                                       VerticalAlignment="Center">
                                <Run Text="已选 " />
                                <Run Text="{Binding SelectedItems.Count, ElementName=CharacterCardList, Mode=OneWay}" />
                                <Run Text=" 项" />
                            </TextBlock>
                            <Button Content="移出所选"
                                    Command="{Binding RemoveSelectedFromShelfCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=CharacterCardList}"
                                    ToolTip="只移出当前自定义书架，不删除角色卡或聊天"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox x:Name="CharacterCardList"
                     Grid.Row="1"
                     ItemsSource="{Binding VisibleCharacters}"
                     SelectionMode="Multiple"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"
                           BasedOn="{StaticResource ModernListBoxItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Height="{Binding DataContext.CardHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Margin="0,0,14,16"
                                Style="{StaticResource CardStyle}"
                                Padding="0"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        ClipToBounds="True"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="13,13,0,0">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <Image Source="{Binding AvatarPath}"
                                               Stretch="UniformToFill"
                                               RenderTransformOrigin="0.5,0.5"
                                               CacheMode="BitmapCache">
                                            <Image.RenderTransform>
                                                <ScaleTransform x:Name="PortraitScale" ScaleX="1" ScaleY="1" />
                                            </Image.RenderTransform>
                                            <Image.Effect>
                                                <BlurEffect x:Name="PortraitBlur" Radius="0" />
                                            </Image.Effect>
                                        </Image>

                                        <Border x:Name="HoverOverlay"
                                                Opacity="0"
                                                Background="#76000000">
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Button MinWidth="110"
                                                        MinHeight="46"
                                                        Content="聊天"
                                                        FontSize="16"
                                                         FontWeight="SemiBold"
                                                         Command="{Binding DataContext.StartChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                         Style="{StaticResource PrimaryButtonStyle}" />
                                                <Button MinWidth="110"
                                                        MinHeight="46"
                                                        Margin="0,12,0,0"
                                                        Content="编辑"
                                                        FontSize="16"
                                                         FontWeight="SemiBold"
                                                         Command="{Binding DataContext.EditCharacterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                         Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <CheckBox Panel.ZIndex="2"
                                                  Margin="10"
                                                  Padding="6,4"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  Content="选择"
                                                  Background="#EEFFFFFF"
                                                  IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"
                                                  Visibility="{Binding DataContext.IsShelfBatchMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" Height="52" Margin="12,0,9,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <Button Grid.Column="1"
                                            Margin="7,0,0,0"
                                            Content="进入"
                                             ToolTip="打开完整角色工具"
                                             Command="{Binding DataContext.OpenCharacterToolsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                            </Grid>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PortraitScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.2"
                                                             Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="PortraitScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.2"
                                                             Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="PortraitBlur"
                                                             Storyboard.TargetProperty="Radius"
                                                             To="5"
                                                             Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PortraitScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="PortraitScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="PortraitBlur"
                                                             Storyboard.TargetProperty="Radius"
                                                             To="0"
                                                             Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <Border Grid.Row="2">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCharacterToolsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ActiveCharacter.Name, StringFormat=角色主页 · {0}}"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="角色卡资料、归类和该角色的全部聊天都集中在这里。"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="12,3,0,0"
                                       Text="● 未保存"
                                       Foreground="{StaticResource DangerBrush}"
                                       Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                            <Button Content="编辑"
                                    Command="{Binding ShowCharacterEditorCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="8,0,0,0"
                                    Content="归类"
                                    Command="{Binding ToggleClassificationCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="8,0,0,0"
                                    Content="替换图片"
                                    Command="{Binding ReplaceCharacterAvatarCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="8,0,0,0"
                                    Content="删除"
                                    Foreground="{StaticResource DangerBrush}"
                                    Command="{Binding DeleteCharacterCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </WrapPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCharacterEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <Grid Margin="0,2,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="126" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="112"
                                        Height="142"
                                        HorizontalAlignment="Left"
                                        ClipToBounds="True"
                                        CornerRadius="12"
                                        Background="{StaticResource AccentSoftBrush}">
                                    <Image Source="{Binding ActiveCharacter.AvatarPath}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="4,2,0,0">
                                    <TextBlock Text="{Binding ActiveCharacter.Name}"
                                               FontSize="25"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,8,0,14"
                                               MaxHeight="68"
                                               Text="{Binding ActiveCharacter.Description}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <WrapPanel>
                                                <Button Content="继续最后聊天"
                                                        Command="{Binding StartChatCommand}"
                                                        CommandParameter="{Binding ActiveCharacter}"
                                                        Style="{StaticResource PrimaryButtonStyle}" />
                                                <Button Margin="8,0,0,0"
                                                        Content="新建对话"
                                                        Command="{Binding CreateNewChatCommand}"
                                                        CommandParameter="{Binding ActiveCharacter}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,0,0,18"
                                    Padding="14"
                                    CornerRadius="12"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding IsClassificationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="书架归类" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,9"
                                               Text="选择一个书架后加入或移除；删除书架不会删除角色。"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <ComboBox Margin="0,0,0,8"
                                              ItemsSource="{Binding CustomShelfItems}"
                                              SelectedItem="{Binding MembershipShelf}"
                                              DisplayMemberPath="Name" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="加入所选书架"
                                                Command="{Binding AddToShelfCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Content="从所选书架移除"
                                                Command="{Binding RemoveFromShelfCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="聊天记录"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Text="{Binding CharacterConversationCount, StringFormat={}{0} 条}"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                            <TextBlock Margin="2,14"
                                       HorizontalAlignment="Center"
                                       Text="这个角色还没有聊天记录。"
                                       Foreground="{StaticResource MutedTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CharacterConversationCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox ItemsSource="{Binding CharacterConversations}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource ModernListBoxItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.OpenCharacterConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="删除整个聊天记录"
                                                              Command="{Binding DeleteConversationCommand}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0,0,0"
                                                           Text="{Binding UpdatedText}"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,5,0,0"
                                                           Text="{Binding PreviewText}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Expander Margin="0,12,0,0" Header="导入报告">
                                <TextBox Margin="0,8,0,0"
                                         MinHeight="120"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Top"
                                         TextWrapping="Wrap"
                                         Text="{Binding ImportReportText, Mode=OneWay}" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCharacterEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <StackPanel DataContext="{Binding Editor}">
                                <TabControl MinHeight="430" Margin="0,0,0,12">
                                    <TabItem Header="基础">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                                            <StackPanel>
                                                <TextBlock Text="名称" />
                                                <TextBox Margin="0,5,0,12"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="描述" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="120"
                                                         AcceptsReturn="True"
                                                         VerticalContentAlignment="Top"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="性格" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="110"
                                                         AcceptsReturn="True"
                                                         VerticalContentAlignment="Top"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding Personality, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="场景" />
                                                <TextBox Margin="0,5,0,8"
                                                         MinHeight="110"
                                                         AcceptsReturn="True"
                                                         VerticalContentAlignment="Top"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding Scenario, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="对话">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                                            <StackPanel>
                                                <TextBlock Text="首次发言" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="150"
                                                         AcceptsReturn="True"
                                                         VerticalContentAlignment="Top"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding FirstMessage, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="对话示例（mes_example）" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="130"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding MessageExample, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="备选开场白" />
                                                <ItemsControl Margin="0,5,0,0"
                                                              ItemsSource="{Binding AlternateGreetings}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,9"
                                                                    Padding="10"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <DockPanel Margin="0,0,0,7"
                                                                               LastChildFill="False">
                                                                        <TextBlock DockPanel.Dock="Left"
                                                                                   Text="开场白"
                                                                                   VerticalAlignment="Center"
                                                                                   FontWeight="SemiBold" />
                                                                        <Button DockPanel.Dock="Right"
                                                                                Content="删除"
                                                                                Command="{Binding DataContext.RemoveAlternateGreetingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource SecondaryButtonStyle}" />
                                                                    </DockPanel>
                                                                    <TextBox Grid.Row="1"
                                                                             MinHeight="84"
                                                                             AcceptsReturn="True"
                                                                             VerticalContentAlignment="Top"
                                                                             TextWrapping="Wrap"
                                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Margin="0,0,0,12"
                                                        Content="+ 追加开场白"
                                                        Command="{Binding AddAlternateGreetingCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="提示词">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                                            <StackPanel>
                                                <TextBlock Text="系统提示词" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="120"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="历史后指令" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="110"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding PostHistoryInstructions, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="深度提示词" />
                                                <TextBox Margin="0,5,0,8"
                                                         MinHeight="100"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding DepthPrompt, UpdateSourceTrigger=PropertyChanged}" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="depth" />
                                                    <TextBox Grid.Column="1"
                                                             Margin="7,0,14,0"
                                                             Text="{Binding DepthPromptDepth, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               Text="role" />
                                                    <ComboBox Grid.Column="3"
                                                              Margin="7,0,0,0"
                                                              SelectedValuePath="Content"
                                                              SelectedValue="{Binding DepthPromptRole}">
                                                        <ComboBoxItem Content="system" />
                                                        <ComboBoxItem Content="user" />
                                                        <ComboBoxItem Content="assistant" />
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="元数据">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                                            <StackPanel>
                                                <TextBlock Text="标签（逗号或换行分隔）" />
                                                <TextBox Margin="0,5,0,12"
                                                         Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="作者说明" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="90"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding CreatorNotes, UpdateSourceTrigger=PropertyChanged}" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="作者" />
                                                        <TextBox Margin="0,5,0,0"
                                                                 Text="{Binding Creator, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="角色版本" />
                                                        <TextBox Margin="0,5,0,0"
                                                                 Text="{Binding CharacterVersion, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="内嵌世界书（JSON 对象）" />
                                                <TextBox Margin="0,5,0,12"
                                                         MinHeight="150"
                                                         AcceptsReturn="True"
                                                         AcceptsTab="True"
                                                         TextWrapping="NoWrap"
                                                         FontFamily="Consolas"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Text="{Binding CharacterBookJson, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Content="编辑并校验原始 JSON"
                                                        Command="{Binding DataContext.EditRawCardJsonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCharacterEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button HorizontalAlignment="Left"
                                    Padding="12,8"
                                    Command="{Binding ShowCharacterOverviewCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="返回当前角色主页">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,7,0"
                                               Text="←"
                                               FontSize="16" />
                                    <TextBlock Text="角色主页"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Content="导出角色卡"
                                    Command="{Binding ExportCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="3"
                                    Margin="8,0,0,0"
                                    Content="保存角色设定"
                                    Command="{Binding SaveCharacterCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Grid>
                </Grid>
        </Border>
    </Grid>
</UserControl>
