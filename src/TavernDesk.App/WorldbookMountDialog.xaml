<Window x:Class="TavernDesk.App.WorldbookMountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource WorldbookMount.Title}"
        Width="720"
        Height="620"
        MinWidth="560"
        MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Dialog_OnLoaded"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24"
          Style="{StaticResource InterfaceScaleRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{StaticResource WorldbookMount.Title}"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Margin="0,5,0,0"
                       Text="{Binding SelectedBook.Name, StringFormat={StaticResource WorldbookMount.CurrentBookFormat}, TargetNullValue={StaticResource WorldbookMount.NoBook}}"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0"
                       Text="{StaticResource WorldbookMount.Description}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,18,0,0">
            <TabItem Header="{StaticResource WorldbookMount.CharactersTab}">
                <Grid Margin="10,8,10,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{StaticResource Common.SelectAll}"
                                    Command="{Binding SelectAllCharacterBindingsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="8,0,0,0"
                                    Content="{StaticResource Common.Clear}"
                                    Command="{Binding ClearCharacterBindingsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{StaticResource WorldbookMount.CharactersHelp}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,12,0,0"
                            Padding="4"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <ScrollViewer x:Name="CharacterMountScrollViewer"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CharacterBindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="10,7"
                                                      Content="{Binding Name}"
                                                      IsChecked="{Binding IsBound, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{StaticResource WorldbookMount.NoCharacters}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CharacterBindings.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Grid.Row="2"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            Content="{StaticResource WorldbookMount.SaveCharacters}"
                            Command="{Binding SaveCharacterBindingsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </TabItem>

            <TabItem Header="{StaticResource WorldbookMount.CampaignsTab}">
                <Grid Margin="10,8,10,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{StaticResource Common.SelectAll}"
                                    Command="{Binding SelectAllCampaignBindingsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="8,0,0,0"
                                    Content="{StaticResource Common.Clear}"
                                    Command="{Binding ClearCampaignBindingsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{StaticResource WorldbookMount.CampaignsHelp}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,12,0,0"
                            Padding="4"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <ScrollViewer x:Name="CampaignMountScrollViewer"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CampaignBindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="10,7">
                                                <CheckBox Content="{Binding Title}"
                                                          IsChecked="{Binding IsBound, Mode=TwoWay}" />
                                                <TextBlock Margin="30,3,0,0"
                                                           Text="{Binding Summary}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{StaticResource WorldbookMount.NoCampaigns}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CampaignBindings.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Grid.Row="2"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            Content="{StaticResource WorldbookMount.SaveCampaigns}"
                            Command="{Binding SaveCampaignBindingsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Text="{Binding Status}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <Button Grid.Column="1"
                    Width="96"
                    Content="{StaticResource Common.Close}"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
