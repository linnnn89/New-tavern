<Window x:Class="TavernDesk.App.WorldbookMountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理世界书挂载"
        Width="720"
        Height="620"
        MinWidth="560"
        MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Dialog_OnLoaded"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24"
          Style="{StaticResource InterfaceScaleRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="管理世界书挂载"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Margin="0,5,0,0"
                       Text="{Binding SelectedBook.Name, StringFormat=当前世界书：{0}, TargetNullValue=当前世界书：未选择}"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0"
                       Text="选择角色或跑团剧本并分别保存。关闭窗口时，未保存的勾选会被丢弃；全局及其他作用域挂载保持不变。"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,18,0,0">
            <TabItem Header="角色">
                <Grid Margin="10,8,10,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="全选"
                                    Command="{Binding SelectAllCharacterBindingsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="8,0,0,0"
                                    Content="清空"
                                    Command="{Binding ClearCharacterBindingsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center"
                                   Text="选择要使用这本世界书的角色。"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,12,0,0"
                            Padding="4"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <ScrollViewer x:Name="CharacterMountScrollViewer"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CharacterBindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="10,7"
                                                      Content="{Binding Name}"
                                                      IsChecked="{Binding IsBound, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="当前没有可挂载的角色。"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CharacterBindings.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Grid.Row="2"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            Content="保存角色挂载"
                            Command="{Binding SaveCharacterBindingsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </TabItem>

            <TabItem Header="跑团剧本">
                <Grid Margin="10,8,10,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="全选"
                                    Command="{Binding SelectAllCampaignBindingsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="8,0,0,0"
                                    Content="清空"
                                    Command="{Binding ClearCampaignBindingsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center"
                                   Text="选择要使用这本世界书的跑团剧本。"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,12,0,0"
                            Padding="4"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <ScrollViewer x:Name="CampaignMountScrollViewer"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CampaignBindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="10,7">
                                                <CheckBox Content="{Binding Title}"
                                                          IsChecked="{Binding IsBound, Mode=TwoWay}" />
                                                <TextBlock Margin="30,3,0,0"
                                                           Text="{Binding Summary}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="当前没有可挂载的跑团剧本。"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CampaignBindings.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Grid.Row="2"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            Content="保存跑团挂载"
                            Command="{Binding SaveCampaignBindingsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Text="{Binding Status}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <Button Grid.Column="1"
                    Width="96"
                    Content="关闭"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
