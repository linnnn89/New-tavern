<Window x:Class="TavernDesk.App.TextEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TavernDesk.App.Views"
        Width="760"
        Height="560"
        MinWidth="520"
        MinHeight="380"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Style="{StaticResource InterfaceScaleRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource AppicaShellTopBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="{DynamicResource InterfaceFontSize}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <views:ShellCaptionButtons Grid.Column="1" />
            </Grid>
        </Border>

        <TextBlock x:Name="PromptText"
                   Grid.Row="1"
                   Margin="24,20,24,16"
                   FontSize="{DynamicResource FontSizeBodySmall}"
                   FontWeight="Normal"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   LineHeight="21" />

        <TextBox x:Name="Editor"
                 Grid.Row="2"
                 Margin="24,0,24,20"
                 Padding="16"
                 FontSize="{DynamicResource InterfaceFontSize}"
                 Background="{DynamicResource SurfaceSolidBrush}"
                 AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" />

        <Border Grid.Row="3"
                Padding="24,16"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource SurfaceSolidBrush}">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="100"
                        MinHeight="36"
                        Margin="0,0,10,0"
                        Content="{StaticResource Common.Cancel}"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Width="120"
                        MinHeight="36"
                        Content="{StaticResource Common.SaveChanges}"
                        IsDefault="True"
                        Click="SaveButton_OnClick"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
